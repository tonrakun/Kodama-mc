+package dev.kodama.gui;
+
+import org.bukkit.entity.Player;
+import org.bukkit.event.EventHandler;
+import org.bukkit.event.EventPriority;
+import org.bukkit.event.Listener;
+import org.bukkit.event.inventory.InventoryClickEvent;
+import org.bukkit.event.inventory.InventoryDragEvent;
+import org.checkerframework.checker.nullness.qual.NonNull;
+import org.checkerframework.framework.qual.DefaultQualifier;
+
+/**
+ * Keeps items in {@link ConfigGui} inventories and forwards clicks to it. Deliberately no other event types: the hopper
+ * optimizations switch themselves off while anything listens to inventory move events.
+ */
+@DefaultQualifier(NonNull.class)
+final class ConfigGuiListener implements Listener {
+
+    @EventHandler(priority = EventPriority.HIGHEST)
+    public void onClick(final InventoryClickEvent event) {
+        // The exception handler of the internal plugin cannot log, so nothing may escape from here
+        try {
+            if (!(event.getView().getTopInventory().getHolder() instanceof ConfigGui gui)) {
+                return;
+            }
+            event.setCancelled(true);
+            if (event.getClickedInventory() == event.getView().getTopInventory() && event.getWhoClicked() instanceof Player) {
+                gui.click(event.getClick(), event.getSlot());
+            }
+        } catch (final Throwable throwable) {
+            ConfigGui.logFailure(throwable);
+        }
+    }
+
+    @EventHandler(priority = EventPriority.HIGHEST)
+    public void onDrag(final InventoryDragEvent event) {
+        if (event.getView().getTopInventory().getHolder() instanceof ConfigGui) {
+            event.setCancelled(true);
+        }
+    }
+}
