diff --git a/src/main/java/dev/kodama/command/subcommands/GuiCommand.java b/src/main/java/dev/kodama/command/subcommands/GuiCommand.java
new file mode 100644
index 0000000000000000000000000000000000000000..de613c3f64ff3edf08ee4ead854e1431ab0c4ad8
--- /dev/null
+++ b/src/main/java/dev/kodama/command/subcommands/GuiCommand.java
@@ -0,0 +1,80 @@
+package dev.kodama.command.subcommands;
+
+import dev.kodama.command.Completions;
+import dev.kodama.command.KodamaSubcommand;
+import dev.kodama.gui.ConfigGui;
+import java.util.ArrayList;
+import java.util.Collections;
+import java.util.List;
+import org.bukkit.Bukkit;
+import org.bukkit.World;
+import org.bukkit.command.CommandSender;
+import org.bukkit.entity.Player;
+import org.bukkit.permissions.Permission;
+import org.checkerframework.checker.nullness.qual.NonNull;
+import org.checkerframework.checker.nullness.qual.Nullable;
+import org.checkerframework.framework.qual.DefaultQualifier;
+
+import static net.kyori.adventure.text.Component.text;
+import static net.kyori.adventure.text.format.NamedTextColor.RED;
+
+/**
+ * {@code /kodama gui [world]}: the config inventory. It needs the same view permissions as {@code /kodama config get};
+ * what can be changed in it follows the edit permissions of {@code /kodama config set}.
+ */
+@DefaultQualifier(NonNull.class)
+public final class GuiCommand implements KodamaSubcommand {
+
+    public static final String LITERAL_ARGUMENT = "gui";
+
+    private static final String USAGE = "/kodama gui [world]";
+
+    @Override
+    public boolean execute(final CommandSender sender, final String subCommand, final String[] args) {
+        if (!(sender instanceof Player player)) {
+            sender.sendMessage(text("Only players can open the config GUI.", RED));
+            return false;
+        }
+        if (!ConfigCommand.canViewAny(player)) {
+            player.sendMessage(Bukkit.permissionMessage());
+            return true;
+        }
+        if (args.length > 1) {
+            player.sendMessage(text("Usage: " + USAGE, RED));
+            return false;
+        }
+        @Nullable String worldName = null;
+        if (args.length == 1) {
+            final @Nullable World world = Bukkit.getWorld(args[0]);
+            if (world == null) {
+                player.sendMessage(text("Unknown world '" + args[0] + "'.", RED));
+                return false;
+            }
+            worldName = world.getName();
+        }
+        ConfigGui.open(player, worldName);
+        return true;
+    }
+
+    @Override
+    public List<String> tabComplete(final CommandSender sender, final String subCommand, final String[] args) {
+        if (args.length > 1) {
+            return Collections.emptyList();
+        }
+        final List<String> worlds = new ArrayList<>();
+        for (final World world : Bukkit.getWorlds()) {
+            worlds.add(world.getName());
+        }
+        return Completions.matchingLast(args, worlds);
+    }
+
+    @Override
+    public boolean testPermission(final CommandSender sender) {
+        return sender instanceof Player && ConfigCommand.canViewAny(sender);
+    }
+
+    @Override
+    public List<Permission> permissions() {
+        return List.of();
+    }
+}
