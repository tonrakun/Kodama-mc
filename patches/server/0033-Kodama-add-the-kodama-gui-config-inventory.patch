 package dev.kodama.config;
 
 import io.papermc.paper.configuration.ConfigurationPart;
+import java.lang.reflect.Constructor;
 import java.lang.reflect.Field;
 import java.lang.reflect.Modifier;
 import java.util.ArrayList;
@@ -47,14 +48,53 @@ public final class ConfigSchema {
         }
     }
 
+    private final Class<?> rootType;
     private final List<Option> options;
     private final Map<String, String> comments;
+    private volatile @Nullable Object defaults;
 
-    private ConfigSchema(final List<Option> options, final Map<String, String> comments) {
+    private ConfigSchema(final Class<?> rootType, final List<Option> options, final Map<String, String> comments) {
+        this.rootType = rootType;
         this.options = Collections.unmodifiableList(options);
         this.comments = Collections.unmodifiableMap(comments);
     }
 
+    /**
+     * An instance of the root class with every option at its declared initial value, or {@code null} if it cannot be
+     * built. Sections are created by hand because the config mapper normally does that.
+     */
+    public @Nullable Object defaults() {
+        Object result = this.defaults;
+        if (result == null) {
+            try {
+                result = instantiate(this.rootType, null);
+                this.defaults = result;
+            } catch (final ReflectiveOperationException | RuntimeException e) {
+                return null;
+            }
+        }
+        return result;
+    }
+
+    private static Object instantiate(final Class<?> type, final @Nullable Object outer) throws ReflectiveOperationException {
+        final Constructor<?> constructor = type.getDeclaredConstructors()[0];
+        constructor.setAccessible(true);
+        final Object[] arguments = new Object[constructor.getParameterCount()];
+        if (outer != null) {
+            arguments[0] = outer;
+        }
+        final Object instance = constructor.newInstance(arguments);
+        for (final Field field : type.getDeclaredFields()) {
+            if (!Modifier.isStatic(field.getModifiers()) && !field.isSynthetic() && ConfigurationPart.class.isAssignableFrom(field.getType())) {
+                field.setAccessible(true);
+                if (field.get(instance) == null) {
+                    field.set(instance, instantiate(field.getType(), instance));
+                }
+            }
+        }
+        return instance;
+    }
+
     /**
      * The {@code @Comment} text of every option and section, by dotted path.
      */
