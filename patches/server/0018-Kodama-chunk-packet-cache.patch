diff --git a/src/main/java/dev/kodama/chunk/packetcache/ChunkPacketCache.java b/src/main/java/dev/kodama/chunk/packetcache/ChunkPacketCache.java
new file mode 100644
index 0000000000000000000000000000000000000000..b7a0f0d89a400e8ae84e684a29829d27e1639e89
--- /dev/null
+++ b/src/main/java/dev/kodama/chunk/packetcache/ChunkPacketCache.java
@@ -0,0 +1,284 @@
+package dev.kodama.chunk.packetcache;
+
+import dev.kodama.feature.FeatureGuard;
+import java.util.ArrayList;
+import java.util.Iterator;
+import java.util.LinkedHashMap;
+import java.util.List;
+import java.util.Locale;
+import java.util.concurrent.atomic.LongAdder;
+import net.minecraft.network.protocol.game.ClientboundLevelChunkWithLightPacket;
+import net.minecraft.server.MinecraftServer;
+import net.minecraft.server.level.ServerLevel;
+import net.minecraft.world.level.chunk.LevelChunk;
+import org.bukkit.Bukkit;
+import org.bukkit.plugin.Plugin;
+import org.bukkit.plugin.PluginManager;
+import org.checkerframework.checker.nullness.qual.Nullable;
+
+/**
+ * Keeps the {@link ClientboundLevelChunkWithLightPacket} of a chunk and hands the same object to every player the chunk
+ * is sent to, instead of building the packet again for each of them. The packet still goes through the normal netty
+ * encoder and compressor.
+ * <p>
+ * An entry is valid while the modification counter of the chunk ({@code LevelChunk#kodamaModCount}, raised on every change
+ * that marks the chunk unsaved and on every light update) equals the value it was built at, and while it is younger than
+ * {@code max-age-seconds}. The packet is never changed after it was built, which is why anti-xray packets (different for
+ * every player) are not cached, and why the cache is off while a plugin that rewrites packets is enabled.
+ * <p>
+ * Total size is bounded by {@code max-mb} with least-recently-used eviction. The entries are dropped when their chunk
+ * unloads.
+ */
+public final class ChunkPacketCache {
+
+    private static final long PLUGIN_POLL_TICKS = 20L;
+    private static final long SWEEP_INTERVAL_NANOS = 5_000_000_000L;
+    private static final long PACKET_OVERHEAD_BYTES = 512L;
+    private static final long LIGHT_SECTION_BYTES = 2048L;
+    private static final String[] PACKET_PLUGINS = {"ProtocolLib", "packetevents"};
+
+    private static final class Entry {
+        final LevelChunk chunk;
+        final int modCount;
+        final ClientboundLevelChunkWithLightPacket packet;
+        final long bytes;
+        final long builtNanos;
+
+        Entry(final LevelChunk chunk, final int modCount, final ClientboundLevelChunkWithLightPacket packet, final long bytes, final long builtNanos) {
+            this.chunk = chunk;
+            this.modCount = modCount;
+            this.packet = packet;
+            this.bytes = bytes;
+            this.builtNanos = builtNanos;
+        }
+    }
+
+    private static final Object LOCK = new Object();
+    private static final LinkedHashMap<LevelChunk, Entry> ENTRIES = new LinkedHashMap<>(256, 0.75F, true); // access order: eldest = least recently used, guarded by LOCK
+    private static long totalBytes; // guarded by LOCK
+    private static long lastSweepNanos; // guarded by LOCK
+    private static volatile int entryCount;
+    private static volatile long totalBytesView;
+
+    private static final LongAdder HITS = new LongAdder();
+    private static final LongAdder MISSES = new LongAdder();
+    private static final LongAdder INVALIDATIONS = new LongAdder();
+    private static final LongAdder EVICTIONS = new LongAdder();
+    private static final LongAdder BYPASSED = new LongAdder();
+
+    private static long lastPluginPollTick = Long.MIN_VALUE;
+    private static volatile @Nullable String pluginBlock; // name of the enabled plugin that switches the cache off
+
+    private ChunkPacketCache() {
+    }
+
+    /**
+     * The packet to send for the chunk: a cached one when it is valid, else a new one (which is cached unless the packet
+     * is player specific). Falls back to building the packet when the feature is off or throws.
+     *
+     * @param shouldModify the anti-xray decision for this player and chunk
+     */
+    public static ClientboundLevelChunkWithLightPacket packetFor(final ServerLevel world, final LevelChunk chunk, final boolean shouldModify) {
+        if (!usable()) {
+            return build(world, chunk, shouldModify);
+        }
+        if (shouldModify) {
+            BYPASSED.increment();
+            return build(world, chunk, true);
+        }
+        return FeatureGuard.call(PacketCacheSettings.FEATURE_ID, () -> cached(world, chunk), () -> build(world, chunk, false));
+    }
+
+    private static ClientboundLevelChunkWithLightPacket build(final ServerLevel world, final LevelChunk chunk, final boolean modifyBlocks) {
+        return new ClientboundLevelChunkWithLightPacket(chunk, world.getLightEngine(), null, null, modifyBlocks);
+    }
+
+    private static ClientboundLevelChunkWithLightPacket cached(final ServerLevel world, final LevelChunk chunk) {
+        // read before the packet is built: a change that happens meanwhile makes the entry stale at once
+        final int modCount = chunk.kodamaModCount;
+        final long now = System.nanoTime();
+        final long maxAge = PacketCacheSettings.maxAgeNanos();
+        synchronized (LOCK) {
+            final Entry entry = ENTRIES.get(chunk);
+            if (entry != null) {
+                if (entry.modCount == modCount && now - entry.builtNanos <= maxAge) {
+                    HITS.increment();
+                    return entry.packet;
+                }
+                remove(entry);
+                INVALIDATIONS.increment();
+            }
+            sweepIfDue(now, maxAge);
+        }
+
+        MISSES.increment();
+        final ClientboundLevelChunkWithLightPacket packet = build(world, chunk, false);
+        final long bytes = estimateBytes(packet);
+        final long maxBytes = PacketCacheSettings.maxBytes();
+        if (bytes <= maxBytes) {
+            synchronized (LOCK) {
+                final Entry previous = ENTRIES.put(chunk, new Entry(chunk, modCount, packet, bytes, now));
+                if (previous != null) {
+                    totalBytes -= previous.bytes;
+                }
+                totalBytes += bytes;
+                evict(maxBytes);
+                publishSize();
+            }
+        }
+        return packet;
+    }
+
+    private static long estimateBytes(final ClientboundLevelChunkWithLightPacket packet) {
+        // the heightmap arrays are shared with the chunk and not counted
+        return PACKET_OVERHEAD_BYTES + packet.getChunkData().getReadBuffer().readableBytes()
+            + (packet.getLightData().getSkyUpdates().size() + packet.getLightData().getBlockUpdates().size()) * LIGHT_SECTION_BYTES;
+    }
+
+    private static void remove(final Entry entry) { // holds LOCK
+        if (ENTRIES.remove(entry.chunk) == entry) {
+            totalBytes -= entry.bytes;
+        }
+        publishSize();
+    }
+
+    private static void evict(final long maxBytes) { // holds LOCK
+        if (totalBytes <= maxBytes) {
+            return;
+        }
+        final Iterator<Entry> iterator = ENTRIES.values().iterator();
+        while (totalBytes > maxBytes && iterator.hasNext()) {
+            final Entry eldest = iterator.next();
+            iterator.remove();
+            totalBytes -= eldest.bytes;
+            EVICTIONS.increment();
+        }
+    }
+
+    private static void sweepIfDue(final long now, final long maxAge) { // holds LOCK
+        if (now - lastSweepNanos < SWEEP_INTERVAL_NANOS) {
+            return;
+        }
+        lastSweepNanos = now;
+        final Iterator<Entry> iterator = ENTRIES.values().iterator();
+        while (iterator.hasNext()) {
+            final Entry entry = iterator.next();
+            if (now - entry.builtNanos > maxAge) {
+                iterator.remove();
+                totalBytes -= entry.bytes;
+                INVALIDATIONS.increment();
+            }
+        }
+        publishSize();
+    }
+
+    private static void publishSize() { // holds LOCK
+        entryCount = ENTRIES.size();
+        totalBytesView = totalBytes;
+    }
+
+    /**
+     * Forgets the packet of a chunk that unloads.
+     */
+    public static void drop(final LevelChunk chunk) {
+        if (entryCount == 0) {
+            return;
+        }
+        synchronized (LOCK) {
+            final Entry entry = ENTRIES.remove(chunk);
+            if (entry != null) {
+                totalBytes -= entry.bytes;
+                publishSize();
+            }
+        }
+    }
+
+    public static void clear() {
+        synchronized (LOCK) {
+            ENTRIES.clear();
+            totalBytes = 0L;
+            publishSize();
+        }
+    }
+
+    // activation
+
+    /**
+     * Whether the cache may be used right now: switched on, not tripped, and no packet rewriting plugin is enabled.
+     */
+    private static boolean usable() {
+        final boolean usable = PacketCacheSettings.configuredEnabled() && !PacketCacheSettings.tripped() && pluginBlock() == null;
+        if (!usable && entryCount != 0) {
+            clear();
+        }
+        return usable;
+    }
+
+    private static @Nullable String pluginBlock() {
+        if (PacketCacheSettings.ignorePacketPlugins()) {
+            return null;
+        }
+        final long tick = MinecraftServer.currentTickLong;
+        if (lastPluginPollTick == Long.MIN_VALUE || tick - lastPluginPollTick >= PLUGIN_POLL_TICKS || tick < lastPluginPollTick) {
+            lastPluginPollTick = tick;
+            pluginBlock = findPacketPlugin();
+        }
+        return pluginBlock;
+    }
+
+    private static @Nullable String findPacketPlugin() {
+        try {
+            final PluginManager manager = Bukkit.getServer() == null ? null : Bukkit.getPluginManager();
+            if (manager == null) {
+                return null;
+            }
+            for (final String name : PACKET_PLUGINS) {
+                final Plugin plugin = manager.getPlugin(name);
+                if (plugin != null && plugin.isEnabled()) {
+                    return plugin.getName();
+                }
+            }
+        } catch (final RuntimeException ignored) {
+            // the plugin manager is not ready, treat as no plugin
+        }
+        return null;
+    }
+
+    // status
+
+    /**
+     * Why the cache is not in use, or {@code null} when it is active.
+     */
+    public static @Nullable String inactiveReason() {
+        if (!PacketCacheSettings.configuredEnabled()) {
+            return "disabled in the configuration";
+        }
+        if (PacketCacheSettings.tripped()) {
+            return "disabled after repeated errors";
+        }
+        if (!PacketCacheSettings.ignorePacketPlugins()) {
+            lastPluginPollTick = Long.MIN_VALUE; // look again now
+            final String plugin = pluginBlock();
+            if (plugin != null) {
+                return plugin + " is enabled (set ignore-packet-plugins to keep the cache on)";
+            }
+        }
+        return null;
+    }
+
+    public static String describe() {
+        final String reason = inactiveReason();
+        final long hits = HITS.sum();
+        final long misses = MISSES.sum();
+        final long requests = hits + misses;
+        final List<String> parts = new ArrayList<>();
+        parts.add(reason == null ? "active" : "inactive: " + reason);
+        parts.add(String.format(Locale.ROOT, "%d hits, %d misses (%.0f%% hit rate)", hits, misses, requests == 0L ? 0.0 : hits * 100.0 / requests));
+        parts.add(INVALIDATIONS.sum() + " invalidations");
+        parts.add(EVICTIONS.sum() + " evictions");
+        parts.add(BYPASSED.sum() + " anti-xray bypasses");
+        parts.add(String.format(Locale.ROOT, "%d entries, %.1f MB of %d MB", entryCount, totalBytesView / (1024.0 * 1024.0),
+            PacketCacheSettings.maxBytes() >> 20));
+        return String.join(", ", parts);
+    }
+}
