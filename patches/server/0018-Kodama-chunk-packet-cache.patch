+package dev.kodama.chunk.packetcache;
+
+import dev.kodama.chunk.ChunkLoadingSettings;
+import dev.kodama.config.KodamaGlobalConfiguration;
+import dev.kodama.feature.FeatureGuard;
+import org.checkerframework.checker.nullness.qual.Nullable;
+
+/**
+ * Read-only view of {@code chunk-loading.packet-cache} with the master switch and the {@link FeatureGuard} state already
+ * applied. Every call reads the live configuration.
+ */
+final class PacketCacheSettings {
+
+    static final String FEATURE_ID = "chunk-packet-cache";
+
+    private PacketCacheSettings() {
+    }
+
+    private static KodamaGlobalConfiguration.ChunkLoading.@Nullable PacketCache section() {
+        final KodamaGlobalConfiguration config = KodamaGlobalConfiguration.get();
+        return config == null || config.chunkLoading == null ? null : config.chunkLoading.packetCache;
+    }
+
+    static boolean configuredEnabled() {
+        final KodamaGlobalConfiguration.ChunkLoading.PacketCache section = section();
+        return ChunkLoadingSettings.masterEnabled() && section != null && section.enabled.isTrue();
+    }
+
+    static boolean tripped() {
+        return FeatureGuard.isTripped(FEATURE_ID);
+    }
+
+    static long maxBytes() {
+        final KodamaGlobalConfiguration.ChunkLoading.PacketCache section = section();
+        return (section == null ? 256L : Math.max(1L, section.maxMb)) * 1024L * 1024L;
+    }
+
+    static long maxAgeNanos() {
+        final KodamaGlobalConfiguration.ChunkLoading.PacketCache section = section();
+        return (section == null ? 300L : Math.max(1L, section.maxAgeSeconds)) * 1_000_000_000L;
+    }
+
+    static boolean ignorePacketPlugins() {
+        final KodamaGlobalConfiguration.ChunkLoading.PacketCache section = section();
+        return section != null && section.ignorePacketPlugins;
+    }
+}
