@@ -147,6 +147,26 @@ public class KodamaGlobalConfiguration extends ConfigurationPart {
             @Constraints.Min(0)
             public int minPerPlayer = 20;
         }
+
+        @Comment("Reuses the chunk packet of a chunk for every player it is sent to instead of building it again.")
+        public PacketCache packetCache;
+
+        public class PacketCache extends ConfigurationPart {
+            @Comment("Enables the chunk packet cache. Packets of players that get anti-xray modified chunks are never cached.")
+            public PresetBoolean enabled = PresetBoolean.of(false, true, true);
+
+            @Comment("Upper limit of the memory held by cached packets, in megabytes. The least recently used packets are dropped first.")
+            @Constraints.Min(1)
+            public int maxMb = 256;
+
+            @Comment("Seconds after which a cached packet is built again, even if the chunk did not change.")
+            @Constraints.Min(1)
+            public int maxAgeSeconds = 300;
+
+            @Comment("The cache is switched off while ProtocolLib or PacketEvents is enabled, because their listeners may change a packet that is shared by several players.\n"
+                + "Set this to true to keep the cache on anyway, only do that when no listener changes chunk packets.")
+            public boolean ignorePacketPlugins = false;
+        }
     }
 
     @Comment("Network and packet optimizations.")
