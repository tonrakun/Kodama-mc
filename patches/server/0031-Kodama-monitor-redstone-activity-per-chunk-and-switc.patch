diff --git a/src/main/java/dev/kodama/command/subcommands/RedstoneCommand.java b/src/main/java/dev/kodama/command/subcommands/RedstoneCommand.java
new file mode 100644
index 0000000000000000000000000000000000000000..499acbbb990ccefc3da7c8849cacfdc26d9e4372
--- /dev/null
+++ b/src/main/java/dev/kodama/command/subcommands/RedstoneCommand.java
@@ -0,0 +1,228 @@
+package dev.kodama.command.subcommands;
+
+import dev.kodama.command.Completions;
+import dev.kodama.command.KodamaCommands;
+import dev.kodama.command.PermissionedKodamaSubcommand;
+import dev.kodama.config.KodamaConfigurations;
+import dev.kodama.redstone.RedstoneMonitor;
+import java.util.ArrayList;
+import java.util.Collections;
+import java.util.List;
+import java.util.Locale;
+import net.minecraft.server.MinecraftServer;
+import net.minecraft.server.level.ServerLevel;
+import org.bukkit.Bukkit;
+import org.bukkit.Location;
+import org.bukkit.World;
+import org.bukkit.command.CommandSender;
+import org.bukkit.entity.Player;
+import org.bukkit.permissions.Permission;
+import org.bukkit.permissions.PermissionDefault;
+import org.checkerframework.checker.nullness.qual.NonNull;
+import org.checkerframework.checker.nullness.qual.Nullable;
+import org.checkerframework.framework.qual.DefaultQualifier;
+
+import static net.kyori.adventure.text.Component.text;
+import static net.kyori.adventure.text.format.NamedTextColor.GRAY;
+import static net.kyori.adventure.text.format.NamedTextColor.GREEN;
+import static net.kyori.adventure.text.format.NamedTextColor.RED;
+import static net.kyori.adventure.text.format.NamedTextColor.WHITE;
+
+/**
+ * {@code /kodama redstone top|info|set}: the redstone activity of chunks, and switching single chunks to Alternate
+ * Current. Chunks are given as chunk coordinates; players default to the chunk they stand in.
+ */
+@DefaultQualifier(NonNull.class)
+public final class RedstoneCommand extends PermissionedKodamaSubcommand {
+
+    public static final String LITERAL_ARGUMENT = "redstone";
+    public static final String PERM = KodamaCommands.COMMAND_BASE_PERM + "." + LITERAL_ARGUMENT;
+
+    private static final List<String> ACTIONS = List.of("top", "info", "set");
+    private static final List<String> MODES = List.of("alternate-current", "vanilla");
+    private static final String TOP_USAGE = "/kodama redstone top [count] [world]";
+    private static final String INFO_USAGE = "/kodama redstone info [chunkX chunkZ [world]]";
+    private static final String SET_USAGE = "/kodama redstone set <alternate-current|vanilla> [chunkX chunkZ [world]]";
+    private static final int DEFAULT_TOP = 10;
+
+    public RedstoneCommand() {
+        super(PERM, PermissionDefault.OP);
+    }
+
+    @Override
+    public List<Permission> permissions() {
+        return List.of(this.permission, new Permission(RedstoneMonitor.NOTIFY_PERMISSION, "Receives Kodama reports about redstone clocks", PermissionDefault.OP));
+    }
+
+    @Override
+    public boolean execute(final CommandSender sender, final String subCommand, final String[] args) {
+        if (args.length == 0) {
+            sendUsage(sender);
+            return false;
+        }
+        final String[] rest = java.util.Arrays.copyOfRange(args, 1, args.length);
+        return switch (args[0].toLowerCase(Locale.ROOT)) {
+            case "top" -> this.top(sender, rest);
+            case "info" -> this.info(sender, rest);
+            case "set" -> this.set(sender, rest);
+            default -> {
+                sendUsage(sender);
+                yield false;
+            }
+        };
+    }
+
+    private static void sendUsage(final CommandSender sender) {
+        sender.sendMessage(text("Usage:", RED));
+        sender.sendMessage(text("  " + TOP_USAGE, RED));
+        sender.sendMessage(text("  " + INFO_USAGE, RED));
+        sender.sendMessage(text("  " + SET_USAGE, RED));
+    }
+
+    private boolean top(final CommandSender sender, final String[] args) {
+        if (args.length > 2) {
+            sender.sendMessage(text("Usage: " + TOP_USAGE, RED));
+            return false;
+        }
+        int count = DEFAULT_TOP;
+        if (args.length >= 1) {
+            try {
+                count = Math.max(1, Integer.parseInt(args[0]));
+            } catch (final NumberFormatException exception) {
+                sender.sendMessage(text("'" + args[0] + "' is not a number.", RED));
+                return false;
+            }
+        }
+        final List<ServerLevel> levels = new ArrayList<>();
+        if (args.length == 2) {
+            final @Nullable ServerLevel level = level(args[1]);
+            if (level == null) {
+                sender.sendMessage(text("Unknown world.", RED));
+                return false;
+            }
+            levels.add(level);
+        } else {
+            for (final ServerLevel level : MinecraftServer.getServer().getAllLevels()) {
+                levels.add(level);
+            }
+        }
+        boolean any = false;
+        for (final ServerLevel level : levels) {
+            if (!level.kodamaRedstone.isActive()) {
+                continue;
+            }
+            for (final RedstoneMonitor.ChunkReport report : level.kodamaRedstone.top(count)) {
+                any = true;
+                sender.sendMessage(text("  " + level.getWorld().getName() + " " + report.chunkX() + " " + report.chunkZ() + ": ", WHITE).append(describe(report)));
+            }
+        }
+        if (!any) {
+            sender.sendMessage(text("No redstone activity in the last minute" + (levels.stream().anyMatch(l -> l.kodamaRedstone.isActive()) ? "." : " (redstone monitoring is off)."), GRAY));
+        }
+        return true;
+    }
+
+    private boolean info(final CommandSender sender, final String[] args) {
+        final @Nullable Target target = target(sender, args, INFO_USAGE);
+        if (target == null) {
+            return false;
+        }
+        final RedstoneMonitor.@Nullable ChunkReport report = target.level.kodamaRedstone.report(target.chunkX, target.chunkZ);
+        final String name = target.level.getWorld().getName() + " " + target.chunkX + " " + target.chunkZ + ": ";
+        if (!target.level.kodamaRedstone.isActive()) {
+            sender.sendMessage(text(name, WHITE).append(text("redstone monitoring is off in this world", GRAY)));
+        } else if (report == null) {
+            sender.sendMessage(text(name, WHITE).append(text("no redstone activity in the last minute, "
+                + (target.level.kodamaRedstone.usesAlternateCurrent(target.chunkX, target.chunkZ) ? "Alternate Current" : "world implementation"), GRAY)));
+        } else {
+            sender.sendMessage(text(name, WHITE).append(describe(report)));
+        }
+        return true;
+    }
+
+    private boolean set(final CommandSender sender, final String[] args) {
+        if (args.length == 0) {
+            sender.sendMessage(text("Usage: " + SET_USAGE, RED));
+            return false;
+        }
+        final String mode = args[0].toLowerCase(Locale.ROOT);
+        if (!MODES.contains(mode)) {
+            sender.sendMessage(text("The mode must be alternate-current or vanilla.", RED));
+            return false;
+        }
+        final @Nullable Target target = target(sender, java.util.Arrays.copyOfRange(args, 1, args.length), SET_USAGE);
+        if (target == null) {
+            return false;
+        }
+        if (!target.level.kodamaRedstone.isActive()) {
+            sender.sendMessage(text("Redstone monitoring (redstone.enabled) is off in " + target.level.getWorld().getName() + ".", RED));
+            return false;
+        }
+        if (!target.level.kodamaRedstone.requestSwitch(target.chunkX, target.chunkZ, mode.equals("alternate-current"), sender)) {
+            sender.sendMessage(text("Chunk " + target.chunkX + " " + target.chunkZ + " is not loaded.", RED));
+            return false;
+        }
+        sender.sendMessage(text("Switching chunk " + target.chunkX + " " + target.chunkZ + " once its redstone is quiet.", GREEN));
+        return true;
+    }
+
+    private static net.kyori.adventure.text.Component describe(final RedstoneMonitor.ChunkReport report) {
+        return text(String.format(Locale.ROOT, "%s, %.1f updates/s, active %d of the last %d s, %s", report.kind().displayName(),
+            report.updatesPerSecond(), report.activeSeconds(), 60, report.alternateCurrent() ? "Alternate Current" : "world implementation"), GRAY);
+    }
+
+    private record Target(ServerLevel level, int chunkX, int chunkZ) {
+    }
+
+    private static @Nullable Target target(final CommandSender sender, final String[] args, final String usage) {
+        if (args.length == 0) {
+            if (sender instanceof Player player) {
+                final Location location = player.getLocation();
+                return new Target(((org.bukkit.craftbukkit.CraftWorld) player.getWorld()).getHandle(), location.getBlockX() >> 4, location.getBlockZ() >> 4);
+            }
+            sender.sendMessage(text("The console must give the chunk: " + usage, RED));
+            return null;
+        }
+        if (args.length < 2 || args.length > 3) {
+            sender.sendMessage(text("Usage: " + usage, RED));
+            return null;
+        }
+        final int chunkX;
+        final int chunkZ;
+        try {
+            chunkX = Integer.parseInt(args[0]);
+            chunkZ = Integer.parseInt(args[1]);
+        } catch (final NumberFormatException exception) {
+            sender.sendMessage(text("The chunk coordinates must be whole numbers.", RED));
+            return null;
+        }
+        final @Nullable ServerLevel level = args.length == 3 ? level(args[2])
+            : sender instanceof Player player ? ((org.bukkit.craftbukkit.CraftWorld) player.getWorld()).getHandle() : null;
+        if (level == null) {
+            sender.sendMessage(text("Unknown world. The console must name the world.", RED));
+            return null;
+        }
+        return new Target(level, chunkX, chunkZ);
+    }
+
+    private static @Nullable ServerLevel level(final String name) {
+        return KodamaConfigurations.levelByName(MinecraftServer.getServer(), name);
+    }
+
+    @Override
+    public List<String> tabComplete(final CommandSender sender, final String subCommand, final String[] args) {
+        if (args.length <= 1) {
+            return Completions.matchingLast(args, ACTIONS);
+        }
+        final List<String> worlds = new ArrayList<>();
+        for (final World world : Bukkit.getWorlds()) {
+            worlds.add(world.getName());
+        }
+        return switch (args[0].toLowerCase(Locale.ROOT)) {
+            case "top" -> args.length == 3 ? Completions.matchingLast(args, worlds) : Collections.emptyList();
+            case "info" -> args.length == 4 ? Completions.matchingLast(args, worlds) : Collections.emptyList();
+            case "set" -> args.length == 2 ? Completions.matchingLast(args, MODES) : args.length == 5 ? Completions.matchingLast(args, worlds) : Collections.emptyList();
+            default -> Collections.emptyList();
+        };
+    }
+}
