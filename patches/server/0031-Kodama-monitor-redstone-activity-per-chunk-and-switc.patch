--- /dev/null
+++ b/src/main/java/dev/kodama/redstone/RedstoneStatus.java
@@ -0,0 +1,47 @@
+package dev.kodama.redstone;
+
+import dev.kodama.command.StatusContributor;
+import dev.kodama.command.subcommands.StatusCommand;
+import net.kyori.adventure.text.Component;
+import net.kyori.adventure.text.TextComponent;
+import net.minecraft.server.MinecraftServer;
+import net.minecraft.server.level.ServerLevel;
+
+import static net.kyori.adventure.text.Component.text;
+import static net.kyori.adventure.text.format.NamedTextColor.GRAY;
+import static net.kyori.adventure.text.format.NamedTextColor.WHITE;
+
+/**
+ * The {@code Redstone} line of {@code /kodama status}.
+ */
+public final class RedstoneStatus {
+
+    private RedstoneStatus() {
+    }
+
+    public static void register() {
+        StatusCommand.register(new StatusContributor() {
+            @Override
+            public String label() {
+                return "Redstone";
+            }
+
+            @Override
+            public Component describe() {
+                TextComponent result = text("");
+                for (final ServerLevel level : MinecraftServer.getServer().getAllLevels()) {
+                    result = result.append(text("\n  " + level.getWorld().getName() + ": ", WHITE));
+                    if (!level.kodamaRedstone.isActive()) {
+                        result = result.append(text("off", GRAY));
+                        continue;
+                    }
+                    final int[] counts = level.kodamaRedstone.countKinds();
+                    result = result.append(text("active chunks: " + counts[RedstoneMonitor.Kind.TRANSIENT.ordinal()] + " transient, "
+                        + counts[RedstoneMonitor.Kind.CONTINUOUS.ordinal()] + " continuous, " + counts[RedstoneMonitor.Kind.ABNORMAL.ordinal()]
+                        + " abnormal; loaded Alternate Current chunks: " + counts[RedstoneMonitor.Kind.values().length], GRAY));
+                }
+                return result;
+            }
+        });
+    }
+}
