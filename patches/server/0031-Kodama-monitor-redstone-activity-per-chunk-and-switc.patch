@@ -0,0 +1,41 @@
+package dev.kodama.redstone;
+
+import io.papermc.paper.configuration.WorldConfiguration;
+import net.minecraft.core.BlockPos;
+import net.minecraft.server.level.ServerLevel;
+import net.minecraft.world.level.Level;
+import net.minecraft.world.level.chunk.LevelChunk;
+
+/**
+ * Entry points of the redstone monitor for the code that was patched into the game.
+ */
+public final class KodamaRedstone {
+
+    private KodamaRedstone() {
+    }
+
+    /**
+     * A redstone component at the position updated: wire, repeater, comparator, observer or piston.
+     */
+    public static void record(final Level world, final BlockPos pos) {
+        if (world instanceof ServerLevel level) {
+            level.kodamaRedstone.record(pos);
+        }
+    }
+
+    /**
+     * Whether the wire at the position is handled by Alternate Current: the world uses it, or the chunk was switched to it.
+     */
+    public static boolean alternateCurrent(final Level world, final BlockPos pos) {
+        return world.paperConfig().misc.redstoneImplementation == WorldConfiguration.Misc.RedstoneImplementation.ALTERNATE_CURRENT
+            || world instanceof ServerLevel level && level.kodamaRedstone.usesAlternateCurrent(pos);
+    }
+
+    public static void onChunkLoad(final LevelChunk chunk) {
+        chunk.level.kodamaRedstone.onChunkLoad(chunk);
+    }
+
+    public static void onChunkUnload(final LevelChunk chunk) {
+        chunk.level.kodamaRedstone.onChunkUnload(chunk);
+    }
+}
diff --git a/src/main/java/dev/kodama/redstone/RedstoneMonitor.java b/src/main/java/dev/kodama/redstone/RedstoneMonitor.java
new file mode 100644
index 0000000000000000000000000000000000000000..3de6ac4639281a1737b88865fa5f42fe126f24e8
--- /dev/null
+++ b/src/main/java/dev/kodama/redstone/RedstoneMonitor.java
@@ -0,0 +1,314 @@
+package dev.kodama.redstone;
+
+import dev.kodama.config.KodamaWorldConfiguration;
+import dev.kodama.feature.FeatureGuard;
+import it.unimi.dsi.fastutil.longs.Long2IntMap;
+import it.unimi.dsi.fastutil.longs.Long2IntOpenHashMap;
+import it.unimi.dsi.fastutil.longs.Long2ObjectMap;
+import it.unimi.dsi.fastutil.longs.Long2ObjectOpenHashMap;
+import it.unimi.dsi.fastutil.longs.LongOpenHashSet;
+import it.unimi.dsi.fastutil.objects.ObjectIterator;
+import java.util.ArrayList;
+import java.util.Comparator;
+import java.util.List;
+import java.util.Locale;
+import net.minecraft.core.BlockPos;
+import net.minecraft.server.MinecraftServer;
+import net.minecraft.server.level.ServerLevel;
+import net.minecraft.world.level.ChunkPos;
+import net.minecraft.world.level.chunk.LevelChunk;
+import org.bukkit.Bukkit;
+import org.bukkit.NamespacedKey;
+import org.bukkit.command.CommandSender;
+import org.bukkit.persistence.PersistentDataType;
+import org.checkerframework.checker.nullness.qual.Nullable;
+
+import static net.kyori.adventure.text.Component.text;
+import static net.kyori.adventure.text.format.NamedTextColor.GOLD;
+import static net.kyori.adventure.text.format.NamedTextColor.GREEN;
+import static net.kyori.adventure.text.format.NamedTextColor.RED;
+
+/**
+ * Redstone activity of the chunks of one world, and the chunks that use Alternate Current although the world does not.
+ * <p>
+ * Every redstone update adds one to the count of its chunk for the current tick. Once per second (20 ticks) the counts go
+ * into a 60 second history per chunk: a chunk that updated in at least {@link #CONTINUOUS_SECONDS} of the last 60 seconds
+ * runs a clock (continuous), otherwise its redstone was triggered and settled again (transient). The Alternate Current
+ * choice is stored in the persistent data of the chunk and read when the chunk loads. Main thread only.
+ */
+public final class RedstoneMonitor {
+
+    private static final org.slf4j.Logger LOGGER = com.mojang.logging.LogUtils.getLogger();
+    public static final String FEATURE_ID = "redstone";
+    public static final String NOTIFY_PERMISSION = "kodama.redstone.notify";
+    static final NamespacedKey MODE_KEY = new NamespacedKey("kodama", "redstone");
+    static final String ALTERNATE_CURRENT = "alternate-current";
+
+    static final int WINDOW_SECONDS = 60;
+    static final int CONTINUOUS_SECONDS = 45;
+    private static final long WINDOW_MASK = (1L << WINDOW_SECONDS) - 1L;
+    private static final int SWITCH_TIMEOUT_TICKS = 10 * 20;
+
+    public enum Kind {
+        TRANSIENT, CONTINUOUS, ABNORMAL;
+
+        public String displayName() {
+            return switch (this) {
+                case TRANSIENT -> "transient";
+                case CONTINUOUS -> "continuous (clock)";
+                case ABNORMAL -> "abnormal (possible lag machine)";
+            };
+        }
+    }
+
+    static final class History {
+        final long chunkKey;
+        long activeMask;
+        final int[] perSecond = new int[WINDOW_SECONDS];
+        int cursor;
+        long total;
+        long lastNotifiedTick = Long.MIN_VALUE / 2;
+
+        History(final long chunkKey) {
+            this.chunkKey = chunkKey;
+        }
+
+        int activeSeconds() {
+            return Long.bitCount(this.activeMask);
+        }
+
+        double updatesPerSecond() {
+            return this.total / (double) WINDOW_SECONDS;
+        }
+    }
+
+    public record ChunkReport(int chunkX, int chunkZ, Kind kind, double updatesPerSecond, int activeSeconds, boolean alternateCurrent) {
+    }
+
+    private record PendingSwitch(boolean alternateCurrent, @Nullable CommandSender sender, long requestedTick) {
+    }
+
+    private final ServerLevel level;
+    private boolean active;
+    private final Long2IntOpenHashMap thisTick = new Long2IntOpenHashMap();
+    private final Long2IntOpenHashMap thisSecond = new Long2IntOpenHashMap();
+    private final Long2ObjectOpenHashMap<History> histories = new Long2ObjectOpenHashMap<>();
+    private final LongOpenHashSet alternateCurrentChunks = new LongOpenHashSet();
+    private final Long2ObjectOpenHashMap<PendingSwitch> pending = new Long2ObjectOpenHashMap<>();
+    private int tickInSecond;
+
+    public RedstoneMonitor(final ServerLevel level) {
+        this.level = level;
+    }
+
+    private KodamaWorldConfiguration.@Nullable Redstone section() {
+        final KodamaWorldConfiguration config = this.level.kodamaConfig();
+        return config == null ? null : config.redstone;
+    }
+
+    public boolean isActive() {
+        return this.active;
+    }
+
+    public void record(final BlockPos pos) {
+        if (this.active) {
+            this.thisTick.addTo(ChunkPos.asLong(pos.getX() >> 4, pos.getZ() >> 4), 1);
+        }
+    }
+
+    boolean usesAlternateCurrent(final BlockPos pos) {
+        return this.active && !this.alternateCurrentChunks.isEmpty()
+            && this.alternateCurrentChunks.contains(ChunkPos.asLong(pos.getX() >> 4, pos.getZ() >> 4));
+    }
+
+    public boolean usesAlternateCurrent(final int chunkX, final int chunkZ) {
+        return this.alternateCurrentChunks.contains(ChunkPos.asLong(chunkX, chunkZ));
+    }
+
+    void onChunkLoad(final LevelChunk chunk) {
+        if (ALTERNATE_CURRENT.equals(chunk.persistentDataContainer.get(MODE_KEY, PersistentDataType.STRING))) {
+            this.alternateCurrentChunks.add(chunk.getPos().toLong());
+        }
+    }
+
+    void onChunkUnload(final LevelChunk chunk) {
+        final long key = chunk.getPos().toLong();
+        this.alternateCurrentChunks.remove(key);
+        this.pending.remove(key);
+    }
+
+    /**
+     * Start of the world tick: the counts of the previous tick are complete.
+     */
+    public void tick() {
+        try {
+            final KodamaWorldConfiguration.Redstone section = this.section();
+            final boolean wasActive = this.active;
+            this.active = section != null && section.enabled.isTrue() && !FeatureGuard.isTripped(FEATURE_ID);
+            if (!this.active) {
+                if (wasActive) {
+                    this.thisTick.clear();
+                    this.thisSecond.clear();
+                    this.histories.clear();
+                    this.pending.clear();
+                }
+                return;
+            }
+            if (!this.pending.isEmpty()) {
+                this.applyPendingSwitches();
+            }
+            if (!this.thisTick.isEmpty()) {
+                for (final Long2IntMap.Entry entry : this.thisTick.long2IntEntrySet()) {
+                    this.thisSecond.addTo(entry.getLongKey(), entry.getIntValue());
+                }
+                this.thisTick.clear();
+            }
+            if (++this.tickInSecond >= 20) {
+                this.tickInSecond = 0;
+                this.rollSecond(section);
+            }
+        } catch (final VirtualMachineError error) {
+            throw error;
+        } catch (final Throwable throwable) {
+            FeatureGuard.reportFailure(FEATURE_ID, throwable);
+        }
+    }
+
+    private void rollSecond(final KodamaWorldConfiguration.Redstone section) {
+        final ObjectIterator<Long2ObjectMap.Entry<History>> iterator = this.histories.long2ObjectEntrySet().fastIterator();
+        while (iterator.hasNext()) {
+            final History history = iterator.next().getValue();
+            this.advance(history, this.thisSecond.remove(history.chunkKey));
+            if (history.activeMask == 0L) {
+                iterator.remove();
+            }
+        }
+        for (final Long2IntMap.Entry entry : this.thisSecond.long2IntEntrySet()) {
+            final History history = new History(entry.getLongKey());
+            this.advance(history, entry.getIntValue());
+            this.histories.put(history.chunkKey, history);
+        }
+        this.thisSecond.clear();
+
+        if (section.notify) {
+            final long now = MinecraftServer.currentTickLong;
+            final long cooldown = Math.max(1L, section.notifyCooldownMinutes) * 60L * 20L;
+            for (final History history : this.histories.values()) {
+                final Kind kind = kind(history, section);
+                if (kind != Kind.TRANSIENT && history.updatesPerSecond() >= section.notifyUpdatesPerSecond
+                    && now - history.lastNotifiedTick >= cooldown) {
+                    history.lastNotifiedTick = now;
+                    this.notifyAdmins(history, kind);
+                }
+            }
+        }
+    }
+
+    private void advance(final History history, final int updates) {
+        history.cursor = (history.cursor + 1) % WINDOW_SECONDS;
+        history.total += updates - history.perSecond[history.cursor];
+        history.perSecond[history.cursor] = updates;
+        history.activeMask = ((history.activeMask << 1) | (updates > 0 ? 1L : 0L)) & WINDOW_MASK;
+    }
+
+    static Kind kind(final History history, final KodamaWorldConfiguration.Redstone section) {
+        if (history.activeSeconds() < CONTINUOUS_SECONDS) {
+            return Kind.TRANSIENT;
+        }
+        return history.updatesPerSecond() >= section.abnormalUpdatesPerSecond ? Kind.ABNORMAL : Kind.CONTINUOUS;
+    }
+
+    private void notifyAdmins(final History history, final Kind kind) {
+        final int chunkX = ChunkPos.getX(history.chunkKey);
+        final int chunkZ = ChunkPos.getZ(history.chunkKey);
+        final String where = String.format(Locale.ROOT, "%s chunk %d %d (blocks %d %d)", this.level.getWorld().getName(), chunkX, chunkZ,
+            chunkX << 4, chunkZ << 4);
+        final String rate = String.format(Locale.ROOT, "%.0f redstone updates/s", history.updatesPerSecond());
+        final boolean alternateCurrent = this.usesAlternateCurrent(chunkX, chunkZ);
+        final String hint = alternateCurrent ? "" : " Switch it with /kodama redstone set alternate-current " + chunkX + " " + chunkZ + " " + this.level.getWorld().getName();
+        final String message = (kind == Kind.ABNORMAL ? "Possible lag machine at " : "Redstone clock at ") + where + ": " + rate + "." + hint;
+        LOGGER.warn("[Kodama] {}", message);
+        Bukkit.broadcast(text("[Kodama] " + message, kind == Kind.ABNORMAL ? RED : GOLD), NOTIFY_PERMISSION);
+    }
+
+    /**
+     * Switches a loaded chunk to Alternate Current or back to the world setting at the next tick in which its redstone does
+     * not update (or after a few seconds if it never stops), so no update runs half with one and half with the other
+     * implementation. Returns false when the chunk is not loaded.
+     */
+    public boolean requestSwitch(final int chunkX, final int chunkZ, final boolean alternateCurrent, final @Nullable CommandSender sender) {
+        if (this.level.getChunkIfLoaded(chunkX, chunkZ) == null) {
+            return false;
+        }
+        this.pending.put(ChunkPos.asLong(chunkX, chunkZ), new PendingSwitch(alternateCurrent, sender, MinecraftServer.currentTickLong));
+        return true;
+    }
+
+    private void applyPendingSwitches() {
+        final long now = MinecraftServer.currentTickLong;
+        final ObjectIterator<Long2ObjectMap.Entry<PendingSwitch>> iterator = this.pending.long2ObjectEntrySet().fastIterator();
+        while (iterator.hasNext()) {
+            final Long2ObjectMap.Entry<PendingSwitch> entry = iterator.next();
+            final long key = entry.getLongKey();
+            final PendingSwitch request = entry.getValue();
+            final boolean quiet = !this.thisTick.containsKey(key);
+            if (!quiet && now - request.requestedTick() < SWITCH_TIMEOUT_TICKS) {
+                continue;
+            }
+            iterator.remove();
+            final LevelChunk chunk = this.level.getChunkIfLoaded(ChunkPos.getX(key), ChunkPos.getZ(key));
+            if (chunk == null) {
+                continue;
+            }
+            if (request.alternateCurrent()) {
+                chunk.persistentDataContainer.set(MODE_KEY, PersistentDataType.STRING, ALTERNATE_CURRENT);
+                this.alternateCurrentChunks.add(key);
+            } else {
+                chunk.persistentDataContainer.remove(MODE_KEY);
+                this.alternateCurrentChunks.remove(key);
+            }
+            if (request.sender() != null) {
+                request.sender().sendMessage(text("Chunk " + ChunkPos.getX(key) + " " + ChunkPos.getZ(key) + " in " + this.level.getWorld().getName()
+                    + " now uses " + (request.alternateCurrent() ? "Alternate Current" : "the world's redstone implementation")
+                    + (quiet ? "." : " (its redstone never stopped, switched after " + SWITCH_TIMEOUT_TICKS / 20 + " seconds)."), GREEN));
+            }
+        }
+    }
+
+    public @Nullable ChunkReport report(final int chunkX, final int chunkZ) {
+        final KodamaWorldConfiguration.Redstone section = this.section();
+        final History history = this.histories.get(ChunkPos.asLong(chunkX, chunkZ));
+        if (section == null || history == null) {
+            return null;
+        }
+        return new ChunkReport(chunkX, chunkZ, kind(history, section), history.updatesPerSecond(), history.activeSeconds(),
+            this.usesAlternateCurrent(chunkX, chunkZ));
+    }
+
+    /**
+     * Chunks with the most redstone updates in the last minute, most first.
+     */
+    public List<ChunkReport> top(final int limit) {
+        final List<ChunkReport> reports = new ArrayList<>();
+        for (final History history : this.histories.values()) {
+            final ChunkReport report = this.report(ChunkPos.getX(history.chunkKey), ChunkPos.getZ(history.chunkKey));
+            if (report != null) {
+                reports.add(report);
+            }
+        }
+        reports.sort(Comparator.comparingDouble(ChunkReport::updatesPerSecond).reversed());
+        return reports.size() > limit ? reports.subList(0, limit) : reports;
+    }
+
+    public int[] countKinds() {
+        final int[] counts = new int[Kind.values().length + 1];
+        final KodamaWorldConfiguration.Redstone section = this.section();
+        if (section != null) {
+            for (final History history : this.histories.values()) {
+                counts[kind(history, section).ordinal()]++;
+            }
+        }
+        counts[Kind.values().length] = this.alternateCurrentChunks.size();
+        return counts;
+    }
+}
