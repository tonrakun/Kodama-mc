@@ -0,0 +1,73 @@
+package dev.kodama.chunk.adaptive;
+
+import dev.kodama.command.StatusContributor;
+import dev.kodama.command.subcommands.StatusCommand;
+import io.papermc.paper.chunk.system.RegionizedPlayerChunkLoader;
+import java.util.Locale;
+import net.kyori.adventure.text.Component;
+import net.kyori.adventure.text.TextComponent;
+import net.minecraft.server.MinecraftServer;
+import net.minecraft.server.level.ServerLevel;
+import net.minecraft.server.level.ServerPlayer;
+
+import static net.kyori.adventure.text.Component.text;
+import static net.kyori.adventure.text.format.NamedTextColor.GRAY;
+import static net.kyori.adventure.text.format.NamedTextColor.WHITE;
+
+/**
+ * The {@code /kodama status} lines of the player behaviour adaptation.
+ */
+public final class AdaptiveStatus {
+
+    private AdaptiveStatus() {
+    }
+
+    public static void register() {
+        StatusCommand.register(new StatusContributor() {
+            @Override
+            public String label() {
+                return "Player types";
+            }
+
+            @Override
+            public Component describe() {
+                if (!AdaptiveSettings.configuredEnabled()) {
+                    return text("off", GRAY);
+                }
+                TextComponent result = text("");
+                boolean any = false;
+                for (final ServerLevel level : MinecraftServer.getServer().getAllLevels()) {
+                    for (final ServerPlayer player : level.players()) {
+                        final RegionizedPlayerChunkLoader.PlayerChunkLoaderData loader = player.chunkLoader;
+                        if (loader == null) {
+                            continue;
+                        }
+                        any = true;
+                        final PlayerBehaviour behaviour = player.kodamaBehaviour();
+                        result = result.append(text("\n  " + player.getScoreboardName() + ": ", WHITE)).append(text(
+                            String.format(Locale.ROOT, "%s, %.1f new chunks/min, %.1f b/s, route %d chunks, route prefetch %d",
+                                behaviour.type().id(), loader.kodamaMotion().newChunksPerMinute(), loader.kodamaMotion().speedBlocksPerSecond(),
+                                behaviour.route().distinct(), loader.kodamaPrefetcher().routeStarted()), GRAY));
+                    }
+                }
+                return any ? result : text("no players", GRAY);
+            }
+        });
+        StatusCommand.register(new StatusContributor() {
+            @Override
+            public String label() {
+                return "Chunk budget";
+            }
+
+            @Override
+            public Component describe() {
+                if (!AdaptiveBudget.limited()) {
+                    return text("unlimited", GRAY);
+                }
+                return text(String.format(Locale.ROOT, "%d chunks/s total, %.0f chunks/s for prefetch and pre-generation (%d players), %.0f left",
+                    AdaptiveSettings.budgetChunksPerSecond(), AdaptiveBudget.extraChunksPerSecond(), AdaptiveBudget.onlinePlayers(),
+                    AdaptiveBudget.tokensLeft()), GRAY);
+            }
+        });
+    }
+}
diff --git a/src/main/java/dev/kodama/chunk/adaptive/PlayerBehaviour.java b/src/main/java/dev/kodama/chunk/adaptive/PlayerBehaviour.java
new file mode 100644
index 0000000000000000000000000000000000000000..befcaf9732028f7e85c7b5c407a5ac4759779b1a
--- /dev/null
+++ b/src/main/java/dev/kodama/chunk/adaptive/PlayerBehaviour.java
@@ -0,0 +1,243 @@
+package dev.kodama.chunk.adaptive;
+
+import dev.kodama.chunk.PlayerMotion;
+import io.papermc.paper.util.CoordinateUtils;
+import net.minecraft.nbt.CompoundTag;
+import net.minecraft.server.level.ServerLevel;
+import org.checkerframework.checker.nullness.qual.Nullable;
+
+/**
+ * Classifies a player as settler, commuter or explorer from the five minute window of {@link PlayerMotion}, and keeps the
+ * remembered routes of the player. The type only switches after a different type won for {@code type-switch-seconds}.
+ * <p>
+ * The type and two moving averages are stored in the player data (tag {@code Kodama}), so a player who joins again starts
+ * with what was learned before; the live measurement takes over as the window fills. Main thread only.
+ */
+public final class PlayerBehaviour {
+
+    public enum Type {
+        SETTLER("settler"), COMMUTER("commuter"), EXPLORER("explorer");
+
+        private final String id;
+
+        Type(final String id) {
+            this.id = id;
+        }
+
+        public String id() {
+            return this.id;
+        }
+
+        static @Nullable Type fromId(final String id) {
+            for (final Type type : values()) {
+                if (type.id.equals(id)) {
+                    return type;
+                }
+            }
+            return null;
+        }
+    }
+
+    static final String TAG = "Kodama";
+
+    private static final int EVALUATE_INTERVAL = 20;
+    private static final int AVERAGE_INTERVAL = 200;
+    private static final double AVERAGE_ALPHA = 0.1;
+    private static final int MIN_WINDOW_TICKS = 200; // less than this is no evidence
+    private static final int FULL_WINDOW_TICKS = 6000;
+    private static final int TELEPORT_CHUNKS = 4;
+
+    // a player who finds this many new chunks per minute is exploring
+    private static final double EXPLORER_NEW_CHUNKS_PER_MINUTE = 30.0;
+    // fast travel (elytra, vehicle) counts at a lower rate
+    private static final double FAST_TRAVEL_NEW_CHUNKS_PER_MINUTE = 12.0;
+    private static final double FAST_TRAVEL_FRACTION = 0.2;
+    private static final double VEHICLE_FRACTION = 0.5;
+    // everything inside this range during five minutes is a base
+    private static final double SETTLER_RANGE_BLOCKS = 160.0;
+
+    private Type type = Type.COMMUTER;
+    private @Nullable Type pending;
+    private long pendingSince;
+    private long updates;
+
+    private boolean hasAverages;
+    private double averageNewChunks;
+    private double averageSpeed; // blocks per second
+    private boolean stored;
+
+    private double liveNewChunks;
+    private double liveSpeed;
+    private boolean live;
+
+    private @Nullable ServerLevel world;
+    private final RouteMemory route = new RouteMemory();
+    private boolean hasLastChunk;
+    private int lastChunkX;
+    private int lastChunkZ;
+
+    public Type type() {
+        return this.type;
+    }
+
+    public RouteMemory route() {
+        return this.route;
+    }
+
+    /**
+     * New chunks per minute as measured by the window, valid once {@link #hasLiveData()}.
+     */
+    public double liveNewChunksPerMinute() {
+        return this.liveNewChunks;
+    }
+
+    /**
+     * Average speed in blocks per second as measured by the window.
+     */
+    public double liveSpeed() {
+        return this.liveSpeed;
+    }
+
+    public boolean hasLiveData() {
+        return this.live;
+    }
+
+    public boolean hasAverages() {
+        return this.hasAverages;
+    }
+
+    public double averageNewChunksPerMinute() {
+        return this.averageNewChunks;
+    }
+
+    public double averageSpeedBlocksPerSecond() {
+        return this.averageSpeed;
+    }
+
+    /**
+     * Main thread, once per tick after {@link PlayerMotion#update}.
+     */
+    public void update(final ServerLevel world, final PlayerMotion motion) {
+        this.updates++;
+        if (this.world != world) {
+            this.world = world;
+            this.route.clear();
+            this.hasLastChunk = false;
+            this.pending = null;
+            this.live = false;
+        }
+        this.recordRoute(motion);
+        if (this.updates % EVALUATE_INTERVAL == 0) {
+            this.evaluate(motion);
+        }
+    }
+
+    private void recordRoute(final PlayerMotion motion) {
+        this.route.ensureCapacity(AdaptiveSettings.routeMemoryChunks());
+        if (!motion.hasChunk()) {
+            this.hasLastChunk = false;
+            return;
+        }
+        final int chunkX = motion.chunkX();
+        final int chunkZ = motion.chunkZ();
+        if (this.hasLastChunk && this.lastChunkX == chunkX && this.lastChunkZ == chunkZ) {
+            return;
+        }
+        final boolean continuous = this.hasLastChunk
+            && Math.max(Math.abs(chunkX - this.lastChunkX), Math.abs(chunkZ - this.lastChunkZ)) <= TELEPORT_CHUNKS;
+        this.hasLastChunk = true;
+        this.lastChunkX = chunkX;
+        this.lastChunkZ = chunkZ;
+        if (continuous) {
+            this.route.record(CoordinateUtils.getChunkKey(chunkX, chunkZ));
+        }
+    }
+
+    private void evaluate(final PlayerMotion motion) {
+        final int window = motion.windowTicks();
+        this.liveNewChunks = motion.newChunksPerMinute();
+        this.liveSpeed = motion.averageSpeed() * 20.0;
+        this.live = window >= MIN_WINDOW_TICKS;
+        if (!this.live) {
+            this.pending = null; // no evidence yet, the stored type stays
+            return;
+        }
+
+        // the part of the window that is not filled yet is taken from the earlier sessions
+        final double weight = Math.min(1.0, (double)window / FULL_WINDOW_TICKS);
+        final double newChunks = this.hasAverages ? weight * this.liveNewChunks + (1.0 - weight) * this.averageNewChunks : this.liveNewChunks;
+        final double recent = motion.recentNewChunksPerMinute();
+        final Type candidate = classify(Math.max(newChunks, recent), motion.elytraFraction(), motion.vehicleFraction(), motion.boundingRange());
+        this.switchType(candidate);
+
+        if (this.updates % AVERAGE_INTERVAL == 0) {
+            if (this.hasAverages) {
+                this.averageNewChunks += (this.liveNewChunks - this.averageNewChunks) * AVERAGE_ALPHA;
+                this.averageSpeed += (this.liveSpeed - this.averageSpeed) * AVERAGE_ALPHA;
+            } else {
+                this.averageNewChunks = this.liveNewChunks;
+                this.averageSpeed = this.liveSpeed;
+                this.hasAverages = true;
+            }
+        }
+    }
+
+    static Type classify(final double newChunksPerMinute, final double elytraFraction, final double vehicleFraction, final double rangeBlocks) {
+        if (newChunksPerMinute >= EXPLORER_NEW_CHUNKS_PER_MINUTE
+            || (newChunksPerMinute >= FAST_TRAVEL_NEW_CHUNKS_PER_MINUTE && (elytraFraction >= FAST_TRAVEL_FRACTION || vehicleFraction >= VEHICLE_FRACTION))) {
+            return Type.EXPLORER;
+        }
+        if (rangeBlocks <= SETTLER_RANGE_BLOCKS) {
+            return Type.SETTLER;
+        }
+        return Type.COMMUTER;
+    }
+
+    private void switchType(final Type candidate) {
+        if (candidate == this.type) {
+            this.pending = null;
+            return;
+        }
+        if (candidate != this.pending) {
+            this.pending = candidate;
+            this.pendingSince = this.updates;
+            return;
+        }
+        if (this.updates - this.pendingSince >= AdaptiveSettings.typeSwitchTicks()) {
+            this.type = candidate;
+            this.pending = null;
+        }
+    }
+
+    // player data
+
+    public void load(final CompoundTag player) {
+        if (!player.contains(TAG, 10)) {
+            return;
+        }
+        final CompoundTag tag = player.getCompound(TAG);
+        final Type loaded = Type.fromId(tag.getString("type"));
+        if (loaded != null) {
+            this.type = loaded;
+        }
+        if (tag.contains("newChunksPerMinute", 6) && tag.contains("speed", 6)) {
+            this.averageNewChunks = Math.max(0.0, tag.getDouble("newChunksPerMinute"));
+            this.averageSpeed = Math.max(0.0, tag.getDouble("speed"));
+            this.hasAverages = true;
+        }
+        this.stored = true;
+    }
+
+    public void save(final CompoundTag player) {
+        if (!this.stored && !this.hasAverages) {
+            return;
+        }
+        final CompoundTag tag = new CompoundTag();
+        tag.putString("type", this.type.id());
+        if (this.hasAverages) {
+            tag.putDouble("newChunksPerMinute", this.averageNewChunks);
+            tag.putDouble("speed", this.averageSpeed);
+        }
+        player.put(TAG, tag);
+    }
+}
