--- /dev/null
+++ b/src/main/java/dev/kodama/chunk/adaptive/RouteMemory.java
@@ -0,0 +1,81 @@
+package dev.kodama.chunk.adaptive;
+
+import it.unimi.dsi.fastutil.longs.Long2IntOpenHashMap;
+import it.unimi.dsi.fastutil.longs.LongIterator;
+
+/**
+ * The last N chunk positions a player passed through, as a ring buffer plus a count per position so that a position
+ * is forgotten only when its last occurrence leaves the ring. Main thread only.
+ */
+public final class RouteMemory {
+
+    private long[] ring = new long[0];
+    private int head; // next write position, the oldest entry once the ring is full
+    private int size;
+    private final Long2IntOpenHashMap counts = new Long2IntOpenHashMap();
+
+    /**
+     * Applies the configured size; changing it forgets the route.
+     */
+    public void ensureCapacity(final int capacity) {
+        if (this.ring.length != capacity) {
+            this.ring = new long[capacity];
+            this.clear();
+        }
+    }
+
+    public void clear() {
+        this.head = 0;
+        this.size = 0;
+        this.counts.clear();
+    }
+
+    public void record(final long chunk) {
+        if (this.ring.length == 0) {
+            return;
+        }
+        if (this.size == this.ring.length) {
+            final long oldest = this.ring[this.head];
+            final int count = this.counts.get(oldest);
+            if (count <= 1) {
+                this.counts.remove(oldest);
+            } else {
+                this.counts.put(oldest, count - 1);
+            }
+        } else {
+            this.size++;
+        }
+        this.ring[this.head] = chunk;
+        this.head = (this.head + 1) % this.ring.length;
+        this.counts.addTo(chunk, 1);
+    }
+
+    public boolean contains(final long chunk) {
+        return !this.counts.isEmpty() && this.counts.containsKey(chunk);
+    }
+
+    /**
+     * Number of remembered positions, counting repeated passes.
+     */
+    public int size() {
+        return this.size;
+    }
+
+    /**
+     * Number of different remembered chunks.
+     */
+    public int distinct() {
+        return this.counts.size();
+    }
+
+    public boolean isEmpty() {
+        return this.counts.isEmpty();
+    }
+
+    /**
+     * The different remembered chunks.
+     */
+    public LongIterator chunks() {
+        return this.counts.keySet().iterator();
+    }
+}
