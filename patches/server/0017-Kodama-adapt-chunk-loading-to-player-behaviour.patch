new file mode 100644
index 0000000000000000000000000000000000000000..4a6e9f7b86916acade27daee9cd7d53f4dc202f7
--- /dev/null
+++ b/src/main/java/dev/kodama/chunk/adaptive/AdaptiveBudget.java
@@ -0,0 +1,108 @@
+package dev.kodama.chunk.adaptive;
+
+import java.util.List;
+import net.minecraft.server.MinecraftServer;
+import net.minecraft.server.level.ServerPlayer;
+
+/**
+ * Server-wide limit for the extra chunk work of Kodama (prefetch and pre-generation), as a token bucket. The budget
+ * minus {@code min-per-player} for every online player is what the extra work may use; while an explorer asks for
+ * chunks, half of the bucket is kept back for explorers. Paper's own per-player loading is not limited here.
+ * Main thread only.
+ */
+public final class AdaptiveBudget {
+
+    private static final long EXPLORER_INTEREST_TICKS = 20L;
+    private static final double EXPLORER_RESERVE = 0.5;
+
+    private static long lastTick = Long.MIN_VALUE;
+    private static long explorerAskTick = Long.MIN_VALUE;
+    private static double tokens;
+    private static double capacity;
+    private static double ratePerSecond;
+    private static int players;
+    private static boolean limited;
+
+    private AdaptiveBudget() {
+    }
+
+    private static void refresh() {
+        final long now = MinecraftServer.currentTickLong;
+        if (now == lastTick) {
+            return;
+        }
+        final long elapsed = lastTick == Long.MIN_VALUE ? 1L : Math.min(20L, now - lastTick);
+        lastTick = now;
+
+        final int budget = AdaptiveSettings.enabled() ? AdaptiveSettings.budgetChunksPerSecond() : 0;
+        limited = budget > 0;
+        if (!limited) {
+            return;
+        }
+        final MinecraftServer server = MinecraftServer.getServer();
+        final List<ServerPlayer> online = server == null ? List.of() : server.getPlayerList().getPlayers();
+        players = online.size();
+        ratePerSecond = Math.max(0, budget - (double)AdaptiveSettings.minPerPlayer() * players);
+        capacity = ratePerSecond;
+        tokens = Math.min(capacity, tokens + ratePerSecond * elapsed / 20.0);
+    }
+
+    /**
+     * Whether a budget is configured and active.
+     */
+    public static boolean limited() {
+        refresh();
+        return limited;
+    }
+
+    /**
+     * Number of chunks the extra work may start right now. Asking as an explorer reserves part of the budget for the
+     * explorers.
+     */
+    public static int available(final boolean explorer) {
+        refresh();
+        if (!limited) {
+            return Integer.MAX_VALUE;
+        }
+        if (explorer) {
+            explorerAskTick = MinecraftServer.currentTickLong;
+            return (int)Math.floor(tokens);
+        }
+        final boolean explorersWaiting = MinecraftServer.currentTickLong - explorerAskTick <= EXPLORER_INTEREST_TICKS;
+        return (int)Math.max(0.0, Math.floor(tokens - (explorersWaiting ? capacity * EXPLORER_RESERVE : 0.0)));
+    }
+
+    public static void consume(final int chunks) {
+        if (limited && chunks > 0) {
+            tokens = Math.max(0.0, tokens - chunks);
+        }
+    }
+
+    /**
+     * {@link #available} and {@link #consume} for one chunk.
+     */
+    public static boolean tryConsume(final boolean explorer) {
+        if (available(explorer) <= 0) {
+            return false;
+        }
+        consume(1);
+        return true;
+    }
+
+    // status
+
+    public static double extraChunksPerSecond() {
+        refresh();
+        return limited ? ratePerSecond : 0.0;
+    }
+
+    public static double tokensLeft() {
+        refresh();
+        return limited ? tokens : 0.0;
+    }
+
+    public static int onlinePlayers() {
+        refresh();
+        return players;
+    }
+}
