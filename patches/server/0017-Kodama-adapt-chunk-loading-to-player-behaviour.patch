@@ -0,0 +1,70 @@
+package dev.kodama.chunk.adaptive;
+
+import dev.kodama.chunk.ChunkLoadingSettings;
+import dev.kodama.config.KodamaGlobalConfiguration;
+import dev.kodama.feature.FeatureGuard;
+import net.minecraft.server.level.ServerPlayer;
+import org.checkerframework.checker.nullness.qual.Nullable;
+
+/**
+ * Read-only view of {@code chunk-loading.adaptive} with the master switch and the {@link FeatureGuard} state already
+ * applied. Every call reads the live configuration.
+ */
+public final class AdaptiveSettings {
+
+    public static final String FEATURE_ID = "chunk-adaptive";
+
+    private AdaptiveSettings() {
+    }
+
+    private static KodamaGlobalConfiguration.ChunkLoading.@Nullable Adaptive section() {
+        final KodamaGlobalConfiguration config = KodamaGlobalConfiguration.get();
+        return config == null || config.chunkLoading == null ? null : config.chunkLoading.adaptive;
+    }
+
+    public static boolean configuredEnabled() {
+        final KodamaGlobalConfiguration.ChunkLoading.Adaptive section = section();
+        return ChunkLoadingSettings.masterEnabled() && section != null && section.enabled.isTrue();
+    }
+
+    public static boolean enabled() {
+        return configuredEnabled() && !FeatureGuard.isTripped(FEATURE_ID);
+    }
+
+    /**
+     * The type of the player, or {@code null} when the adaptation is off and every caller has to behave as before.
+     */
+    public static PlayerBehaviour.@Nullable Type typeOf(final ServerPlayer player) {
+        return enabled() ? player.kodamaBehaviour().type() : null;
+    }
+
+    public static int typeSwitchTicks() {
+        final KodamaGlobalConfiguration.ChunkLoading.Adaptive section = section();
+        return section == null ? 600 : Math.max(1, section.typeSwitchSeconds) * 20;
+    }
+
+    public static double explorerPrefetchMultiplier() {
+        final KodamaGlobalConfiguration.ChunkLoading.Adaptive section = section();
+        return section == null ? 1.0 : Math.max(0.0, section.explorerPrefetchMultiplier);
+    }
+
+    public static int settlerUnloadDelayTicks() {
+        final KodamaGlobalConfiguration.ChunkLoading.Adaptive section = section();
+        return section == null ? 0 : Math.max(0, section.settlerUnloadDelaySeconds) * 20;
+    }
+
+    public static int routeMemoryChunks() {
+        final KodamaGlobalConfiguration.ChunkLoading.Adaptive section = section();
+        return section == null ? 0 : Math.max(0, section.routeMemoryChunks);
+    }
+
+    public static int budgetChunksPerSecond() {
+        final KodamaGlobalConfiguration.ChunkLoading.Adaptive section = section();
+        return section == null ? 0 : Math.max(0, section.budgetChunksPerSecond.getAsInt());
+    }
+
+    public static int minPerPlayer() {
+        final KodamaGlobalConfiguration.ChunkLoading.Adaptive section = section();
+        return section == null ? 0 : Math.max(0, section.minPerPlayer);
+    }
+}
