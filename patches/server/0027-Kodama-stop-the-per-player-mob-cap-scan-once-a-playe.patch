From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Tonrakun <tonrakun@gmail.com>
Date: Fri, 23 Oct 2026 06:42:29 +0900
Subject: [PATCH] Kodama: stop the per player mob cap scan once a player is at
 the cap


diff --git a/src/main/java/net/minecraft/world/level/NaturalSpawner.java b/src/main/java/net/minecraft/world/level/NaturalSpawner.java
index ed8032495af9ce9c23419224814b8d27e4a97c17..e4df61addd30c12e363c43dc2701dec7133623ac 100644
--- a/src/main/java/net/minecraft/world/level/NaturalSpawner.java
+++ b/src/main/java/net/minecraft/world/level/NaturalSpawner.java
@@ -162,6 +162,7 @@ public final class NaturalSpawner {
                     final Object[] backingSet = inRange.getRawData();
                     for (int k = 0, len = inRange.size(); k < len; k++) {
                         minDiff = Math.min(limit - world.getChunkSource().chunkMap.getMobCountNear((net.minecraft.server.level.ServerPlayer)backingSet[k], enumcreaturetype), minDiff);
+                        if (minDiff <= 0) break; // Kodama - nothing spawns once one nearby player is at the cap
                     }
                 }
                 difference = (minDiff == Integer.MAX_VALUE) ? 0 : minDiff;
