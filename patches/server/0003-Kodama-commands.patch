diff --git a/src/main/java/dev/kodama/config/ConfigEditor.java b/src/main/java/dev/kodama/config/ConfigEditor.java
new file mode 100644
index 0000000000000000000000000000000000000000..70480f66d942888d3fd4d7c25d4c3c0468ba60bd
--- /dev/null
+++ b/src/main/java/dev/kodama/config/ConfigEditor.java
@@ -0,0 +1,290 @@
+package dev.kodama.config;
+
+import com.mojang.logging.LogUtils;
+import java.io.IOException;
+import java.nio.charset.StandardCharsets;
+import java.nio.file.Files;
+import java.nio.file.Path;
+import java.nio.file.StandardOpenOption;
+import java.time.Instant;
+import java.util.ArrayDeque;
+import java.util.Deque;
+import java.util.List;
+import java.util.Locale;
+import java.util.Map;
+import java.util.Objects;
+import java.util.UUID;
+import java.util.concurrent.ConcurrentHashMap;
+import net.kyori.adventure.text.Component;
+import net.kyori.adventure.text.format.NamedTextColor;
+import net.minecraft.server.MinecraftServer;
+import org.bukkit.Bukkit;
+import org.bukkit.command.CommandSender;
+import org.bukkit.command.ConsoleCommandSender;
+import org.bukkit.entity.Player;
+import org.checkerframework.checker.nullness.qual.Nullable;
+import org.slf4j.Logger;
+
+/**
+ * In-game editing of the Kodama config files: parsing of typed values, the per-sender undo stack, the change log and
+ * the notice to a second editor of the same option.
+ */
+public final class ConfigEditor {
+
+    private static final Logger LOGGER = LogUtils.getLogger();
+    public static final int UNDO_DEPTH = 10;
+    private static final long NOTIFY_WINDOW_MILLIS = 10 * 60 * 1000L;
+    private static final Path CHANGE_LOG = Path.of("logs", "kodama-config-changes.log");
+
+    private record Change(ConfigTarget target, ConfigSchema.Option option, @Nullable Object oldRaw, @Nullable Object newRaw, String oldDisplay, String newDisplay) {
+    }
+
+    private record LastEdit(String senderKey, String senderName, long millis) {
+    }
+
+    private static final Map<String, Deque<Change>> UNDO_STACKS = new ConcurrentHashMap<>();
+    private static final Map<String, LastEdit> LAST_EDITS = new ConcurrentHashMap<>();
+
+    /**
+     * What a {@link #set} or {@link #undo} did, for the message to the sender.
+     */
+    public record Result(ConfigTarget target, ConfigSchema.Option option, String oldDisplay, String newDisplay, boolean unchanged) {
+    }
+
+    private ConfigEditor() {
+    }
+
+    /**
+     * The option and file of the sender's most recent change, or {@code null} if there is nothing to undo.
+     */
+    public static ConfigSchema.@Nullable Option peekUndoOption(final CommandSender sender) {
+        final Deque<Change> stack = UNDO_STACKS.get(senderKey(sender));
+        if (stack == null) {
+            return null;
+        }
+        synchronized (stack) {
+            final Change last = stack.peekFirst();
+            return last == null ? null : last.option();
+        }
+    }
+
+    /**
+     * @throws IllegalArgumentException when {@code input} is not a valid value for the option's type
+     * @throws ConfigReloadException    when the resulting config is invalid; nothing was written then
+     */
+    public static Result set(final CommandSender sender, final ConfigTarget target, final ConfigSchema.Option option, final String input) throws ConfigReloadException {
+        final Object raw = parse(option, input);
+        final Change change = apply(sender, target, option, raw, null);
+        if (change == null) {
+            final String shown = display(currentOrNull(target, option));
+            return new Result(target, option, shown, shown, true);
+        }
+        push(sender, change);
+        return new Result(target, option, change.oldDisplay(), change.newDisplay(), false);
+    }
+
+    /**
+     * Reverts the last change of the sender.
+     *
+     * @throws IllegalStateException when the sender has nothing to undo
+     */
+    public static Result undo(final CommandSender sender) throws ConfigReloadException {
+        final Deque<Change> stack = UNDO_STACKS.get(senderKey(sender));
+        final Change last;
+        if (stack == null) {
+            throw new IllegalStateException("There is nothing to undo");
+        }
+        synchronized (stack) {
+            last = stack.peekFirst();
+        }
+        if (last == null) {
+            throw new IllegalStateException("There is nothing to undo");
+        }
+        final Change reverted = apply(sender, last.target(), last.option(), last.oldRaw(), last);
+        synchronized (stack) {
+            stack.remove(last);
+        }
+        if (reverted == null) {
+            final String shown = display(currentOrNull(last.target(), last.option()));
+            return new Result(last.target(), last.option(), shown, shown, true);
+        }
+        return new Result(last.target(), last.option(), reverted.oldDisplay(), reverted.newDisplay(), false);
+    }
+
+    private static @Nullable Change apply(final CommandSender sender, final ConfigTarget target, final ConfigSchema.Option option, final @Nullable Object newRaw, final @Nullable Change undoing) throws ConfigReloadException {
+        final MinecraftServer server = MinecraftServer.getServer();
+        final KodamaConfigurations.EditOutcome outcome = server.kodamaConfigurations.edit(server, target, option, newRaw);
+        if (Objects.equals(outcome.oldRaw(), outcome.newRaw())) {
+            return null;
+        }
+        final Change change = new Change(target, option, outcome.oldRaw(), outcome.newRaw(),
+            displayInFile(target, outcome.oldRaw(), outcome.oldValue()), displayInFile(target, outcome.newRaw(), outcome.newValue()));
+        record(sender, change, undoing != null);
+        return change;
+    }
+
+    private static void push(final CommandSender sender, final Change change) {
+        final Deque<Change> stack = UNDO_STACKS.computeIfAbsent(senderKey(sender), key -> new ArrayDeque<>());
+        synchronized (stack) {
+            stack.addFirst(change);
+            while (stack.size() > UNDO_DEPTH) {
+                stack.removeLast();
+            }
+        }
+    }
+
+    private static @Nullable Object currentOrNull(final ConfigTarget target, final ConfigSchema.Option option) {
+        try {
+            final MinecraftServer server = MinecraftServer.getServer();
+            return server.kodamaConfigurations.currentValue(server, target, option);
+        } catch (final ConfigReloadException exception) {
+            return null;
+        }
+    }
+
+    // change log, INFO log and the notice to the previous editor
+
+    private static void record(final CommandSender sender, final Change change, final boolean undo) {
+        final String senderName = sender.getName();
+        final String file = change.target().fileName();
+        final String path = change.option().path();
+
+        LOGGER.info("Kodama config {} by {}: {} {}: {} -> {}", undo ? "undo" : "change", senderName, file, path, change.oldDisplay(), change.newDisplay());
+        appendToChangeLog(String.join("\t", Instant.now().toString(), clean(senderName), clean(file), clean(path), clean(change.oldDisplay()), clean(change.newDisplay())));
+
+        final String key = file + "|" + path;
+        final String senderKey = senderKey(sender);
+        final long now = System.currentTimeMillis();
+        final LastEdit previous = LAST_EDITS.put(key, new LastEdit(senderKey, senderName, now));
+        if (previous != null && !previous.senderKey().equals(senderKey) && now - previous.millis() <= NOTIFY_WINDOW_MILLIS) {
+            final @Nullable CommandSender other = onlineSender(previous.senderKey());
+            if (other != null) {
+                other.sendMessage(Component.text(senderName + " changed " + path + ": " + change.oldDisplay() + " -> " + change.newDisplay(), NamedTextColor.YELLOW));
+            }
+        }
+    }
+
+    private static synchronized void appendToChangeLog(final String line) {
+        try {
+            if (CHANGE_LOG.getParent() != null) {
+                Files.createDirectories(CHANGE_LOG.getParent());
+            }
+            Files.writeString(CHANGE_LOG, line + System.lineSeparator(), StandardCharsets.UTF_8, StandardOpenOption.CREATE, StandardOpenOption.APPEND);
+        } catch (final IOException exception) {
+            LOGGER.warn("Could not write {}", CHANGE_LOG, exception);
+        }
+    }
+
+    private static String clean(final String value) {
+        return value.replace('\t', ' ').replace('\n', ' ').replace('\r', ' ');
+    }
+
+    private static String senderKey(final CommandSender sender) {
+        return sender instanceof Player player ? "player:" + player.getUniqueId() : "other:" + sender.getName();
+    }
+
+    private static @Nullable CommandSender onlineSender(final String senderKey) {
+        if (senderKey.startsWith("player:")) {
+            return Bukkit.getPlayer(UUID.fromString(senderKey.substring("player:".length())));
+        }
+        final ConsoleCommandSender console = Bukkit.getConsoleSender();
+        return senderKey.equals("other:" + console.getName()) ? console : null;
+    }
+
+    // values
+
+    /**
+     * Converts what the user typed into the raw value that is written to the YAML file. The result is validated as a
+     * whole when the file is loaded.
+     */
+    static Object parse(final ConfigSchema.Option option, final String input) {
+        final Class<?> type = option.valueType();
+        final String text = input.trim();
+        try {
+            if (PresetValue.class.isAssignableFrom(type) && text.equalsIgnoreCase(PresetValue.DEFAULT_VALUE)) {
+                return PresetValue.DEFAULT_VALUE;
+            }
+            if (type == PresetBoolean.class || type == boolean.class || type == Boolean.class) {
+                if (text.equalsIgnoreCase("true")) {
+                    return Boolean.TRUE;
+                }
+                if (text.equalsIgnoreCase("false")) {
+                    return Boolean.FALSE;
+                }
+                throw new IllegalArgumentException("'" + input + "' is not " + (type == PresetBoolean.class ? "true, false or default" : "true or false"));
+            }
+            if (type == PresetInt.class || type == int.class || type == Integer.class) {
+                return Integer.parseInt(text);
+            }
+            if (type == long.class || type == Long.class) {
+                return Long.parseLong(text);
+            }
+            if (type == PresetDouble.class || type == double.class || type == Double.class || type == float.class || type == Float.class) {
+                final double value = Double.parseDouble(text);
+                if (Double.isNaN(value) || Double.isInfinite(value)) {
+                    throw new NumberFormatException();
+                }
+                return value;
+            }
+            if (type.isEnum()) {
+                for (final Object constant : type.getEnumConstants()) {
+                    if (KodamaEnumSerializer.keyOf((Enum<?>) constant).equals(text.toLowerCase(Locale.ROOT).replace('_', '-'))) {
+                        return KodamaEnumSerializer.keyOf((Enum<?>) constant);
+                    }
+                }
+                throw new IllegalArgumentException("'" + input + "' is not one of: " + String.join(", ", valueSuggestions(option)));
+            }
+            if (type == String.class) {
+                return input;
+            }
+        } catch (final NumberFormatException exception) {
+            throw new IllegalArgumentException("'" + input + "' is not a valid " + (PresetInt.class.isAssignableFrom(type) || type == int.class || type == Integer.class || type == long.class || type == Long.class ? "whole number" : "number"));
+        }
+        throw new IllegalArgumentException("Options of type " + type.getSimpleName() + " cannot be set from the command");
+    }
+
+    /**
+     * Values that make sense to suggest for the option, for tab completion.
+     */
+    public static List<String> valueSuggestions(final ConfigSchema.Option option) {
+        final Class<?> type = option.valueType();
+        if (type == PresetBoolean.class) {
+            return List.of("true", "false", PresetValue.DEFAULT_VALUE);
+        }
+        if (type == boolean.class || type == Boolean.class) {
+            return List.of("true", "false");
+        }
+        if (PresetValue.class.isAssignableFrom(type)) {
+            return List.of(PresetValue.DEFAULT_VALUE);
+        }
+        if (type.isEnum()) {
+            final Object[] constants = type.getEnumConstants();
+            final String[] keys = new String[constants.length];
+            for (int i = 0; i < constants.length; i++) {
+                keys[i] = KodamaEnumSerializer.keyOf((Enum<?>) constants[i]);
+            }
+            return List.of(keys);
+        }
+        return List.of();
+    }
+
+    /**
+     * A key that is absent from a world's own file is inherited from the world defaults; say so.
+     */
+    private static String displayInFile(final ConfigTarget target, final @Nullable Object raw, final @Nullable Object value) {
+        return target.scope() == ConfigTarget.Scope.WORLD && raw == null ? "inherited: " + display(value) : display(value);
+    }
+
+    public static String display(final @Nullable Object value) {
+        if (value == null) {
+            return "none";
+        }
+        if (value instanceof PresetValue<?> presetValue) {
+            return presetValue.describe();
+        }
+        if (value instanceof Enum<?> constant) {
+            return KodamaEnumSerializer.keyOf(constant);
+        }
+        return String.valueOf(value);
+    }
+}
