@@ -0,0 +1,57 @@
+package dev.kodama.command.subcommands;
+
+import com.mojang.logging.LogUtils;
+import dev.kodama.command.KodamaCommands;
+import dev.kodama.command.PermissionedKodamaSubcommand;
+import dev.kodama.config.ConfigReloadException;
+import dev.kodama.config.KodamaConfigurations;
+import net.minecraft.server.MinecraftServer;
+import org.bukkit.command.CommandSender;
+import org.bukkit.permissions.PermissionDefault;
+import org.checkerframework.checker.nullness.qual.NonNull;
+import org.checkerframework.framework.qual.DefaultQualifier;
+import org.slf4j.Logger;
+
+import static net.kyori.adventure.text.Component.text;
+import static net.kyori.adventure.text.format.NamedTextColor.GREEN;
+import static net.kyori.adventure.text.format.NamedTextColor.RED;
+import static net.kyori.adventure.text.format.NamedTextColor.YELLOW;
+
+@DefaultQualifier(NonNull.class)
+public final class ReloadCommand extends PermissionedKodamaSubcommand {
+
+    private static final Logger LOGGER = LogUtils.getLogger();
+    public static final String LITERAL_ARGUMENT = "reload";
+    public static final String PERM = KodamaCommands.COMMAND_BASE_PERM + "." + LITERAL_ARGUMENT;
+
+    public ReloadCommand() {
+        super(PERM, PermissionDefault.OP);
+    }
+
+    @Override
+    public boolean execute(final CommandSender sender, final String subCommand, final String[] args) {
+        final MinecraftServer server = MinecraftServer.getServer();
+        // Config objects are swapped on the main thread, between two ticks.
+        if (server.isSameThread()) {
+            this.doReload(server, sender);
+        } else {
+            server.execute(() -> this.doReload(server, sender));
+        }
+        return true;
+    }
+
+    private void doReload(final MinecraftServer server, final CommandSender sender) {
+        try {
+            final KodamaConfigurations.ReloadReport report = server.kodamaConfigurations.reloadAll(server, true);
+            LOGGER.info("Kodama configuration reloaded by {}", sender.getName());
+            sender.sendMessage(text("Kodama configuration reloaded. Features that were disabled after repeated errors are enabled again.", GREEN));
+            for (final String pending : report.pendingRestart()) {
+                sender.sendMessage(text(pending + ": changed, takes effect after restart", YELLOW));
+            }
+        } catch (final ConfigReloadException exception) {
+            LOGGER.error("Kodama configuration reload by {} failed, keeping the previous configuration: {}", sender.getName(), exception.getMessage());
+            sender.sendMessage(text("Reload failed, the previous configuration is still active.", RED));
+            sender.sendMessage(text(exception.getMessage() == null ? "Unknown error" : exception.getMessage(), RED));
+        }
+    }
+}
