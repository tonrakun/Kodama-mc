diff --git a/src/main/java/dev/kodama/command/subcommands/ConfigCommand.java b/src/main/java/dev/kodama/command/subcommands/ConfigCommand.java
new file mode 100644
index 0000000000000000000000000000000000000000..8bc6e11df7317152b7e2efb29fa537bf431c2802
--- /dev/null
+++ b/src/main/java/dev/kodama/command/subcommands/ConfigCommand.java
@@ -0,0 +1,397 @@
+package dev.kodama.command.subcommands;
+
+import dev.kodama.command.Completions;
+import dev.kodama.command.KodamaSubcommand;
+import dev.kodama.config.ConfigEditor;
+import dev.kodama.config.ConfigReloadException;
+import dev.kodama.config.ConfigSchema;
+import dev.kodama.config.ConfigTarget;
+import dev.kodama.config.ReloadClass;
+import java.util.ArrayList;
+import java.util.Arrays;
+import java.util.Collections;
+import java.util.LinkedHashSet;
+import java.util.List;
+import java.util.Locale;
+import java.util.Set;
+import net.kyori.adventure.text.Component;
+import net.minecraft.server.MinecraftServer;
+import org.bukkit.Bukkit;
+import org.bukkit.World;
+import org.bukkit.command.CommandSender;
+import org.bukkit.permissions.Permission;
+import org.bukkit.permissions.PermissionDefault;
+import org.checkerframework.checker.nullness.qual.NonNull;
+import org.checkerframework.checker.nullness.qual.Nullable;
+import org.checkerframework.framework.qual.DefaultQualifier;
+
+import static net.kyori.adventure.text.Component.text;
+import static net.kyori.adventure.text.format.NamedTextColor.GRAY;
+import static net.kyori.adventure.text.format.NamedTextColor.GREEN;
+import static net.kyori.adventure.text.format.NamedTextColor.RED;
+import static net.kyori.adventure.text.format.NamedTextColor.WHITE;
+import static net.kyori.adventure.text.format.NamedTextColor.YELLOW;
+
+/**
+ * {@code /kodama config get|set|undo}. Viewing needs {@code kodama.config.view} or {@code kodama.config.view.<path>},
+ * editing {@code kodama.config.edit} or {@code kodama.config.edit.<path>}.
+ */
+@DefaultQualifier(NonNull.class)
+public final class ConfigCommand implements KodamaSubcommand {
+
+    public static final String LITERAL_ARGUMENT = "config";
+    public static final String VIEW_PERM = "kodama.config.view";
+    public static final String EDIT_PERM = "kodama.config.edit";
+
+    private static final String GET_USAGE = "/kodama config get <path> [world]";
+    private static final String SET_USAGE = "/kodama config set <path> <value> [world]";
+    private static final String UNDO_USAGE = "/kodama config undo";
+
+    private static final List<ConfigSchema.Option> ALL_OPTIONS = allOptions();
+
+    private static List<ConfigSchema.Option> allOptions() {
+        final List<ConfigSchema.Option> all = new ArrayList<>(ConfigSchema.GLOBAL.options());
+        all.addAll(ConfigSchema.WORLD.options());
+        return all;
+    }
+
+    // permissions
+
+    @Override
+    public List<Permission> permissions() {
+        final List<Permission> permissions = new ArrayList<>();
+        permissions.add(new Permission(VIEW_PERM, "Allows reading every Kodama config option", PermissionDefault.OP));
+        permissions.add(new Permission(EDIT_PERM, "Allows changing every Kodama config option", PermissionDefault.OP));
+        for (final ConfigSchema.Option option : ALL_OPTIONS) {
+            permissions.add(new Permission(VIEW_PERM + "." + option.path(), "Allows reading " + option.path(), PermissionDefault.FALSE));
+            permissions.add(new Permission(EDIT_PERM + "." + option.path(), "Allows changing " + option.path(), PermissionDefault.FALSE));
+        }
+        return permissions;
+    }
+
+    private static boolean canView(final CommandSender sender, final ConfigSchema.Option option) {
+        return sender.hasPermission(VIEW_PERM) || sender.hasPermission(VIEW_PERM + "." + option.path());
+    }
+
+    private static boolean canEdit(final CommandSender sender, final ConfigSchema.Option option) {
+        return sender.hasPermission(EDIT_PERM) || sender.hasPermission(EDIT_PERM + "." + option.path());
+    }
+
+    private static boolean canViewAny(final CommandSender sender) {
+        if (sender.hasPermission(VIEW_PERM)) {
+            return true;
+        }
+        for (final ConfigSchema.Option option : ALL_OPTIONS) {
+            if (canView(sender, option)) {
+                return true;
+            }
+        }
+        return false;
+    }
+
+    private static boolean canEditAny(final CommandSender sender) {
+        if (sender.hasPermission(EDIT_PERM)) {
+            return true;
+        }
+        for (final ConfigSchema.Option option : ALL_OPTIONS) {
+            if (canEdit(sender, option)) {
+                return true;
+            }
+        }
+        return false;
+    }
+
+    @Override
+    public boolean testPermission(final CommandSender sender) {
+        return canViewAny(sender) || canEditAny(sender);
+    }
+
+    // execution
+
+    @Override
+    public boolean execute(final CommandSender sender, final String subCommand, final String[] args) {
+        if (args.length == 0) {
+            sendUsage(sender);
+            return false;
+        }
+        final String[] rest = Arrays.copyOfRange(args, 1, args.length);
+        switch (args[0].toLowerCase(Locale.ROOT)) {
+            case "get" -> {
+                return this.get(sender, rest);
+            }
+            case "set" -> {
+                return this.set(sender, rest);
+            }
+            case "undo" -> {
+                return this.undo(sender, rest);
+            }
+            default -> {
+                sendUsage(sender);
+                return false;
+            }
+        }
+    }
+
+    private static void sendUsage(final CommandSender sender) {
+        sender.sendMessage(text("Usage:", RED));
+        if (canViewAny(sender)) {
+            sender.sendMessage(text("  " + GET_USAGE, RED));
+        }
+        if (canEditAny(sender)) {
+            sender.sendMessage(text("  " + SET_USAGE, RED));
+            sender.sendMessage(text("  " + UNDO_USAGE, RED));
+        }
+    }
+
+    private static void noPermission(final CommandSender sender) {
+        sender.sendMessage(Bukkit.permissionMessage());
+    }
+
+    private static void error(final CommandSender sender, final String message) {
+        sender.sendMessage(text(message, RED));
+    }
+
+    private boolean get(final CommandSender sender, final String[] args) {
+        if (!canViewAny(sender)) {
+            noPermission(sender);
+            return true;
+        }
+        if (args.length < 1 || args.length > 2) {
+            error(sender, "Usage: " + GET_USAGE);
+            return false;
+        }
+        final String path = args[0].toLowerCase(Locale.ROOT);
+        final List<ConfigSchema.Option> globalMatches = ConfigSchema.GLOBAL.under(path);
+        final List<ConfigSchema.Option> worldMatches = ConfigSchema.WORLD.under(path);
+        if (globalMatches.isEmpty() && worldMatches.isEmpty()) {
+            error(sender, "Unknown config option '" + args[0] + "'. Use tab completion to list the options.");
+            return false;
+        }
+        final @Nullable ConfigTarget target = this.resolveTarget(sender, !globalMatches.isEmpty(), path, args.length == 2 ? args[1] : null);
+        if (target == null) {
+            return false;
+        }
+        final List<ConfigSchema.Option> visible = new ArrayList<>();
+        for (final ConfigSchema.Option option : globalMatches.isEmpty() ? worldMatches : globalMatches) {
+            if (canView(sender, option)) {
+                visible.add(option);
+            }
+        }
+        if (visible.isEmpty()) {
+            noPermission(sender);
+            return true;
+        }
+
+        final MinecraftServer server = MinecraftServer.getServer();
+        final String where = switch (target.scope()) {
+            case GLOBAL -> "global";
+            case WORLD_DEFAULTS -> "world defaults";
+            case WORLD -> "world " + target.worldName();
+        };
+        for (final ConfigSchema.Option option : visible) {
+            try {
+                final String value = ConfigEditor.display(server.kodamaConfigurations.currentValue(server, target, option));
+                sender.sendMessage(text(option.path(), YELLOW).append(text(" = ", GRAY)).append(text(value, WHITE))
+                    .append(text("  [" + where + ", " + option.reloadClass().label() + "]", GRAY)));
+                if (visible.size() == 1 && option.comment() != null) {
+                    sender.sendMessage(text(option.comment(), GRAY));
+                }
+            } catch (final ConfigReloadException exception) {
+                error(sender, exception.getMessage() == null ? "Could not read " + option.path() : exception.getMessage());
+                return false;
+            }
+        }
+        return true;
+    }
+
+    private boolean set(final CommandSender sender, final String[] args) {
+        if (!canEditAny(sender)) {
+            noPermission(sender);
+            return true;
+        }
+        if (args.length < 2 || args.length > 3) {
+            error(sender, "Usage: " + SET_USAGE);
+            return false;
+        }
+        final String path = args[0].toLowerCase(Locale.ROOT);
+        final ConfigSchema.@Nullable Option globalOption = ConfigSchema.GLOBAL.find(path);
+        final ConfigSchema.@Nullable Option option = globalOption != null ? globalOption : ConfigSchema.WORLD.find(path);
+        if (option == null) {
+            error(sender, !ConfigSchema.GLOBAL.under(path).isEmpty() || !ConfigSchema.WORLD.under(path).isEmpty()
+                ? "'" + args[0] + "' is a section; set one of its options instead."
+                : "Unknown config option '" + args[0] + "'. Use tab completion to list the options.");
+            return false;
+        }
+        if (!canEdit(sender, option)) {
+            noPermission(sender);
+            return true;
+        }
+        final @Nullable ConfigTarget target = this.resolveTarget(sender, globalOption != null, path, args.length == 3 ? args[2] : null);
+        if (target == null) {
+            return false;
+        }
+
+        final ConfigEditor.Result result;
+        try {
+            result = ConfigEditor.set(sender, target, option, args[1]);
+        } catch (final IllegalArgumentException exception) {
+            error(sender, "Not changed: " + exception.getMessage());
+            return false;
+        } catch (final ConfigReloadException exception) {
+            error(sender, "Not changed, the value is not valid: " + exception.getMessage());
+            return false;
+        }
+        this.reportChange(sender, result, "Set ");
+        return true;
+    }
+
+    private boolean undo(final CommandSender sender, final String[] args) {
+        if (!canEditAny(sender)) {
+            noPermission(sender);
+            return true;
+        }
+        if (args.length != 0) {
+            error(sender, "Usage: " + UNDO_USAGE);
+            return false;
+        }
+        final ConfigSchema.@Nullable Option last = ConfigEditor.peekUndoOption(sender);
+        if (last == null) {
+            error(sender, "There is nothing to undo.");
+            return false;
+        }
+        if (!canEdit(sender, last)) {
+            noPermission(sender);
+            return true;
+        }
+        final ConfigEditor.Result result;
+        try {
+            result = ConfigEditor.undo(sender);
+        } catch (final IllegalStateException exception) {
+            error(sender, exception.getMessage());
+            return false;
+        } catch (final ConfigReloadException exception) {
+            error(sender, "Not reverted: " + exception.getMessage());
+            return false;
+        }
+        this.reportChange(sender, result, "Reverted ");
+        return true;
+    }
+
+    private void reportChange(final CommandSender sender, final ConfigEditor.Result result, final String verb) {
+        final String path = result.option().path();
+        if (result.unchanged()) {
+            sender.sendMessage(text(path + " is already " + result.newDisplay() + ".", YELLOW));
+            return;
+        }
+        sender.sendMessage(text(verb + path + " in " + result.target().fileName() + ": ", GREEN)
+            .append(text(result.oldDisplay(), WHITE)).append(text(" -> ", GRAY)).append(text(result.newDisplay(), WHITE)));
+        sender.sendMessage(text("Reload timing: " + result.option().reloadClass().label(), GRAY));
+        if (result.option().reloadClass() == ReloadClass.RESTART_REQUIRED) {
+            sender.sendMessage(text(path + ": changed, takes effect after restart", YELLOW));
+        } else if (result.option().reloadClass() == ReloadClass.STAGED) {
+            sender.sendMessage(text(path + ": applied gradually over the next ticks", YELLOW));
+        }
+    }
+
+    /**
+     * Picks the file an option lives in. Reports an error and returns {@code null} when the world argument does not
+     * fit the option.
+     */
+    private @Nullable ConfigTarget resolveTarget(final CommandSender sender, final boolean globalOption, final String path, final @Nullable String worldArgument) {
+        if (globalOption) {
+            if (worldArgument != null) {
+                error(sender, "'" + path + "' is a global option and has no per-world value.");
+                return null;
+            }
+            return ConfigTarget.GLOBAL;
+        }
+        if (worldArgument == null) {
+            return ConfigTarget.WORLD_DEFAULTS;
+        }
+        final @Nullable World world = Bukkit.getWorld(worldArgument);
+        if (world == null) {
+            error(sender, "Unknown world '" + worldArgument + "'.");
+            return null;
+        }
+        return ConfigTarget.world(world.getName());
+    }
+
+    // tab completion
+
+    @Override
+    public List<String> tabComplete(final CommandSender sender, final String subCommand, final String[] args) {
+        if (args.length <= 1) {
+            final List<String> subs = new ArrayList<>();
+            if (canViewAny(sender)) {
+                subs.add("get");
+            }
+            if (canEditAny(sender)) {
+                subs.add("set");
+                subs.add("undo");
+            }
+            return Completions.matchingLast(args, subs);
+        }
+        final String sub = args[0].toLowerCase(Locale.ROOT);
+        if (sub.equals("get") && canViewAny(sender)) {
+            if (args.length == 2) {
+                return Completions.matchingLast(args, this.pathCandidates(sender, true));
+            }
+            if (args.length == 3) {
+                return this.worldCandidates(args, args[1]);
+            }
+        } else if (sub.equals("set") && canEditAny(sender)) {
+            if (args.length == 2) {
+                return Completions.matchingLast(args, this.pathCandidates(sender, false));
+            }
+            final ConfigSchema.@Nullable Option option = this.findOption(args[1]);
+            if (option == null) {
+                return Collections.emptyList();
+            }
+            if (args.length == 3) {
+                return Completions.matchingLast(args, ConfigEditor.valueSuggestions(option));
+            }
+            if (args.length == 4) {
+                return this.worldCandidates(args, args[1]);
+            }
+        }
+        return Collections.emptyList();
+    }
+
+    private ConfigSchema.@Nullable Option findOption(final String path) {
+        final String lower = path.toLowerCase(Locale.ROOT);
+        final ConfigSchema.@Nullable Option option = ConfigSchema.GLOBAL.find(lower);
+        return option != null ? option : ConfigSchema.WORLD.find(lower);
+    }
+
+    private List<String> worldCandidates(final String[] args, final String path) {
+        if (ConfigSchema.WORLD.under(path.toLowerCase(Locale.ROOT)).isEmpty()) {
+            return Collections.emptyList();
+        }
+        final List<String> worlds = new ArrayList<>();
+        for (final World world : Bukkit.getWorlds()) {
+            worlds.add(world.getName());
+        }
+        return Completions.matchingLast(args, worlds);
+    }
+
+    /**
+     * Option paths the sender may use; with {@code includeSections} also the section prefixes, for {@code get}.
+     */
+    private Set<String> pathCandidates(final CommandSender sender, final boolean includeSections) {
+        final Set<String> candidates = new LinkedHashSet<>();
+        for (final ConfigSchema.Option option : ALL_OPTIONS) {
+            if (!(includeSections ? canView(sender, option) : canEdit(sender, option))) {
+                continue;
+            }
+            if (includeSections) {
+                int dot = option.path().indexOf('.');
+                while (dot >= 0) {
+                    candidates.add(option.path().substring(0, dot));
+                    dot = option.path().indexOf('.', dot + 1);
+                }
+            }
+            candidates.add(option.path());
+        }
+        return candidates;
+    }
+}
