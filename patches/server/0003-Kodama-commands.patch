+package dev.kodama.command;
+
+import java.util.List;
+import org.bukkit.command.CommandSender;
+import org.bukkit.permissions.Permission;
+import org.bukkit.permissions.PermissionDefault;
+
+public abstract class PermissionedKodamaSubcommand implements KodamaSubcommand {
+
+    public final Permission permission;
+
+    protected PermissionedKodamaSubcommand(final String permission, final PermissionDefault permissionDefault) {
+        this.permission = new Permission(permission, permissionDefault);
+    }
+
+    @Override
+    public boolean testPermission(final CommandSender sender) {
+        return sender.hasPermission(this.permission);
+    }
+
+    @Override
+    public List<Permission> permissions() {
+        return List.of(this.permission);
+    }
+}
