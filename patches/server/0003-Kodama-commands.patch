Subject: [PATCH] Kodama commands

License: GPL-3.0 (https://www.gnu.org/licenses/gpl-3.0.html)

Based on "Gale commands" from Gale (https://github.com/Dreeam-qwq/Gale), GPL-3.0,
itself based on "Paper command" from Paper (MIT).

Adds /kodama with the reload, version, status and config (get, set, undo)
subcommands, tab completion, per-option view/edit permissions, the
kodama permissions root and the config change log.

diff --git a/src/main/java/dev/kodama/command/Completions.java b/src/main/java/dev/kodama/command/Completions.java
new file mode 100644
index 0000000000000000000000000000000000000000..e6530d512bc7f7828deb5ff68184558a17ee86fb
--- /dev/null
+++ b/src/main/java/dev/kodama/command/Completions.java
@@ -0,0 +1,25 @@
+package dev.kodama.command;
+
+import java.util.ArrayList;
+import java.util.Collection;
+import java.util.List;
+
+public final class Completions {
+
+    private Completions() {
+    }
+
+    /**
+     * Case-insensitive prefix match against the argument being typed (the last one).
+     */
+    public static List<String> matchingLast(final String[] args, final Collection<String> candidates) {
+        final String last = args.length == 0 ? "" : args[args.length - 1];
+        final List<String> result = new ArrayList<>();
+        for (final String candidate : candidates) {
+            if (candidate.regionMatches(true, 0, last, 0, last.length())) {
+                result.add(candidate);
+            }
+        }
+        return result;
+    }
+}
diff --git a/src/main/java/dev/kodama/command/KodamaCommand.java b/src/main/java/dev/kodama/command/KodamaCommand.java
new file mode 100644
index 0000000000000000000000000000000000000000..a4459e22b4abbc654ac56b35647e6441f0b03f6a
--- /dev/null
+++ b/src/main/java/dev/kodama/command/KodamaCommand.java
@@ -0,0 +1,112 @@
+package dev.kodama.command;
+
+import dev.kodama.command.subcommands.ConfigCommand;
+import dev.kodama.command.subcommands.ReloadCommand;
+import dev.kodama.command.subcommands.StatusCommand;
+import dev.kodama.command.subcommands.VersionCommand;
+import java.util.ArrayList;
+import java.util.Arrays;
+import java.util.Collections;
+import java.util.LinkedHashMap;
+import java.util.List;
+import java.util.Locale;
+import java.util.Map;
+import net.kyori.adventure.text.Component;
+import org.bukkit.Bukkit;
+import org.bukkit.Location;
+import org.bukkit.command.Command;
+import org.bukkit.command.CommandSender;
+import org.bukkit.permissions.Permission;
+import org.bukkit.permissions.PermissionDefault;
+import org.bukkit.plugin.PluginManager;
+import org.checkerframework.checker.nullness.qual.NonNull;
+import org.checkerframework.checker.nullness.qual.Nullable;
+import org.checkerframework.framework.qual.DefaultQualifier;
+
+import static net.kyori.adventure.text.Component.text;
+import static net.kyori.adventure.text.format.NamedTextColor.GRAY;
+import static net.kyori.adventure.text.format.NamedTextColor.RED;
+
+@DefaultQualifier(NonNull.class)
+public final class KodamaCommand extends Command {
+    public static final String COMMAND_LABEL = "kodama";
+    public static final String BASE_PERM = KodamaCommands.COMMAND_BASE_PERM + "." + COMMAND_LABEL;
+    private static final Permission BASE_PERMISSION = new Permission(BASE_PERM, "Allows using /kodama", PermissionDefault.TRUE);
+
+    // subcommand label -> subcommand, in the order they are listed in the usage message
+    private static final Map<String, KodamaSubcommand> SUBCOMMANDS = new LinkedHashMap<>();
+    static {
+        SUBCOMMANDS.put(ReloadCommand.LITERAL_ARGUMENT, new ReloadCommand());
+        SUBCOMMANDS.put(StatusCommand.LITERAL_ARGUMENT, new StatusCommand());
+        SUBCOMMANDS.put(VersionCommand.LITERAL_ARGUMENT, new VersionCommand());
+        SUBCOMMANDS.put(ConfigCommand.LITERAL_ARGUMENT, new ConfigCommand());
+    }
+
+    public KodamaCommand() {
+        super(COMMAND_LABEL);
+        this.description = "Kodama related commands";
+        this.usageMessage = createUsageMessage(SUBCOMMANDS.keySet());
+        this.setPermission(BASE_PERM);
+        final PluginManager pluginManager = Bukkit.getServer().getPluginManager();
+        pluginManager.addPermission(BASE_PERMISSION);
+        for (final KodamaSubcommand subcommand : SUBCOMMANDS.values()) {
+            for (final Permission permission : subcommand.permissions()) {
+                pluginManager.addPermission(permission);
+            }
+        }
+    }
+
+    private static String createUsageMessage(final Iterable<String> arguments) {
+        return "/" + COMMAND_LABEL + " [" + String.join(" | ", arguments) + "]";
+    }
+
+    private static List<String> usableSubcommands(final CommandSender sender) {
+        final List<String> usable = new ArrayList<>(SUBCOMMANDS.size());
+        for (final Map.Entry<String, KodamaSubcommand> entry : SUBCOMMANDS.entrySet()) {
+            if (entry.getValue().testPermission(sender)) {
+                usable.add(entry.getKey());
+            }
+        }
+        return usable;
+    }
+
+    @Override
+    public List<String> tabComplete(final CommandSender sender, final String alias, final String[] args, final @Nullable Location location) throws IllegalArgumentException {
+        if (!sender.hasPermission(BASE_PERMISSION)) {
+            return Collections.emptyList();
+        }
+        if (args.length <= 1) {
+            return Completions.matchingLast(args, usableSubcommands(sender));
+        }
+        final @Nullable KodamaSubcommand subcommand = SUBCOMMANDS.get(args[0].toLowerCase(Locale.ENGLISH));
+        if (subcommand != null && subcommand.testPermission(sender)) {
+            return subcommand.tabComplete(sender, args[0].toLowerCase(Locale.ENGLISH), Arrays.copyOfRange(args, 1, args.length));
+        }
+        return Collections.emptyList();
+    }
+
+    @Override
+    public boolean execute(final CommandSender sender, final String commandLabel, final String[] args) {
+        if (!sender.hasPermission(BASE_PERMISSION)) {
+            sender.sendMessage(Bukkit.permissionMessage());
+            return true;
+        }
+
+        final List<String> usable = usableSubcommands(sender);
+        final String usage = createUsageMessage(usable);
+
+        if (args.length == 0) {
+            sender.sendMessage(text("Kodama is a performance-focused Paper fork.", GRAY));
+            sender.sendMessage(text(usable.isEmpty() ? "You do not have permission for any /kodama subcommand." : "Command usage: " + usage, GRAY));
+            return true;
+        }
+
+        final String label = args[0].toLowerCase(Locale.ENGLISH);
+        final @Nullable KodamaSubcommand subcommand = SUBCOMMANDS.get(label);
+        if (subcommand == null || !subcommand.testPermission(sender)) {
+            sender.sendMessage(Component.text("Usage: " + usage, RED));
+            return false;
+        }
+        return subcommand.execute(sender, label, Arrays.copyOfRange(args, 1, args.length));
+    }
+}
