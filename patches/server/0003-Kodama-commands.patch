@@ -0,0 +1,29 @@
+package dev.kodama.command;
+
+import java.util.HashMap;
+import java.util.Map;
+import net.minecraft.server.MinecraftServer;
+import org.bukkit.command.Command;
+import org.bukkit.craftbukkit.util.permissions.CraftDefaultPermissions;
+import org.checkerframework.checker.nullness.qual.NonNull;
+import org.checkerframework.framework.qual.DefaultQualifier;
+
+@DefaultQualifier(NonNull.class)
+public final class KodamaCommands {
+
+    public static final String COMMAND_BASE_PERM = CraftDefaultPermissions.KODAMA_ROOT + ".command";
+
+    private KodamaCommands() {
+    }
+
+    private static final Map<String, Command> COMMANDS = new HashMap<>();
+    static {
+        COMMANDS.put(KodamaCommand.COMMAND_LABEL, new KodamaCommand());
+    }
+
+    public static void registerCommands(final MinecraftServer server) {
+        COMMANDS.forEach((s, command) -> {
+            server.server.getCommandMap().register(s, "Kodama", command);
+        });
+    }
+}
