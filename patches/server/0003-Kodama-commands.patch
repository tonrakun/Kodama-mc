@@ -0,0 +1,121 @@
+package dev.kodama.command.subcommands;
+
+import dev.kodama.command.KodamaCommands;
+import dev.kodama.command.PermissionedKodamaSubcommand;
+import dev.kodama.command.StatusContributor;
+import dev.kodama.config.ConfigSchema;
+import dev.kodama.config.KodamaGlobalConfiguration;
+import dev.kodama.config.PresetBoolean;
+import dev.kodama.feature.FeatureGuard;
+import java.util.List;
+import java.util.Set;
+import java.util.concurrent.CopyOnWriteArrayList;
+import net.kyori.adventure.text.Component;
+import net.minecraft.server.MinecraftServer;
+import net.minecraft.server.level.ServerLevel;
+import org.bukkit.command.CommandSender;
+import org.bukkit.permissions.PermissionDefault;
+import org.checkerframework.checker.nullness.qual.NonNull;
+import org.checkerframework.framework.qual.DefaultQualifier;
+
+import static net.kyori.adventure.text.Component.text;
+import static net.kyori.adventure.text.format.NamedTextColor.GRAY;
+import static net.kyori.adventure.text.format.NamedTextColor.GREEN;
+import static net.kyori.adventure.text.format.NamedTextColor.RED;
+import static net.kyori.adventure.text.format.NamedTextColor.WHITE;
+import static net.kyori.adventure.text.format.NamedTextColor.YELLOW;
+
+@DefaultQualifier(NonNull.class)
+public final class StatusCommand extends PermissionedKodamaSubcommand {
+
+    public static final String LITERAL_ARGUMENT = "status";
+    public static final String PERM = KodamaCommands.COMMAND_BASE_PERM + "." + LITERAL_ARGUMENT;
+
+    private static final List<StatusContributor> CONTRIBUTORS = new CopyOnWriteArrayList<>();
+    static {
+        // Placeholders until the features that fill them exist.
+        for (final String label : List.of("Mob tiers", "Player types", "Precache progress")) {
+            CONTRIBUTORS.add(new StatusContributor() {
+                @Override
+                public String label() {
+                    return label;
+                }
+
+                @Override
+                public Component describe() {
+                    return text("n/a", GRAY);
+                }
+            });
+        }
+    }
+
+    public StatusCommand() {
+        super(PERM, PermissionDefault.OP);
+    }
+
+    /**
+     * Adds a status line, or replaces the line with the same label (keeping its position).
+     */
+    public static void register(final StatusContributor contributor) {
+        for (int i = 0; i < CONTRIBUTORS.size(); i++) {
+            if (CONTRIBUTORS.get(i).label().equalsIgnoreCase(contributor.label())) {
+                CONTRIBUTORS.set(i, contributor);
+                return;
+            }
+        }
+        CONTRIBUTORS.add(contributor);
+    }
+
+    @Override
+    public boolean execute(final CommandSender sender, final String subCommand, final String[] args) {
+        final MinecraftServer server = MinecraftServer.getServer();
+        final KodamaGlobalConfiguration global = KodamaGlobalConfiguration.get();
+
+        sender.sendMessage(text("Kodama status", GREEN));
+        sender.sendMessage(text("Preset: ", GRAY).append(text(global.preset.key(), WHITE)));
+
+        sender.sendMessage(text("Global features:", GRAY));
+        for (final ConfigSchema.Option option : ConfigSchema.GLOBAL.options()) {
+            if (option.valueType() == PresetBoolean.class && option.path().endsWith(".enabled")) {
+                sender.sendMessage(featureLine(option.path().substring(0, option.path().length() - ".enabled".length()), (PresetBoolean) option.read(global)));
+            }
+        }
+
+        sender.sendMessage(text("World features:", GRAY));
+        for (final ServerLevel level : server.getAllLevels()) {
+            Component line = text("  " + level.getWorld().getName() + ": ", WHITE);
+            boolean first = true;
+            for (final ConfigSchema.Option option : ConfigSchema.WORLD.options()) {
+                if (option.valueType() == PresetBoolean.class && option.path().endsWith(".enabled")) {
+                    final PresetBoolean value = (PresetBoolean) option.read(level.kodamaConfig());
+                    line = line.append(text((first ? "" : ", ") + option.path().substring(0, option.path().length() - ".enabled".length()) + " ", GRAY))
+                        .append(onOff(value.get()));
+                    first = false;
+                }
+            }
+            sender.sendMessage(line);
+        }
+
+        final Set<String> tripped = FeatureGuard.trippedFeatures();
+        if (tripped.isEmpty()) {
+            sender.sendMessage(text("Tripped features: ", GRAY).append(text("none", GREEN)));
+        } else {
+            sender.sendMessage(text("Tripped features: ", GRAY).append(text(String.join(", ", tripped), RED))
+                .append(text(" (disabled after repeated errors, /kodama reload enables them again)", YELLOW)));
+        }
+
+        for (final StatusContributor contributor : CONTRIBUTORS) {
+            sender.sendMessage(text(contributor.label() + ": ", GRAY).append(contributor.describe()));
+        }
+        return true;
+    }
+
+    private static Component featureLine(final String feature, final PresetBoolean value) {
+        final Component line = text("  " + feature + ": ", WHITE).append(onOff(value.get()));
+        return value.isDefault() ? line.append(text(" (from preset)", GRAY)) : line.append(text(" (set explicitly)", GRAY));
+    }
+
+    private static Component onOff(final boolean enabled) {
+        return enabled ? text("on", GREEN) : text("off", RED);
+    }
+}
