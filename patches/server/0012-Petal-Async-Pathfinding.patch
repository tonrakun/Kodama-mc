diff --git a/src/main/java/dev/kodama/async/AsyncSettings.java b/src/main/java/dev/kodama/async/AsyncSettings.java
new file mode 100644
index 0000000000000000000000000000000000000000..86c77ec22b176fd7aecc1ebcf690b8b2908ec11e
--- /dev/null
+++ b/src/main/java/dev/kodama/async/AsyncSettings.java
@@ -0,0 +1,74 @@
+package dev.kodama.async;
+
+import dev.kodama.config.KodamaGlobalConfiguration;
+import dev.kodama.feature.FeatureGuard;
+import org.checkerframework.checker.nullness.qual.Nullable;
+
+/**
+ * Read-only view of the {@code async} section with the {@link FeatureGuard} state already applied.
+ */
+public final class AsyncSettings {
+
+    public static final String PATHFINDING = "async-pathfinding";
+
+    private static final ThreadLocal<Boolean> FORCE_SYNC_PATHFINDING = new ThreadLocal<>();
+
+    private AsyncSettings() {
+    }
+
+    private static KodamaGlobalConfiguration.@Nullable Async section() {
+        final KodamaGlobalConfiguration config = KodamaGlobalConfiguration.get();
+        return config == null ? null : config.async;
+    }
+
+    /**
+     * Whether new paths are calculated on the pathfinding threads. Callers read this once per operation. It is false on
+     * a thread inside {@link #forceSyncPathfinding()}; paths that already are being calculated stay valid either way.
+     */
+    public static boolean asyncPathfinding() {
+        final KodamaGlobalConfiguration.Async section = section();
+        return section != null && section.pathfinding.enabled.isTrue() && FORCE_SYNC_PATHFINDING.get() == null
+            && !FeatureGuard.isTripped(PATHFINDING);
+    }
+
+    /**
+     * Makes every path requested on the current thread complete before it is returned, for the Paper Pathfinder API.
+     * Use in a try-with-resources block.
+     */
+    public static SyncPathfindingScope forceSyncPathfinding() {
+        final Boolean previous = FORCE_SYNC_PATHFINDING.get();
+        FORCE_SYNC_PATHFINDING.set(Boolean.TRUE);
+        return () -> {
+            if (previous == null) {
+                FORCE_SYNC_PATHFINDING.remove();
+            }
+        };
+    }
+
+    @FunctionalInterface
+    public interface SyncPathfindingScope extends AutoCloseable {
+        @Override
+        void close();
+    }
+
+    /**
+     * Read once when the pathfinding executor is created.
+     */
+    public static int pathfindingMaxThreads() {
+        final KodamaGlobalConfiguration.Async section = section();
+        final int configured = section == null ? 0 : section.pathfinding.maxThreads;
+        final int cores = Runtime.getRuntime().availableProcessors();
+        if (configured < 0) {
+            return Math.max(cores + configured, 1);
+        }
+        return configured == 0 ? Math.max(cores / 4, 1) : configured;
+    }
+
+    /**
+     * Read once when the pathfinding executor is created.
+     */
+    public static int pathfindingKeepaliveSeconds() {
+        final KodamaGlobalConfiguration.Async section = section();
+        return section == null ? 60 : Math.max(section.pathfinding.keepalive, 1);
+    }
+}
