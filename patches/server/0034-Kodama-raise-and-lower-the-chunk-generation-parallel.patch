     }
 
     protected static final class PrioritisedPoolExecutorImpl extends PrioritisedThreadedTaskQueue implements PrioritisedPoolExecutor {
@@ -331,7 +339,7 @@ public final class PrioritisedThreadPool {
         protected Priority scheduledPriority;
 
         protected final String name;
-        protected final int maximumExecutors;
+        protected int maximumExecutors; // Kodama - dynamic generation parallelism - not final, guarded by the pool's queues
         protected boolean isQueued;
 
         public PrioritisedPoolExecutorImpl(final PrioritisedThreadPool pool, final String name, final int maximumExecutors) {
@@ -365,6 +373,37 @@ public final class PrioritisedThreadPool {
 
         private boolean isHalted;
 
+        // Kodama start - dynamic generation parallelism
+        @Override
+        public void kodamaSetParallelism(final int parallelism) {
+            final PrioritisedThreadPool pool = this.pool;
+            final TreeSet<PrioritisedPoolExecutorImpl> queues = pool.queues;
+            final int executorsWanted;
+            synchronized (queues) {
+                final int clamped = Math.min(Math.max(1, parallelism), pool.threads.length);
+                if (clamped == this.maximumExecutors) {
+                    return;
+                }
+                this.maximumExecutors = clamped;
+                // a queue at its old limit was left out of the set, so idle threads would never pick it up
+                if (!this.isQueued && !this.isHalted && this.scheduledPriority != null && this.concurrentExecutors < clamped) {
+                    queues.add(this);
+                    this.isQueued = true;
+                }
+                executorsWanted = this.isQueued ? Math.min(clamped - this.concurrentExecutors, (int)this.totalQueuedTasks) : 0;
+            }
+            int notified = 0;
+            for (final PrioritisedThread thread : pool.threads) {
+                if (notified >= executorsWanted) {
+                    break;
+                }
+                if (thread.notifyTasks()) {
+                    ++notified;
+                }
+            }
+        }
+        // Kodama end - dynamic generation parallelism
+
         @Override
         public void halt() {
             final PrioritisedThreadPool pool = this.pool;
