diff --git a/src/main/java/dev/kodama/network/ConnectionBacklog.java b/src/main/java/dev/kodama/network/ConnectionBacklog.java
new file mode 100644
index 0000000000000000000000000000000000000000..c5e39dcd07f6675e0f56652d2d9cbee654efac28
--- /dev/null
+++ b/src/main/java/dev/kodama/network/ConnectionBacklog.java
@@ -0,0 +1,94 @@
+package dev.kodama.network;
+
+import dev.kodama.feature.FeatureGuard;
+import io.netty.channel.Channel;
+import io.netty.channel.ChannelOutboundBuffer;
+import java.util.concurrent.atomic.LongAdder;
+import net.minecraft.network.CompressionEncoder;
+import net.minecraft.network.Connection;
+import net.minecraft.server.MinecraftServer;
+import net.minecraft.server.level.ServerPlayer;
+import net.minecraft.server.network.ServerGamePacketListenerImpl;
+
+/**
+ * Reacts to connections that cannot keep up: chunk packets are held back and packets are compressed harder.
+ * <p>
+ * The backlog is the size of the encoded packets in the Netty outbound buffer, which only grows when the socket does
+ * not drain (packets that are not encoded yet count as zero). Both reads are safe off the event loop.
+ */
+public final class ConnectionBacklog {
+
+    private static final int COMPRESSION_CHECK_INTERVAL = 20;
+
+    private static final LongAdder HELD_SENDS = new LongAdder();
+
+    private ConnectionBacklog() {
+    }
+
+    public static long pendingBytes(final Connection connection) {
+        final Channel channel = connection.channel;
+        if (channel == null) {
+            return 0L;
+        }
+        final ChannelOutboundBuffer buffer = channel.unsafe().outboundBuffer();
+        return buffer == null ? 0L : buffer.totalPendingWriteBytes();
+    }
+
+    /**
+     * Whether no new chunk should be sent to the player this tick. Main thread.
+     */
+    public static boolean holdChunkSends(final ServerPlayer player) {
+        if (!NetworkSettings.chunkBacklogEnabled() || player.connection == null) {
+            return false;
+        }
+        try {
+            if (pendingBytes(player.connection.connection) < NetworkSettings.chunkBacklogBytes()) {
+                return false;
+            }
+            HELD_SENDS.increment();
+            return true;
+        } catch (final VirtualMachineError error) {
+            throw error;
+        } catch (final Throwable throwable) {
+            FeatureGuard.reportFailure(NetworkSettings.CHUNK_BACKLOG_ID, throwable);
+            return false;
+        }
+    }
+
+    /**
+     * Picks the compression level of the player's connection once a second. Main thread.
+     */
+    public static void tickCompression(final ServerGamePacketListenerImpl listener, final int tickCount) {
+        if (tickCount % COMPRESSION_CHECK_INTERVAL != 0) {
+            return;
+        }
+        try {
+            final Connection connection = listener.connection;
+            if (connection.channel == null || !(connection.channel.pipeline().get("compress") instanceof CompressionEncoder encoder)) {
+                return;
+            }
+            if (!NetworkSettings.adaptiveCompressionEnabled()) {
+                if (encoder.kodamaLevel() != CompressionEncoder.KODAMA_BASE_LEVEL) {
+                    encoder.kodamaSetLevel(CompressionEncoder.KODAMA_BASE_LEVEL);
+                }
+                return;
+            }
+            final long now = MinecraftServer.currentTickLong;
+            if (pendingBytes(connection) >= NetworkSettings.congestedBytes()) {
+                connection.kodamaLastCongestedTick = now;
+                encoder.kodamaSetLevel(NetworkSettings.congestedLevel());
+            } else if (encoder.kodamaLevel() != CompressionEncoder.KODAMA_BASE_LEVEL
+                && now - connection.kodamaLastCongestedTick >= NetworkSettings.relaxTicks()) {
+                encoder.kodamaSetLevel(CompressionEncoder.KODAMA_BASE_LEVEL);
+            }
+        } catch (final VirtualMachineError error) {
+            throw error;
+        } catch (final Throwable throwable) {
+            FeatureGuard.reportFailure(NetworkSettings.ADAPTIVE_COMPRESSION_ID, throwable);
+        }
+    }
+
+    static long heldSends() {
+        return HELD_SENDS.sum();
+    }
+}
diff --git a/src/main/java/dev/kodama/network/NetworkSettings.java b/src/main/java/dev/kodama/network/NetworkSettings.java
new file mode 100644
index 0000000000000000000000000000000000000000..e6b9ee51e0c4f85b747ede793c1e2d964c872507
--- /dev/null
+++ b/src/main/java/dev/kodama/network/NetworkSettings.java
@@ -0,0 +1,60 @@
+package dev.kodama.network;
+
+import dev.kodama.config.KodamaGlobalConfiguration;
+import dev.kodama.feature.FeatureGuard;
+import org.checkerframework.checker.nullness.qual.Nullable;
+
+/**
+ * Read-only view of {@code network} with the master switch and the {@link FeatureGuard} state already applied. Every
+ * call reads the live configuration.
+ */
+final class NetworkSettings {
+
+    static final String CHUNK_BACKLOG_ID = "network-chunk-backlog";
+    static final String ADAPTIVE_COMPRESSION_ID = "network-adaptive-compression";
+
+    private NetworkSettings() {
+    }
+
+    private static KodamaGlobalConfiguration.@Nullable Network section() {
+        final KodamaGlobalConfiguration config = KodamaGlobalConfiguration.get();
+        return config == null ? null : config.network;
+    }
+
+    static boolean masterEnabled() {
+        final KodamaGlobalConfiguration.Network section = section();
+        return section != null && section.enabled.isTrue();
+    }
+
+    static boolean chunkBacklogEnabled() {
+        final KodamaGlobalConfiguration.Network section = section();
+        return masterEnabled() && section.chunkBacklog != null && section.chunkBacklog.enabled.isTrue()
+            && !FeatureGuard.isTripped(CHUNK_BACKLOG_ID);
+    }
+
+    static long chunkBacklogBytes() {
+        final KodamaGlobalConfiguration.Network section = section();
+        return (section == null || section.chunkBacklog == null ? 1024L : Math.max(16L, section.chunkBacklog.maxPendingKb)) * 1024L;
+    }
+
+    static boolean adaptiveCompressionEnabled() {
+        final KodamaGlobalConfiguration.Network section = section();
+        return masterEnabled() && section.adaptiveCompression != null && section.adaptiveCompression.enabled.isTrue()
+            && !FeatureGuard.isTripped(ADAPTIVE_COMPRESSION_ID);
+    }
+
+    static long congestedBytes() {
+        final KodamaGlobalConfiguration.Network section = section();
+        return (section == null || section.adaptiveCompression == null ? 256L : Math.max(1L, section.adaptiveCompression.congestedPendingKb)) * 1024L;
+    }
+
+    static int congestedLevel() {
+        final KodamaGlobalConfiguration.Network section = section();
+        return section == null || section.adaptiveCompression == null ? 9 : Math.max(1, Math.min(9, section.adaptiveCompression.congestedLevel));
+    }
+
+    static int relaxTicks() {
+        final KodamaGlobalConfiguration.Network section = section();
+        return (section == null || section.adaptiveCompression == null ? 10 : Math.max(1, section.adaptiveCompression.relaxSeconds)) * 20;
+    }
+}
diff --git a/src/main/java/dev/kodama/network/NetworkStatus.java b/src/main/java/dev/kodama/network/NetworkStatus.java
new file mode 100644
index 0000000000000000000000000000000000000000..14bcfce45654de26f148b2b7c82cf9e11df723f9
--- /dev/null
+++ b/src/main/java/dev/kodama/network/NetworkStatus.java
@@ -0,0 +1,56 @@
+package dev.kodama.network;
+
+import dev.kodama.command.StatusContributor;
+import dev.kodama.command.subcommands.StatusCommand;
+import net.kyori.adventure.text.Component;
+import net.minecraft.network.CompressionEncoder;
+import net.minecraft.server.MinecraftServer;
+import net.minecraft.server.level.ServerPlayer;
+
+import static net.kyori.adventure.text.Component.text;
+import static net.kyori.adventure.text.format.NamedTextColor.GRAY;
+
+/**
+ * The {@code /kodama status} line of the network optimizations.
+ */
+public final class NetworkStatus {
+
+    private NetworkStatus() {
+    }
+
+    public static void register() {
+        StatusCommand.register(new StatusContributor() {
+            @Override
+            public String label() {
+                return "Network";
+            }
+
+            @Override
+            public Component describe() {
+                if (!NetworkSettings.masterEnabled()) {
+                    return text("off", GRAY);
+                }
+                int congested = 0;
+                int raised = 0;
+                long largest = 0L;
+                for (final ServerPlayer player : MinecraftServer.getServer().getPlayerList().getPlayers()) {
+                    if (player.connection == null || player.connection.connection.channel == null) {
+                        continue;
+                    }
+                    final long pending = ConnectionBacklog.pendingBytes(player.connection.connection);
+                    largest = Math.max(largest, pending);
+                    if (pending >= NetworkSettings.chunkBacklogBytes()) {
+                        congested++;
+                    }
+                    if (player.connection.connection.channel.pipeline().get("compress") instanceof CompressionEncoder encoder
+                        && encoder.kodamaLevel() != CompressionEncoder.KODAMA_BASE_LEVEL) {
+                        raised++;
+                    }
+                }
+                return text("chunk backlog " + (NetworkSettings.chunkBacklogEnabled() ? "on" : "off")
+                    + " (" + congested + " players held back now, " + ConnectionBacklog.heldSends() + " ticks held in total), adaptive compression "
+                    + (NetworkSettings.adaptiveCompressionEnabled() ? "on" : "off") + " (" + raised + " players at a higher level), largest backlog " + (largest / 1024L) + " KB", GRAY);
+            }
+        });
+    }
+}
