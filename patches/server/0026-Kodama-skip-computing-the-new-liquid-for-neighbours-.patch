From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Tonrakun <tonrakun@gmail.com>
Date: Fri, 23 Oct 2026 06:35:41 +0900
Subject: [PATCH] Kodama: skip computing the new liquid for neighbours fluid
 cannot spread to


diff --git a/src/main/java/net/minecraft/world/level/material/FlowingFluid.java b/src/main/java/net/minecraft/world/level/material/FlowingFluid.java
index c2943d892b067b3f1fb3b93301a092e912d71f08..ab405f08a2aff46661a607382f1255f6bcb21d1e 100644
--- a/src/main/java/net/minecraft/world/level/material/FlowingFluid.java
+++ b/src/main/java/net/minecraft/world/level/material/FlowingFluid.java
@@ -429,6 +429,11 @@ public abstract class FlowingFluid extends Fluid {
             // Paper end - Prevent chunk loading from fluid flowing
             BlockState iblockdata1 = (BlockState) pair.getFirst();
             FluidState fluid = (FluidState) pair.getSecond();
+            // Kodama start - canPassThrough fails on these before it looks at the new liquid, so skip computing it (most neighbours in oceans are sources)
+            if (this.isSourceBlockOfThisType(fluid) || !this.canPassThroughWall(enumdirection, world, pos, state, blockposition1, iblockdata1)) {
+                continue;
+            }
+            // Kodama end
             FluidState fluid1 = this.getNewLiquid(world, blockposition1, iblockdata1);
 
             if (this.canPassThrough(world, fluid1.getType(), pos, state, enumdirection, blockposition1, iblockdata1, fluid)) {
