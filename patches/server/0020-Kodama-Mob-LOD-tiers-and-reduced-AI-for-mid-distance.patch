@@ -0,0 +1,47 @@
+package dev.kodama.entity.lod;
+
+import dev.kodama.command.StatusContributor;
+import dev.kodama.command.subcommands.StatusCommand;
+import net.kyori.adventure.text.Component;
+import net.kyori.adventure.text.TextComponent;
+import net.minecraft.server.MinecraftServer;
+import net.minecraft.server.level.ServerLevel;
+
+import static net.kyori.adventure.text.Component.text;
+import static net.kyori.adventure.text.format.NamedTextColor.GRAY;
+import static net.kyori.adventure.text.format.NamedTextColor.WHITE;
+
+/**
+ * The {@code Mob tiers} line of {@code /kodama status}.
+ */
+public final class MobLodStatus {
+
+    private MobLodStatus() {
+    }
+
+    public static void register() {
+        StatusCommand.register(new StatusContributor() {
+            @Override
+            public String label() {
+                return "Mob tiers";
+            }
+
+            @Override
+            public Component describe() {
+                TextComponent result = text("");
+                for (final ServerLevel level : MinecraftServer.getServer().getAllLevels()) {
+                    result = result.append(text("\n  " + level.getWorld().getName() + ": ", WHITE));
+                    if (!level.kodamaMobLod.isActive()) {
+                        result = result.append(text("off", GRAY));
+                        continue;
+                    }
+                    final int[] count = level.kodamaMobLod.count();
+                    result = result.append(text("NEAR " + count[MobTier.NEAR.ordinal()] + ", MID " + count[MobTier.MID.ordinal()]
+                        + ", FAR " + count[MobTier.FAR.ordinal()] + ", not yet assigned " + count[MobTier.OFF.ordinal()]
+                        + " (pinned " + count[4] + ", excluded " + count[5] + ")", GRAY));
+                }
+                return result;
+            }
+        });
+    }
+}
diff --git a/src/main/java/dev/kodama/entity/lod/MobTier.java b/src/main/java/dev/kodama/entity/lod/MobTier.java
new file mode 100644
index 0000000000000000000000000000000000000000..3bc7e209a4290f983d0f627bbbbb15126839583f
--- /dev/null
+++ b/src/main/java/dev/kodama/entity/lod/MobTier.java
@@ -0,0 +1,19 @@
+package dev.kodama.entity.lod;
+
+/**
+ * Level of detail of one mob. {@link #OFF} means the mob is not managed (mob-lod is off in its world, or the mob has not
+ * been evaluated yet); it is handled exactly like Paper does.
+ */
+public enum MobTier {
+    OFF,
+    /** Fully vanilla; never inactive. */
+    NEAR,
+    /** Vanilla physics, reduced AI; never inactive. */
+    MID,
+    /** Handled like Paper's activation range does until the coordinate-only simulation exists. */
+    FAR;
+
+    public boolean isActive() {
+        return this == NEAR || this == MID;
+    }
