diff --git a/src/main/java/dev/kodama/command/subcommands/LodCommand.java b/src/main/java/dev/kodama/command/subcommands/LodCommand.java
new file mode 100644
index 0000000000000000000000000000000000000000..c3c74eeb37f256c177ef7842149c8ab327ef2b4e
--- /dev/null
+++ b/src/main/java/dev/kodama/command/subcommands/LodCommand.java
@@ -0,0 +1,282 @@
+package dev.kodama.command.subcommands;
+
+import dev.kodama.command.Completions;
+import dev.kodama.command.KodamaCommands;
+import dev.kodama.command.PermissionedKodamaSubcommand;
+import dev.kodama.config.ConfigEditor;
+import dev.kodama.config.ConfigReloadException;
+import dev.kodama.config.ConfigSchema;
+import dev.kodama.config.ConfigTarget;
+import dev.kodama.config.KodamaConfigurations;
+import dev.kodama.config.KodamaWorldConfiguration;
+import java.util.ArrayList;
+import java.util.Collections;
+import java.util.LinkedHashMap;
+import java.util.List;
+import java.util.Locale;
+import java.util.Map;
+import net.minecraft.server.MinecraftServer;
+import net.minecraft.server.level.ServerLevel;
+import org.bukkit.Bukkit;
+import org.bukkit.Location;
+import org.bukkit.World;
+import org.bukkit.command.CommandSender;
+import org.bukkit.entity.Player;
+import org.bukkit.permissions.PermissionDefault;
+import org.checkerframework.checker.nullness.qual.NonNull;
+import org.checkerframework.checker.nullness.qual.Nullable;
+import org.checkerframework.framework.qual.DefaultQualifier;
+
+import static net.kyori.adventure.text.Component.text;
+import static net.kyori.adventure.text.format.NamedTextColor.GRAY;
+import static net.kyori.adventure.text.format.NamedTextColor.GREEN;
+import static net.kyori.adventure.text.format.NamedTextColor.RED;
+import static net.kyori.adventure.text.format.NamedTextColor.WHITE;
+
+/**
+ * {@code /kodama lod exclude add|remove|list}: manages the areas of {@code mob-lod.excluded-areas} in the
+ * {@code kodama-world.yml} of a world, where mobs are always fully simulated.
+ */
+@DefaultQualifier(NonNull.class)
+public final class LodCommand extends PermissionedKodamaSubcommand {
+
+    public static final String LITERAL_ARGUMENT = "lod";
+    public static final String PERM = KodamaCommands.COMMAND_BASE_PERM + "." + LITERAL_ARGUMENT;
+
+    private static final String OPTION_PATH = "mob-lod.excluded-areas";
+    private static final List<String> ACTIONS = List.of("add", "remove", "list");
+    private static final String ADD_USAGE = "/kodama lod exclude add <name> <radius> [x z world]";
+    private static final String REMOVE_USAGE = "/kodama lod exclude remove <name> [world]";
+    private static final String LIST_USAGE = "/kodama lod exclude list [world]";
+
+    public LodCommand() {
+        super(PERM, PermissionDefault.OP);
+    }
+
+    @Override
+    public boolean execute(final CommandSender sender, final String subCommand, final String[] args) {
+        if (args.length < 2 || !args[0].equalsIgnoreCase("exclude")) {
+            sendUsage(sender);
+            return false;
+        }
+        final String[] rest = java.util.Arrays.copyOfRange(args, 2, args.length);
+        try {
+            switch (args[1].toLowerCase(Locale.ROOT)) {
+                case "add" -> {
+                    return this.add(sender, rest);
+                }
+                case "remove" -> {
+                    return this.remove(sender, rest);
+                }
+                case "list" -> {
+                    return this.list(sender, rest);
+                }
+                default -> {
+                    sendUsage(sender);
+                    return false;
+                }
+            }
+        } catch (final ConfigReloadException exception) {
+            sender.sendMessage(text("Could not write the world config: " + exception.getMessage(), RED));
+            return false;
+        }
+    }
+
+    private static void sendUsage(final CommandSender sender) {
+        sender.sendMessage(text("Usage:", RED));
+        sender.sendMessage(text("  " + ADD_USAGE, RED));
+        sender.sendMessage(text("  " + REMOVE_USAGE, RED));
+        sender.sendMessage(text("  " + LIST_USAGE, RED));
+    }
+
+    private boolean add(final CommandSender sender, final String[] args) throws ConfigReloadException {
+        if (args.length < 2 || args.length == 3 || args.length > 5) {
+            sender.sendMessage(text("Usage: " + ADD_USAGE, RED));
+            return false;
+        }
+        final String name = args[0];
+        final double radius;
+        try {
+            radius = Double.parseDouble(args[1]);
+        } catch (final NumberFormatException exception) {
+            sender.sendMessage(text("'" + args[1] + "' is not a number.", RED));
+            return false;
+        }
+        if (!(radius > 0.0) || Double.isInfinite(radius)) {
+            sender.sendMessage(text("The radius must be larger than 0.", RED));
+            return false;
+        }
+
+        final double x;
+        final double z;
+        final @Nullable ServerLevel level;
+        if (args.length >= 4) {
+            try {
+                x = Double.parseDouble(args[2]);
+                z = Double.parseDouble(args[3]);
+            } catch (final NumberFormatException exception) {
+                sender.sendMessage(text("The coordinates must be numbers.", RED));
+                return false;
+            }
+            level = args.length == 5 ? level(args[4]) : senderLevel(sender);
+        } else if (sender instanceof Player player) {
+            final Location location = player.getLocation();
+            x = location.getX();
+            z = location.getZ();
+            level = senderLevel(sender);
+        } else {
+            sender.sendMessage(text("The console must give the position: " + ADD_USAGE, RED));
+            return false;
+        }
+        if (level == null) {
+            sender.sendMessage(text("Unknown world. The console must name the world.", RED));
+            return false;
+        }
+
+        final List<Map<String, Object>> areas = currentAreas(level);
+        for (final Map<String, Object> area : areas) {
+            if (String.valueOf(area.get("name")).equalsIgnoreCase(name)) {
+                sender.sendMessage(text("There is already an area named '" + name + "' in " + level.getWorld().getName() + ".", RED));
+                return false;
+            }
+        }
+        final Map<String, Object> area = new LinkedHashMap<>();
+        area.put("name", name);
+        area.put("x", x);
+        area.put("z", z);
+        area.put("radius", radius);
+        areas.add(area);
+        write(sender, level, areas);
+        sender.sendMessage(text(String.format(Locale.ROOT, "Added LOD-free area '%s' in %s at %.1f / %.1f, radius %.1f.", name, level.getWorld().getName(), x, z, radius), GREEN));
+        return true;
+    }
+
+    private boolean remove(final CommandSender sender, final String[] args) throws ConfigReloadException {
+        if (args.length < 1 || args.length > 2) {
+            sender.sendMessage(text("Usage: " + REMOVE_USAGE, RED));
+            return false;
+        }
+        final @Nullable ServerLevel level = args.length == 2 ? level(args[1]) : senderLevel(sender);
+        if (level == null) {
+            sender.sendMessage(text("Unknown world. The console must name the world.", RED));
+            return false;
+        }
+        final List<Map<String, Object>> areas = currentAreas(level);
+        boolean removed = false;
+        for (int i = areas.size() - 1; i >= 0; i--) {
+            if (String.valueOf(areas.get(i).get("name")).equalsIgnoreCase(args[0])) {
+                areas.remove(i);
+                removed = true;
+            }
+        }
+        if (!removed) {
+            sender.sendMessage(text("There is no area named '" + args[0] + "' in " + level.getWorld().getName() + ".", RED));
+            return false;
+        }
+        write(sender, level, areas);
+        sender.sendMessage(text("Removed LOD-free area '" + args[0] + "' from " + level.getWorld().getName() + ".", GREEN));
+        return true;
+    }
+
+    private boolean list(final CommandSender sender, final String[] args) {
+        if (args.length > 1) {
+            sender.sendMessage(text("Usage: " + LIST_USAGE, RED));
+            return false;
+        }
+        final List<ServerLevel> levels = new ArrayList<>();
+        if (args.length == 1) {
+            final @Nullable ServerLevel level = level(args[0]);
+            if (level == null) {
+                sender.sendMessage(text("Unknown world.", RED));
+                return false;
+            }
+            levels.add(level);
+        } else {
+            for (final ServerLevel level : MinecraftServer.getServer().getAllLevels()) {
+                levels.add(level);
+            }
+        }
+        boolean any = false;
+        for (final ServerLevel level : levels) {
+            for (final KodamaWorldConfiguration.MobLod.ExcludedArea area : level.kodamaConfig().mobLod.excludedAreas) {
+                any = true;
+                sender.sendMessage(text("  " + level.getWorld().getName() + ": ", WHITE).append(text(
+                    String.format(Locale.ROOT, "%s at %.1f / %.1f, radius %.1f", area.name(), area.x(), area.z(), area.radius()), GRAY)));
+            }
+        }
+        if (!any) {
+            sender.sendMessage(text("No LOD-free areas.", GRAY));
+        }
+        return true;
+    }
+
+    private static List<Map<String, Object>> currentAreas(final ServerLevel level) {
+        final List<Map<String, Object>> areas = new ArrayList<>();
+        for (final KodamaWorldConfiguration.MobLod.ExcludedArea area : level.kodamaConfig().mobLod.excludedAreas) {
+            final Map<String, Object> raw = new LinkedHashMap<>();
+            raw.put("name", area.name());
+            raw.put("x", area.x());
+            raw.put("z", area.z());
+            raw.put("radius", area.radius());
+            areas.add(raw);
+        }
+        return areas;
+    }
+
+    private static void write(final CommandSender sender, final ServerLevel level, final List<Map<String, Object>> areas) throws ConfigReloadException {
+        final ConfigSchema.Option option = ConfigSchema.WORLD.find(OPTION_PATH);
+        if (option == null) {
+            throw new ConfigReloadException("The option " + OPTION_PATH + " does not exist");
+        }
+        ConfigEditor.setRaw(sender, ConfigTarget.world(level.getWorld().getName()), option, areas.isEmpty() ? null : areas);
+    }
+
+    private static @Nullable ServerLevel senderLevel(final CommandSender sender) {
+        return sender instanceof Player player ? ((org.bukkit.craftbukkit.CraftWorld) player.getWorld()).getHandle() : null;
+    }
+
+    private static @Nullable ServerLevel level(final String name) {
+        return KodamaConfigurations.levelByName(MinecraftServer.getServer(), name);
+    }
+
+    @Override
+    public List<String> tabComplete(final CommandSender sender, final String subCommand, final String[] args) {
+        if (args.length <= 1) {
+            return Completions.matchingLast(args, List.of("exclude"));
+        }
+        if (!args[0].equalsIgnoreCase("exclude")) {
+            return Collections.emptyList();
+        }
+        if (args.length == 2) {
+            return Completions.matchingLast(args, ACTIONS);
+        }
+        final List<String> worlds = new ArrayList<>();
+        for (final World world : Bukkit.getWorlds()) {
+            worlds.add(world.getName());
+        }
+        switch (args[1].toLowerCase(Locale.ROOT)) {
+            case "remove" -> {
+                if (args.length == 3) {
+                    final List<String> names = new ArrayList<>();
+                    final @Nullable ServerLevel level = senderLevel(sender);
+                    if (level != null) {
+                        for (final KodamaWorldConfiguration.MobLod.ExcludedArea area : level.kodamaConfig().mobLod.excludedAreas) {
+                            names.add(area.name());
+                        }
+                    }
+                    return Completions.matchingLast(args, names);
+                }
+                return args.length == 4 ? Completions.matchingLast(args, worlds) : Collections.emptyList();
+            }
+            case "list" -> {
+                return args.length == 3 ? Completions.matchingLast(args, worlds) : Collections.emptyList();
+            }
+            case "add" -> {
+                return args.length == 7 ? Completions.matchingLast(args, worlds) : Collections.emptyList();
+            }
+            default -> {
+                return Collections.emptyList();
+            }
+        }
+    }
+}
