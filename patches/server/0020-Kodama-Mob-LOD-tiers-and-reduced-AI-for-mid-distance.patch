+package dev.kodama.entity.lod;
+
+import java.util.HashMap;
+import java.util.Iterator;
+import java.util.List;
+import java.util.Map;
+import java.util.UUID;
+import net.minecraft.server.level.ServerPlayer;
+
+/**
+ * Finds players who stand (nearly) still for a long time, for example in front of a mob farm. A position sample is
+ * taken every five seconds; a player is waiting when the samples of the whole window stay within the move threshold.
+ */
+final class AfkTracker {
+
+    static final int SAMPLE_TICKS = 100;
+
+    private static final class State {
+        final double[] positions; // x, y, z per sample, used as a ring
+        int count;
+        int next;
+        boolean waiting;
+
+        State(final int capacity) {
+            this.positions = new double[capacity * 3];
+        }
+
+        int capacity() {
+            return this.positions.length / 3;
+        }
+    }
+
+    private final Map<UUID, State> states = new HashMap<>();
+
+    /**
+     * Main thread, once per {@link #SAMPLE_TICKS}.
+     */
+    void sample(final List<ServerPlayer> players, final int afkTicks, final double moveThreshold) {
+        final int capacity = (afkTicks + SAMPLE_TICKS - 1) / SAMPLE_TICKS + 1;
+        final double thresholdSquared = moveThreshold * moveThreshold;
+        for (final Iterator<UUID> it = this.states.keySet().iterator(); it.hasNext();) {
+            final UUID id = it.next();
+            boolean present = false;
+            for (int i = 0; i < players.size(); i++) {
+                if (players.get(i).getUUID().equals(id)) {
+                    present = true;
+                    break;
+                }
+            }
+            if (!present) {
+                it.remove();
+            }
+        }
+        for (int i = 0; i < players.size(); i++) {
+            final ServerPlayer player = players.get(i);
+            State state = this.states.get(player.getUUID());
+            if (state == null || state.capacity() != capacity) {
+                state = new State(capacity);
+                this.states.put(player.getUUID(), state);
+            }
+            final double x = player.getX();
+            final double y = player.getY();
+            final double z = player.getZ();
+            final int slot = state.next * 3;
+            state.positions[slot] = x;
+            state.positions[slot + 1] = y;
+            state.positions[slot + 2] = z;
+            state.next = (state.next + 1) % capacity;
+            if (state.count < capacity) {
+                state.count++;
+            }
+            boolean still = state.count == capacity;
+            for (int s = 0; still && s < state.count; s++) {
+                final double dx = state.positions[s * 3] - x;
+                final double dy = state.positions[s * 3 + 1] - y;
+                final double dz = state.positions[s * 3 + 2] - z;
+                still = dx * dx + dy * dy + dz * dz <= thresholdSquared;
+            }
+            state.waiting = still;
+        }
+    }
+
+    boolean isWaiting(final ServerPlayer player) {
+        final State state = this.states.get(player.getUUID());
+        return state != null && state.waiting;
+    }
+
+    void clear() {
+        this.states.clear();
+    }
+}
diff --git a/src/main/java/dev/kodama/entity/lod/MobLod.java b/src/main/java/dev/kodama/entity/lod/MobLod.java
new file mode 100644
index 0000000000000000000000000000000000000000..81d7da7a8e98a782722044b4e49cabe3e3b95ca9
--- /dev/null
+++ b/src/main/java/dev/kodama/entity/lod/MobLod.java
@@ -0,0 +1,111 @@
+package dev.kodama.entity.lod;
+
+import dev.kodama.feature.FeatureGuard;
+import net.minecraft.server.level.ServerLevel;
+import net.minecraft.world.entity.Mob;
+
+/**
+ * Entry points of mob level of detail for the code that was patched into the game. Everything here is cheap when
+ * mob-lod is off, and a failure of the tier logic never reaches the caller: it is reported to the {@link FeatureGuard}.
+ */
+public final class MobLod {
+
+    public static final String FEATURE_ID = "mob-lod";
+
+    /**
+     * How long damage and right clicks keep a mob NEAR.
+     */
+    private static final int INTERACTION_PIN_TICKS = 10 * 20;
+
+    private MobLod() {
+    }
+
+    /**
+     * Whether the mob is simulated every tick by tier (NEAR or MID) instead of by Paper's activation range.
+     */
+    public static boolean isActive(final Mob mob) {
+        return mob.kodamaTier.isActive();
+    }
+
+    /**
+     * Part B plugs the coordinate-only simulation of FAR mobs in here.
+     */
+    public static boolean isFar(final Mob mob) {
+        return mob.kodamaTier == MobTier.FAR;
+    }
+
+    /**
+     * Plugin API that touches the AI of a mob (target, pathfinder, goals, awareness, look direction, leash): the mob is
+     * NEAR before the call returns and stays NEAR for {@code api-pin-seconds}. Plain data access must not call this.
+     * <p>
+     * Part B restores the state of a far-simulated mob here.
+     */
+    public static void touch(final Mob mob) {
+        try {
+            if (mob.level() instanceof ServerLevel level) {
+                final MobLodManager manager = level.kodamaMobLod;
+                if (manager.isActive()) {
+                    manager.promote(mob, manager.apiPinTicks());
+                }
+            }
+        } catch (final VirtualMachineError error) {
+            throw error;
+        } catch (final Throwable throwable) {
+            FeatureGuard.reportFailure(FEATURE_ID, throwable);
+        }
+    }
+
+    /**
+     * Damage and player interaction.
+     */
+    public static void interacted(final Mob mob) {
+        if (mob.kodamaTier == MobTier.NEAR && mob.kodamaPinUntil >= net.minecraft.server.MinecraftServer.currentTick + INTERACTION_PIN_TICKS) {
+            return;
+        }
+        try {
+            if (mob.level() instanceof ServerLevel level) {
+                level.kodamaMobLod.promote(mob, INTERACTION_PIN_TICKS);
+            }
+        } catch (final VirtualMachineError error) {
+            throw error;
+        } catch (final Throwable throwable) {
+            FeatureGuard.reportFailure(FEATURE_ID, throwable);
+        }
+    }
+
+    /**
+     * A plugin added or removed a goal: the mob is never reduced again, whatever the goal does.
+     */
+    public static void markCustomGoals(final Mob mob) {
+        mob.kodamaCustomGoals = true;
+        touch(mob);
+    }
+
+    /**
+     * Ticks between two goal selections of a MID mob; 1 for every other mob.
+     */
+    public static int aiInterval(final Mob mob) {
+        if (mob.kodamaTier != MobTier.MID || !(mob.level() instanceof ServerLevel level)) {
+            return 1;
+        }
+        return level.kodamaMobLod.midAiInterval();
+    }
+
+    /**
+     * Ticks between two new paths of a MID mob; 1 for every other mob.
+     */
+    public static int pathInterval(final Mob mob) {
+        if (mob.kodamaTier != MobTier.MID || !(mob.level() instanceof ServerLevel level)) {
+            return 1;
+        }
+        return level.kodamaMobLod.midPathInterval();
+    }
+
+    /**
+     * Whether a brain based mob ticks its brain in this tick.
+     */
+    public static boolean shouldTickBrain(final Mob mob) {
+        final int interval = aiInterval(mob);
+        return interval <= 1 || (mob.tickCount + (long)mob.getId()) % interval == 0L;
+    }
+}
diff --git a/src/main/java/dev/kodama/entity/lod/MobLodManager.java b/src/main/java/dev/kodama/entity/lod/MobLodManager.java
new file mode 100644
index 0000000000000000000000000000000000000000..aefbcbb97b27624ab3ffd1fe354c59e6505c9d92
--- /dev/null
+++ b/src/main/java/dev/kodama/entity/lod/MobLodManager.java
@@ -0,0 +1,257 @@
+package dev.kodama.entity.lod;
+
+import dev.kodama.feature.FeatureGuard;
+import java.util.List;
+import net.minecraft.server.MinecraftServer;
+import net.minecraft.server.level.ServerLevel;
+import net.minecraft.server.level.ServerPlayer;
+import net.minecraft.world.entity.Entity;
+import net.minecraft.world.entity.Mob;
+import net.minecraft.world.entity.boss.enderdragon.EnderDragon;
+import net.minecraft.world.entity.boss.wither.WitherBoss;
+import net.minecraft.world.entity.monster.ElderGuardian;
+import net.minecraft.world.entity.monster.warden.Warden;
+import net.minecraft.world.entity.raid.Raider;
+import org.bukkit.craftbukkit.entity.CraftEntity;
+
+/**
+ * Assigns the {@link MobTier} of every mob of one level from its distance to the nearest player. Main thread only.
+ * <p>
+ * {@link #beginTick()} runs once per tick before the entities are ticked; {@link #update(Mob)} runs for each mob but
+ * only evaluates it every {@code update-interval} ticks, spread by entity id.
+ */
+public final class MobLodManager {
+
+    private static final int RECENTLY_HURT_TICKS = 100;
+
+    private final ServerLevel level;
+    final MobLodSettings settings = new MobLodSettings();
+    private final AfkTracker afk = new AfkTracker();
+    private boolean wasActive;
+
+    // players of this tick
+    private int playerCount;
+    private double[] playerX = new double[16];
+    private double[] playerY = new double[16];
+    private double[] playerZ = new double[16];
+    private boolean[] playerWaiting = new boolean[16];
+
+    public MobLodManager(final ServerLevel level) {
+        this.level = level;
+    }
+
+    /**
+     * Whether tiers are assigned in this level right now (enabled in the config and not switched off by the guard).
+     */
+    public boolean isActive() {
+        return this.settings.active;
+    }
+
+    public int midAiInterval() {
+        return this.settings.midAiInterval;
+    }
+
+    public int midPathInterval() {
+        return this.settings.midPathInterval;
+    }
+
+    public int apiPinTicks() {
+        return this.settings.apiPinTicks;
+    }
+
+    public void beginTick() {
+        final MobLodSettings s = this.settings;
+        s.refresh(this.level);
+        if (!s.active) {
+            if (this.wasActive) {
+                this.wasActive = false;
+                this.afk.clear();
+                for (final Entity entity : this.level.getAllEntities()) {
+                    if (entity instanceof Mob mob) {
+                        mob.kodamaTier = MobTier.OFF;
+                    }
+                }
+            }
+            return;
+        }
+        this.wasActive = true;
+
+        final List<ServerPlayer> players = this.level.players();
+        if (MinecraftServer.currentTick % AfkTracker.SAMPLE_TICKS == 0) {
+            this.afk.sample(players, s.afkTicks, s.afkMoveThreshold);
+        }
+        final boolean ignoreSpectators = this.level.spigotConfig.ignoreSpectatorActivation;
+        if (this.playerX.length < players.size()) {
+            final int size = players.size() + 8;
+            this.playerX = new double[size];
+            this.playerY = new double[size];
+            this.playerZ = new double[size];
+            this.playerWaiting = new boolean[size];
+        }
+        int count = 0;
+        for (int i = 0; i < players.size(); i++) {
+            final ServerPlayer player = players.get(i);
+            if (ignoreSpectators && player.isSpectator()) {
+                continue;
+            }
+            this.playerX[count] = player.getX();
+            this.playerY[count] = player.getY();
+            this.playerZ[count] = player.getZ();
+            this.playerWaiting[count] = this.afk.isWaiting(player);
+            count++;
+        }
+        this.playerCount = count;
+    }
+
+    public void update(final Mob mob) {
+        final MobLodSettings s = this.settings;
+        if (!s.active) {
+            return;
+        }
+        final int now = MinecraftServer.currentTick;
+        if ((mob.getId() + (long)now) % s.updateInterval != 0L) {
+            return;
+        }
+        try {
+            this.evaluate(mob, now);
+        } catch (final VirtualMachineError error) {
+            throw error;
+        } catch (final Throwable throwable) {
+            mob.kodamaTier = MobTier.NEAR;
+            mob.kodamaForcedNear = true;
+            FeatureGuard.reportFailure(MobLod.FEATURE_ID, throwable);
+        }
+    }
+
+    private void evaluate(final Mob mob, final int now) {
+        final MobLodSettings s = this.settings;
+        if (mob.kodamaPinUntil > now) {
+            mob.kodamaTier = MobTier.NEAR;
+            return;
+        }
+        final boolean forced = mustBeNear(mob) || s.inExcludedArea(mob.getX(), mob.getZ());
+        mob.kodamaForcedNear = forced;
+        if (forced) {
+            mob.kodamaTier = MobTier.NEAR;
+            return;
+        }
+
+        final double distanceSquared = this.nearestPlayerSquared(mob);
+        MobTier tier = mob.kodamaTier == MobTier.OFF ? MobTier.NEAR : mob.kodamaTier;
+        if (tier == MobTier.NEAR && distanceSquared > s.nearEnterSquared) {
+            tier = MobTier.MID;
+        }
+        if (tier == MobTier.MID && distanceSquared > s.farEnterSquared) {
+            tier = MobTier.FAR;
+        }
+        if (tier == MobTier.FAR && distanceSquared < s.farLeaveSquared) {
+            tier = MobTier.MID;
+        }
+        if (tier == MobTier.MID && distanceSquared < s.nearLeaveSquared) {
+            tier = MobTier.NEAR;
+        }
+        if (tier == MobTier.FAR && (isEnvironmentProtected(mob) || this.isNearWaitingPlayer(mob))) {
+            tier = MobTier.MID;
+        }
+        mob.kodamaTier = tier;
+    }
+
+    private double nearestPlayerSquared(final Mob mob) {
+        final double x = mob.getX();
+        final double y = mob.getY();
+        final double z = mob.getZ();
+        double best = Double.POSITIVE_INFINITY;
+        for (int i = 0; i < this.playerCount; i++) {
+            final double dx = this.playerX[i] - x;
+            final double dy = this.playerY[i] - y;
+            final double dz = this.playerZ[i] - z;
+            final double d = dx * dx + dy * dy + dz * dz;
+            if (d < best) {
+                best = d;
+            }
+        }
+        return best;
+    }
+
+    private boolean isNearWaitingPlayer(final Mob mob) {
+        final double x = mob.getX();
+        final double y = mob.getY();
+        final double z = mob.getZ();
+        for (int i = 0; i < this.playerCount; i++) {
+            if (!this.playerWaiting[i]) {
+                continue;
+            }
+            final double dx = this.playerX[i] - x;
+            final double dy = this.playerY[i] - y;
+            final double dz = this.playerZ[i] - z;
+            if (dx * dx + dy * dy + dz * dz <= this.settings.afkRadiusSquared) {
+                return true;
+            }
+        }
+        return false;
+    }
+
+    /**
+     * Mobs a plugin or the game relies on to behave exactly like vanilla.
+     */
+    private static boolean mustBeNear(final Mob mob) {
+        if (mob.kodamaCustomGoals || mob.kodamaPluginData || !mob.aware) {
+            return true;
+        }
+        if (mob.hasCustomName() || mob.isLeashed() || mob.isPassenger() || mob.isVehicle() || mob.getTarget() != null) {
+            return true;
+        }
+        if (mob instanceof EnderDragon || mob instanceof WitherBoss || mob instanceof Warden || mob instanceof ElderGuardian) {
+            return true;
+        }
+        if (mob instanceof Raider raider && raider.hasActiveRaid()) {
+            return true;
+        }
+        final CraftEntity bukkit = mob.getBukkitEntityRaw();
+        return bukkit != null && !bukkit.getPersistentDataContainer().isEmpty();
+    }
+
+    /**
+     * Mobs that are in fluid, in the air, climbing, falling or recently hurt are at most MID.
+     */
+    private static boolean isEnvironmentProtected(final Mob mob) {
+        if (mob.isInWater() || mob.isInLava() || !mob.onGround() || mob.onClimbable() || mob.fallDistance > 0.0F || mob.hurtTime > 0) {
+            return true;
+        }
+        return mob.getLastHurtByMob() != null && mob.tickCount - mob.getLastHurtByMobTimestamp() < RECENTLY_HURT_TICKS;
+    }
+
+    /**
+     * Moves the mob to NEAR immediately and keeps it there for {@code pinTicks}.
+     */
+    public void promote(final Mob mob, final int pinTicks) {
+        if (!this.settings.active) {
+            return;
+        }
+        final int until = MinecraftServer.currentTick + pinTicks;
+        if (until > mob.kodamaPinUntil) {
+            mob.kodamaPinUntil = until;
+        }
+        mob.kodamaTier = MobTier.NEAR;
+    }
+
+    /**
+     * Tier counts of this level for {@code /kodama status}: unassigned, near, mid, far, pinned, excluded.
+     */
+    public int[] count() {
+        final int[] result = new int[6];
+        final int now = MinecraftServer.currentTick;
+        for (final Entity entity : this.level.getAllEntities()) {
+            if (entity instanceof Mob mob) {
+                result[mob.kodamaTier.ordinal()]++;
+                if (mob.kodamaPinUntil > now) {
+                    result[4]++;
+                }
+                if (mob.kodamaForcedNear) {
+                    result[5]++;
+                }
+            }
+        }
+        return result;
+    }
+}
diff --git a/src/main/java/dev/kodama/entity/lod/MobLodSettings.java b/src/main/java/dev/kodama/entity/lod/MobLodSettings.java
new file mode 100644
index 0000000000000000000000000000000000000000..f893f1cdb3d4caddb7b3b88159a107b9cec6d72b
--- /dev/null
+++ b/src/main/java/dev/kodama/entity/lod/MobLodSettings.java
@@ -0,0 +1,95 @@
+package dev.kodama.entity.lod;
+
+import dev.kodama.config.KodamaWorldConfiguration;
+import dev.kodama.feature.FeatureGuard;
+import java.util.List;
+import net.minecraft.server.level.ServerLevel;
+
+/**
+ * Snapshot of the {@code mob-lod} world section, refreshed once per tick by {@link MobLodManager}, with the master
+ * switch and the {@link FeatureGuard} state already applied. Distances are stored squared.
+ */
+final class MobLodSettings {
+
+    boolean active;
+    int nearDistance;
+    int farDistance;
+    int hysteresis;
+    double nearEnterSquared; // farther than this: leave NEAR
+    double nearLeaveSquared; // closer than this: back to NEAR
+    double farEnterSquared;
+    double farLeaveSquared;
+    int updateInterval = 10;
+    int midAiInterval = 1;
+    int midPathInterval = 1;
+    int afkTicks;
+    double afkMoveThreshold;
+    double afkRadiusSquared;
+    int apiPinTicks;
+
+    // excluded areas as parallel arrays; rebuilt only when the configured list changes
+    private List<KodamaWorldConfiguration.MobLod.ExcludedArea> areaSource;
+    double[] areaX = new double[0];
+    double[] areaZ = new double[0];
+    double[] areaRadiusSquared = new double[0];
+
+    void refresh(final ServerLevel level) {
+        final KodamaWorldConfiguration config = level.kodamaConfig();
+        final KodamaWorldConfiguration.MobLod section = config == null ? null : config.mobLod;
+        if (section == null || !section.enabled.isTrue() || FeatureGuard.isTripped(MobLod.FEATURE_ID)) {
+            this.active = false;
+            return;
+        }
+        final int near = section.nearDistance.getAsInt();
+        if (near <= 0) {
+            this.active = false; // 0 is how the safe preset turns the feature off
+            return;
+        }
+        this.active = true;
+        final int far = Math.max(near + 1, section.farDistance.getAsInt());
+        final int margin = Math.max(0, Math.min(section.hysteresis.getAsInt(), near / 2));
+        this.nearDistance = near;
+        this.farDistance = far;
+        this.hysteresis = margin;
+        this.nearEnterSquared = square(near + margin);
+        this.nearLeaveSquared = square(near - margin);
+        this.farEnterSquared = square(far + margin);
+        this.farLeaveSquared = square(far - margin);
+        this.updateInterval = Math.max(1, section.updateInterval);
+        this.midAiInterval = Math.max(1, section.midAiInterval.getAsInt());
+        this.midPathInterval = Math.max(1, section.midPathInterval.getAsInt());
+        this.afkTicks = Math.max(1, section.afkSeconds) * 20;
+        this.afkMoveThreshold = Math.max(0.0, section.afkMoveThreshold);
+        this.afkRadiusSquared = square(Math.max(0, section.afkRadius));
+        this.apiPinTicks = Math.max(0, section.apiPinSeconds) * 20;
+
+        if (section.excludedAreas != this.areaSource) {
+            this.areaSource = section.excludedAreas;
+            final int size = this.areaSource == null ? 0 : this.areaSource.size();
+            this.areaX = new double[size];
+            this.areaZ = new double[size];
+            this.areaRadiusSquared = new double[size];
+            for (int i = 0; i < size; i++) {
+                final KodamaWorldConfiguration.MobLod.ExcludedArea area = this.areaSource.get(i);
+                this.areaX[i] = area.x();
+                this.areaZ[i] = area.z();
+                this.areaRadiusSquared[i] = square(Math.max(0.0, area.radius()));
+            }
+        }
+    }
+
+    boolean inExcludedArea(final double x, final double z) {
+        for (int i = 0; i < this.areaX.length; i++) {
+            final double dx = x - this.areaX[i];
+            final double dz = z - this.areaZ[i];
+            if (dx * dx + dz * dz <= this.areaRadiusSquared[i]) {
+                return true;
+            }
+        }
+        return false;
+    }
+
+    private static double square(final double value) {
+        return value * value;
+    }
+}
