+    /**
+     * Like {@link #set} for a value that is given as raw YAML data (a list, for example) instead of text, so commands
+     * that manage such options can use the same file writing, validation, undo and change log.
+     *
+     * @throws ConfigReloadException when the resulting config is invalid; nothing was written then
+     */
+    public static Result setRaw(final CommandSender sender, final ConfigTarget target, final ConfigSchema.Option option, final Object raw) throws ConfigReloadException {
+        final Change change = apply(sender, target, option, raw, null);
+        if (change == null) {
+            final String shown = display(currentOrNull(target, option));
+            return new Result(target, option, shown, shown, true);
+        }
+        push(sender, change);
+        return new Result(target, option, change.oldDisplay(), change.newDisplay(), false);
+    }
