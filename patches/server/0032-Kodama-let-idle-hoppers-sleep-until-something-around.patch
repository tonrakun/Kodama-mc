diff --git a/src/main/java/dev/kodama/hopper/HopperSleep.java b/src/main/java/dev/kodama/hopper/HopperSleep.java
new file mode 100644
index 0000000000000000000000000000000000000000..9b436010ac32e8b0a62769e86e89dd34e2f5afef
--- /dev/null
+++ b/src/main/java/dev/kodama/hopper/HopperSleep.java
@@ -0,0 +1,272 @@
+package dev.kodama.hopper;
+
+import dev.kodama.config.KodamaWorldConfiguration;
+import dev.kodama.feature.FeatureGuard;
+import io.papermc.paper.world.ChunkEntitySlices;
+import it.unimi.dsi.fastutil.longs.Long2ObjectOpenHashMap;
+import it.unimi.dsi.fastutil.objects.ReferenceArrayList;
+import java.util.ArrayList;
+import net.minecraft.core.BlockPos;
+import net.minecraft.core.Direction;
+import net.minecraft.core.SectionPos;
+import net.minecraft.server.level.FullChunkStatus;
+import net.minecraft.server.level.ServerLevel;
+import net.minecraft.world.Container;
+import net.minecraft.world.entity.Entity;
+import net.minecraft.world.entity.item.ItemEntity;
+import net.minecraft.world.level.ChunkPos;
+import net.minecraft.world.level.block.ChestBlock;
+import net.minecraft.world.level.block.HopperBlock;
+import net.minecraft.world.level.block.entity.HopperBlockEntity;
+import net.minecraft.world.level.block.state.BlockState;
+import net.minecraft.world.level.block.state.properties.ChestType;
+import org.bukkit.event.inventory.HopperInventorySearchEvent;
+import org.bukkit.event.inventory.InventoryMoveItemEvent;
+import org.bukkit.event.inventory.InventoryPickupItemEvent;
+import org.checkerframework.checker.nullness.qual.Nullable;
+
+/**
+ * Idle hoppers of one world that skip their transfer attempt until something they depend on changes.
+ * <p>
+ * A hopper falls asleep after an attempt that moved nothing. While it sleeps it still ticks (cooldown and the game time
+ * that other hoppers compare against), but instead of searching it sets the cooldown the failed attempt left, which is
+ * what the same attempt would do again on an unchanged world. It wakes, and runs the vanilla attempt in that same tick,
+ * when one of these changes:
+ * <ul>
+ * <li>a block state or block entity at the hopper, the block above, the block it faces, or the other half of a double
+ * chest there;</li>
+ * <li>an item entity or container entity (minecart, chest boat) enters an entity section the vanilla search could look
+ * into;</li>
+ * <li>the entity status of a chunk in that range (load, unload);</li>
+ * <li>a plugin opens one of those inventories through the Bukkit API.</li>
+ * </ul>
+ * A hopper only falls asleep when no item or container entity is in that range and every chunk of it is fully loaded,
+ * and never while a plugin listens to the hopper events, so plugins see every attempt like on Paper. Main thread only.
+ */
+public final class HopperSleep {
+
+    public static final String FEATURE_ID = "hopper-sleep";
+
+    private final ServerLevel level;
+    private boolean active;
+    private final Long2ObjectOpenHashMap<ReferenceArrayList<HopperBlockEntity>> byBlock = new Long2ObjectOpenHashMap<>();
+    private final Long2ObjectOpenHashMap<ReferenceArrayList<HopperBlockEntity>> bySection = new Long2ObjectOpenHashMap<>();
+    private final Long2ObjectOpenHashMap<ReferenceArrayList<HopperBlockEntity>> byChunk = new Long2ObjectOpenHashMap<>();
+    private int sleeping;
+
+    public HopperSleep(final ServerLevel level) {
+        this.level = level;
+    }
+
+    public int sleeping() {
+        return this.sleeping;
+    }
+
+    public boolean isActive() {
+        return this.active;
+    }
+
+    /**
+     * Start of the world tick.
+     */
+    public void tick() {
+        final boolean wasActive = this.active;
+        this.active = this.configuredEnabled() && noHopperListeners();
+        if (wasActive && !this.active) {
+            this.wakeAll();
+        }
+    }
+
+    private boolean configuredEnabled() {
+        final KodamaWorldConfiguration config = this.level.kodamaConfig();
+        final KodamaWorldConfiguration.Hoppers section = config == null ? null : config.hoppers;
+        return section != null && section.enabled.isTrue() && section.idleSleep.isTrue() && this.level.spigotConfig.hopperCheck <= 1
+            && !FeatureGuard.isTripped(FEATURE_ID);
+    }
+
+    private static boolean noHopperListeners() {
+        return InventoryMoveItemEvent.getHandlerList().getRegisteredListeners().length == 0
+            && InventoryPickupItemEvent.getHandlerList().getRegisteredListeners().length == 0
+            && HopperInventorySearchEvent.getHandlerList().getRegisteredListeners().length == 0;
+    }
+
+    /**
+     * Whether the sleeping hopper may skip this attempt.
+     */
+    public boolean skip(final HopperBlockEntity hopper) {
+        if (this.active) {
+            return true;
+        }
+        this.wake(hopper);
+        return false;
+    }
+
+    /**
+     * The attempt of the hopper moved nothing; its cooldown is what the attempt left.
+     */
+    public void trySleep(final HopperBlockEntity hopper, final BlockPos pos, final BlockState state) {
+        if (!this.active || hopper.kodamaAsleep || hopper.isRemoved()) {
+            return;
+        }
+        try {
+            final Direction facing = state.getValue(HopperBlock.FACING);
+            final ArrayList<BlockPos> blocks = new ArrayList<>(6);
+            blocks.add(pos);
+            addWithChestPartner(blocks, pos.above());
+            addWithChestPartner(blocks, pos.relative(facing));
+
+            // a superset of the boxes vanilla searches for items (suck area) and container entities (above, facing),
+            // grown like Paper's entity lookup grows its search box
+            final int minX = pos.getX() - 1 - 2;
+            final int maxX = pos.getX() + 2 + 2;
+            final int minY = pos.getY() - 1 - 2;
+            final int maxY = pos.getY() + 3 + 2;
+            final int minZ = pos.getZ() - 1 - 2;
+            final int maxZ = pos.getZ() + 2 + 2;
+            final int minChunkX = minX >> 4;
+            final int maxChunkX = maxX >> 4;
+            final int minChunkZ = minZ >> 4;
+            final int maxChunkZ = maxZ >> 4;
+            final int minSection = minY >> 4;
+            final int maxSection = maxY >> 4;
+
+            final long[] chunks = new long[(maxChunkX - minChunkX + 1) * (maxChunkZ - minChunkZ + 1)];
+            final long[] sections = new long[chunks.length * (maxSection - minSection + 1)];
+            int chunkCount = 0;
+            int sectionCount = 0;
+            for (int chunkX = minChunkX; chunkX <= maxChunkX; chunkX++) {
+                for (int chunkZ = minChunkZ; chunkZ <= maxChunkZ; chunkZ++) {
+                    final ChunkEntitySlices slices = this.level.getEntityLookup().getChunk(chunkX, chunkZ);
+                    if (slices == null || slices.status == null || !slices.status.isOrAfter(FullChunkStatus.FULL)
+                        || slices.kodamaHasEntitiesOfClass(ItemEntity.class, minSection, maxSection)
+                        || slices.kodamaHasEntitiesOfClass(Container.class, minSection, maxSection)) {
+                        return;
+                    }
+                    chunks[chunkCount++] = ChunkPos.asLong(chunkX, chunkZ);
+                    for (int sectionY = minSection; sectionY <= maxSection; sectionY++) {
+                        sections[sectionCount++] = SectionPos.asLong(chunkX, sectionY, chunkZ);
+                    }
+                }
+            }
+            for (final BlockPos block : blocks) {
+                if (this.level.getChunkIfLoaded(block.getX() >> 4, block.getZ() >> 4) == null) {
+                    return;
+                }
+            }
+
+            final long[] blockKeys = new long[blocks.size()];
+            for (int i = 0; i < blockKeys.length; i++) {
+                blockKeys[i] = blocks.get(i).asLong();
+            }
+            hopper.kodamaWatchBlocks = blockKeys;
+            hopper.kodamaWatchSections = sections;
+            hopper.kodamaWatchChunks = chunks;
+            hopper.kodamaSleepCooldown = hopper.cooldownTime;
+            hopper.kodamaAsleep = true;
+            register(this.byBlock, blockKeys, hopper);
+            register(this.bySection, sections, hopper);
+            register(this.byChunk, chunks, hopper);
+            this.sleeping++;
+        } catch (final VirtualMachineError error) {
+            throw error;
+        } catch (final Throwable throwable) {
+            FeatureGuard.reportFailure(FEATURE_ID, throwable);
+        }
+    }
+
+    private void addWithChestPartner(final ArrayList<BlockPos> blocks, final BlockPos pos) {
+        blocks.add(pos);
+        final BlockState state = this.level.getBlockStateIfLoaded(pos);
+        if (state != null && state.getBlock() instanceof ChestBlock && state.getValue(ChestBlock.TYPE) != ChestType.SINGLE) {
+            blocks.add(pos.relative(ChestBlock.getConnectedDirection(state)));
+        }
+    }
+
+    private static void register(final Long2ObjectOpenHashMap<ReferenceArrayList<HopperBlockEntity>> map, final long[] keys, final HopperBlockEntity hopper) {
+        for (final long key : keys) {
+            ReferenceArrayList<HopperBlockEntity> list = map.get(key);
+            if (list == null) {
+                map.put(key, list = new ReferenceArrayList<>(2));
+            }
+            list.add(hopper);
+        }
+    }
+
+    private static void unregister(final Long2ObjectOpenHashMap<ReferenceArrayList<HopperBlockEntity>> map, final long @Nullable [] keys, final HopperBlockEntity hopper) {
+        if (keys == null) {
+            return;
+        }
+        for (final long key : keys) {
+            final ReferenceArrayList<HopperBlockEntity> list = map.get(key);
+            if (list != null && list.remove(hopper) && list.isEmpty()) {
+                map.remove(key);
+            }
+        }
+    }
+
+    public void wake(final HopperBlockEntity hopper) {
+        if (!hopper.kodamaAsleep) {
+            return;
+        }
+        hopper.kodamaAsleep = false;
+        unregister(this.byBlock, hopper.kodamaWatchBlocks, hopper);
+        unregister(this.bySection, hopper.kodamaWatchSections, hopper);
+        unregister(this.byChunk, hopper.kodamaWatchChunks, hopper);
+        hopper.kodamaWatchBlocks = null;
+        hopper.kodamaWatchSections = null;
+        hopper.kodamaWatchChunks = null;
+        this.sleeping--;
+    }
+
+    private void wakeList(final @Nullable ReferenceArrayList<HopperBlockEntity> list) {
+        if (list == null) {
+            return;
+        }
+        // waking removes the hopper from this list
+        final HopperBlockEntity[] hoppers = list.toArray(new HopperBlockEntity[0]);
+        for (final HopperBlockEntity hopper : hoppers) {
+            this.wake(hopper);
+        }
+    }
+
+    public void wakeAll() {
+        if (this.sleeping == 0) {
+            return;
+        }
+        final ArrayList<HopperBlockEntity> all = new ArrayList<>();
+        for (final ReferenceArrayList<HopperBlockEntity> list : this.byChunk.values()) {
+            all.addAll(list);
+        }
+        for (final HopperBlockEntity hopper : all) {
+            this.wake(hopper);
+        }
+    }
+
+    /**
+     * A plugin got a Bukkit inventory of the container.
+     */
+    public static void touched(final Container container) {
+        if (container instanceof net.minecraft.world.level.block.entity.BlockEntity blockEntity
+            && blockEntity.getLevel() instanceof ServerLevel serverLevel && serverLevel.getServer().isSameThread()) {
+            serverLevel.kodamaHoppers.blockChanged(blockEntity.getBlockPos());
+        }
+    }
+
+    public void blockChanged(final BlockPos pos) {
+        if (!this.byBlock.isEmpty()) {
+            this.wakeList(this.byBlock.get(pos.asLong()));
+        }
+    }
+
+    public void entityEntered(final Entity entity, final int chunkX, final int sectionY, final int chunkZ) {
+        if (!this.bySection.isEmpty() && (entity instanceof ItemEntity || entity instanceof Container)) {
+            this.wakeList(this.bySection.get(SectionPos.asLong(chunkX, sectionY, chunkZ)));
+        }
+    }
+
+    public void chunkStatusChanged(final int chunkX, final int chunkZ) {
+        if (!this.byChunk.isEmpty()) {
+            this.wakeList(this.byChunk.get(ChunkPos.asLong(chunkX, chunkZ)));
+        }
+    }
+}
