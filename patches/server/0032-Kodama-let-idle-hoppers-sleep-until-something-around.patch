         this.allEntities.getEntities(type, box, (List)into, (Predicate)predicate);
     }
 
+    // Kodama start - hopper-sleep
+    /**
+     * Whether an entity of the class is in one of the sections, by the same per class index the class lookups use.
+     */
+    @SuppressWarnings({"rawtypes", "unchecked"})
+    public boolean kodamaHasEntitiesOfClass(final Class clazz, final int minSectionY, final int maxSectionY) {
+        EntityCollectionBySection collection = this.entitiesByClass.get(clazz);
+        if (collection == null) {
+            this.entitiesByClass.putIfAbsent(clazz, collection = this.initClass(clazz));
+        }
+        if (collection.count == 0) {
+            return false;
+        }
+        for (int sectionY = Math.max(minSectionY, this.minSection), max = Math.min(maxSectionY, this.maxSection); sectionY <= max; ++sectionY) {
+            if (collection.entitiesBySection[sectionY - this.minSection] != null) {
+                return true;
+            }
+        }
+        return false;
+    }
+    // Kodama end - hopper-sleep
+
     protected EntityCollectionBySection initClass(final Class<? extends Entity> clazz) {
         final EntityCollectionBySection ret = new EntityCollectionBySection(this);
 
