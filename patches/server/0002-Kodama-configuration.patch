+package dev.kodama.config;
+
+import java.lang.reflect.Type;
+import java.util.List;
+import org.checkerframework.checker.nullness.qual.Nullable;
+import org.spongepowered.configurate.serialize.ScalarSerializer;
+import org.spongepowered.configurate.serialize.SerializationException;
+
+public final class PresetInt extends PresetValue<Integer> {
+
+    public static final ScalarSerializer<PresetInt> SERIALIZER = new Serializer();
+
+    private PresetInt(final @Nullable Integer explicit, final @Nullable List<Integer> defaults) {
+        super(explicit, defaults);
+    }
+
+    public static PresetInt of(final int safe, final int balanced, final int aggressive) {
+        return new PresetInt(null, List.of(safe, balanced, aggressive));
+    }
+
+    public int getAsInt() {
+        return this.get();
+    }
+
+    private static final class Serializer extends PresetValue.Serializer<PresetInt, Integer> {
+        private Serializer() {
+            super(PresetInt.class, explicit -> new PresetInt(explicit, null));
+        }
+
+        @Override
+        protected Integer parse(final Type type, final Object obj) throws SerializationException {
+            try {
+                if (obj instanceof Number number) {
+                    if (number.intValue() != number.doubleValue()) {
+                        throw new SerializationException(PresetInt.class, number + " is not a whole number");
+                    }
+                    return number.intValue();
+                }
+                return Integer.parseInt(obj.toString().trim());
+            } catch (final NumberFormatException ex) {
+                throw new SerializationException(PresetInt.class, "'" + obj + "' is not a whole number or '" + DEFAULT_VALUE + "'");
+            }
+        }
+    }
+}
