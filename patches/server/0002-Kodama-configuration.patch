@@ -0,0 +1,48 @@
+package dev.kodama.config;
+
+import java.lang.reflect.Type;
+import java.util.List;
+import java.util.Locale;
+import org.checkerframework.checker.nullness.qual.Nullable;
+import org.spongepowered.configurate.serialize.ScalarSerializer;
+import org.spongepowered.configurate.serialize.SerializationException;
+
+public final class PresetBoolean extends PresetValue<Boolean> {
+
+    public static final ScalarSerializer<PresetBoolean> SERIALIZER = new Serializer();
+
+    private PresetBoolean(final @Nullable Boolean explicit, final @Nullable List<Boolean> defaults) {
+        super(explicit, defaults);
+    }
+
+    public static PresetBoolean of(final boolean safe, final boolean balanced, final boolean aggressive) {
+        return new PresetBoolean(null, List.of(safe, balanced, aggressive));
+    }
+
+    public boolean isTrue() {
+        return this.get();
+    }
+
+    private static final class Serializer extends PresetValue.Serializer<PresetBoolean, Boolean> {
+        private Serializer() {
+            super(PresetBoolean.class, explicit -> new PresetBoolean(explicit, null));
+        }
+
+        @Override
+        protected Boolean parse(final Type type, final Object obj) throws SerializationException {
+            if (obj instanceof Boolean bool) {
+                return bool;
+            }
+            if (obj instanceof String string) {
+                final String lower = string.trim().toLowerCase(Locale.ROOT);
+                if (lower.equals("true")) {
+                    return true;
+                }
+                if (lower.equals("false")) {
+                    return false;
+                }
+            }
+            throw new SerializationException(PresetBoolean.class, "'" + obj + "' is not true, false or '" + DEFAULT_VALUE + "'");
+        }
+    }
+}
