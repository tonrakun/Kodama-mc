+package dev.kodama.config;
+
+import java.lang.reflect.Type;
+import java.util.List;
+import java.util.function.Function;
+import java.util.function.Predicate;
+import org.checkerframework.checker.nullness.qual.Nullable;
+import org.spongepowered.configurate.serialize.ScalarSerializer;
+import org.spongepowered.configurate.serialize.SerializationException;
+
+/**
+ * A config value whose default depends on the active {@link Preset}.
+ * <p>
+ * In the file it is the literal {@code default} unless the user wrote an explicit value. The per-preset defaults are
+ * declared where the field is initialized, for example {@code PresetBoolean.of(false, true, true)}; a deserialized
+ * instance only knows the explicit value and takes the defaults over from the initial field value
+ * (see {@link #inheritDefaults(PresetValue)}).
+ */
+public abstract class PresetValue<T> {
+
+    public static final String DEFAULT_VALUE = "default";
+
+    protected final @Nullable T explicit;
+    private @Nullable List<T> defaults; // indexed by Preset#ordinal
+
+    protected PresetValue(final @Nullable T explicit, final @Nullable List<T> defaults) {
+        this.explicit = explicit;
+        this.defaults = defaults;
+    }
+
+    public final T get() {
+        final T explicit = this.explicit;
+        return explicit != null ? explicit : this.defaultFor(Preset.current());
+    }
+
+    public final T defaultFor(final Preset preset) {
+        if (this.defaults == null) {
+            throw new IllegalStateException("Preset defaults were never bound to this value");
+        }
+        return this.defaults.get(preset.ordinal());
+    }
+
+    public final @Nullable T explicit() {
+        return this.explicit;
+    }
+
+    public final boolean isDefault() {
+        return this.explicit == null;
+    }
+
+    /**
+     * Called by the config mapper right after deserialization; do not call from feature code.
+     */
+    public final void inheritDefaults(final PresetValue<?> initial) {
+        if (this.defaults == null && initial.defaults != null) {
+            @SuppressWarnings("unchecked") final List<T> typed = (List<T>) initial.defaults;
+            this.defaults = typed;
+        }
+    }
+
+    public final String describe() {
+        return this.explicit != null ? String.valueOf(this.explicit) : DEFAULT_VALUE + " (" + this.get() + ")";
+    }
+
+    @Override
+    public String toString() {
+        return this.describe();
+    }
+
+    @Override
+    public boolean equals(final Object obj) {
+        return obj != null && obj.getClass() == this.getClass() && java.util.Objects.equals(this.explicit, ((PresetValue<?>) obj).explicit)
+            && java.util.Objects.equals(this.defaults, ((PresetValue<?>) obj).defaults);
+    }
+
+    @Override
+    public int hashCode() {
+        return java.util.Objects.hash(this.explicit, this.defaults);
+    }
+
+    protected abstract static class Serializer<V extends PresetValue<T>, T> extends ScalarSerializer<V> {
+
+        private final Function<@Nullable T, V> factory;
+
+        protected Serializer(final Class<V> type, final Function<@Nullable T, V> factory) {
+            super(type);
+            this.factory = factory;
+        }
+
+        protected abstract T parse(Type type, Object obj) throws SerializationException;
+
+        @Override
+        public V deserialize(final Type type, final Object obj) throws SerializationException {
+            if (obj instanceof String string && DEFAULT_VALUE.equalsIgnoreCase(string.trim())) {
+                return this.factory.apply(null);
+            }
+            return this.factory.apply(this.parse(type, obj));
+        }
+
+        @Override
+        protected Object serialize(final V item, final Predicate<Class<?>> typeSupported) {
+            final T explicit = item.explicit;
+            return explicit != null ? explicit : DEFAULT_VALUE;
+        }
+    }
+}
