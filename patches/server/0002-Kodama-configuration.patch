+package dev.kodama.config;
+
+import io.papermc.paper.configuration.Configuration;
+import io.papermc.paper.configuration.ConfigurationPart;
+import io.papermc.paper.configuration.constraint.Constraint;
+import io.papermc.paper.configuration.constraint.Constraints;
+import org.spongepowered.configurate.objectmapping.meta.Comment;
+import org.spongepowered.configurate.objectmapping.meta.Setting;
+
+@SuppressWarnings({"CanBeFinal", "FieldCanBeLocal", "FieldMayBeFinal", "NotNullFieldNotInitialized", "InnerClassMayBeStatic"})
+public class KodamaGlobalConfiguration extends ConfigurationPart {
+    static final int CURRENT_VERSION = 1;
+    private static volatile KodamaGlobalConfiguration instance;
+
+    public static KodamaGlobalConfiguration get() {
+        return instance;
+    }
+
+    static void set(final KodamaGlobalConfiguration instance) {
+        KodamaGlobalConfiguration.instance = instance;
+    }
+
+    /**
+     * The active preset, or {@link Preset#BALANCED} while the configuration is not loaded yet.
+     */
+    public static Preset currentPreset() {
+        final KodamaGlobalConfiguration current = instance;
+        return current == null || current.preset == null ? Preset.BALANCED : current.preset;
+    }
+
+    @Setting(Configuration.VERSION_FIELD)
+    public int version = CURRENT_VERSION;
+
+    @Comment("Decides the default of every option written as 'default' in the Kodama config files.\n"
+        + "safe: only optimizations that never change vanilla behavior.\n"
+        + "balanced: the recommended behavior.\n"
+        + "aggressive: prefers speed over matching vanilla statistics.\n"
+        + "Options you set explicitly always win over the preset.")
+    public Preset preset = Preset.BALANCED;
+
+    @Comment("Automatically disables a single Kodama feature when it keeps throwing exceptions. The server keeps running.")
+    public FeatureSafety featureSafety;
+
+    public class FeatureSafety extends ConfigurationPart {
+        @Comment("How many exceptions a feature may throw inside the window before it is disabled until the next /kodama reload.")
+        @Constraint(Constraints.Positive.class)
+        public int maxExceptions = 20;
+
+        @Comment("Length of the sliding window, in seconds, used to count exceptions.")
+        @Constraint(Constraints.Positive.class)
+        public int windowSeconds = 60;
+    }
+
+    @Comment("Chunk loading and chunk sending optimizations.")
+    public ChunkLoading chunkLoading;
+
+    public class ChunkLoading extends ConfigurationPart {
+        @Comment("Enables the chunk loading optimizations.")
+        public PresetBoolean enabled = PresetBoolean.of(false, true, true);
+    }
+
+    @Comment("Network and packet optimizations.")
+    public Network network;
+
+    public class Network extends ConfigurationPart {
+        @Comment("Enables the network optimizations.")
+        public PresetBoolean enabled = PresetBoolean.of(false, true, true);
+    }
+
+    @Comment("Background pre-caching of chunk data.")
+    public Precache precache;
+
+    public class Precache extends ConfigurationPart {
+        @Comment("Enables pre-caching.")
+        public PresetBoolean enabled = PresetBoolean.of(false, true, true);
+    }
+}
