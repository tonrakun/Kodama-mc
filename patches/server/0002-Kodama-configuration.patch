+package dev.kodama.config;
+
+import java.lang.reflect.Type;
+import java.util.List;
+import org.checkerframework.checker.nullness.qual.Nullable;
+import org.spongepowered.configurate.serialize.ScalarSerializer;
+import org.spongepowered.configurate.serialize.SerializationException;
+
+public final class PresetDouble extends PresetValue<Double> {
+
+    public static final ScalarSerializer<PresetDouble> SERIALIZER = new Serializer();
+
+    private PresetDouble(final @Nullable Double explicit, final @Nullable List<Double> defaults) {
+        super(explicit, defaults);
+    }
+
+    public static PresetDouble of(final double safe, final double balanced, final double aggressive) {
+        return new PresetDouble(null, List.of(safe, balanced, aggressive));
+    }
+
+    public double getAsDouble() {
+        return this.get();
+    }
+
+    private static final class Serializer extends PresetValue.Serializer<PresetDouble, Double> {
+        private Serializer() {
+            super(PresetDouble.class, explicit -> new PresetDouble(explicit, null));
+        }
+
+        @Override
+        protected Double parse(final Type type, final Object obj) throws SerializationException {
+            try {
+                final double value = obj instanceof Number number ? number.doubleValue() : Double.parseDouble(obj.toString().trim());
+                if (Double.isNaN(value) || Double.isInfinite(value)) {
+                    throw new SerializationException(PresetDouble.class, "'" + obj + "' is not a finite number");
+                }
+                return value;
+            } catch (final NumberFormatException ex) {
+                throw new SerializationException(PresetDouble.class, "'" + obj + "' is not a number or '" + DEFAULT_VALUE + "'");
+            }
+        }
+    }
+}
