new file mode 100644
index 0000000000000000000000000000000000000000..9b0ba9c0136579dc7e2e5ead09baf4cd544d87ef
--- /dev/null
+++ b/src/main/java/dev/kodama/config/YamlComments.java
@@ -0,0 +1,51 @@
+package dev.kodama.config;
+
+import java.io.IOException;
+import java.nio.charset.StandardCharsets;
+import java.nio.file.Files;
+import java.nio.file.Path;
+import java.util.ArrayList;
+import java.util.List;
+import java.util.Map;
+import java.util.regex.Matcher;
+import java.util.regex.Pattern;
+
+/**
+ * Writes the {@code @Comment} texts above the matching keys of a saved YAML file. Only block-style mappings with the
+ * two-space indent used by the Kodama loaders are handled.
+ */
+final class YamlComments {
+
+    private static final Pattern KEY = Pattern.compile("^( *)([A-Za-z0-9_.-]+):(?: .*)?$");
+    private static final int INDENT = 2;
+
+    private YamlComments() {
+    }
+
+    static void inject(final Path file, final Map<String, String> comments) throws IOException {
+        if (comments.isEmpty() || Files.notExists(file)) {
+            return;
+        }
+        final List<String> lines = Files.readAllLines(file, StandardCharsets.UTF_8);
+        final List<String> result = new ArrayList<>(lines.size() + comments.size());
+        final String[] pathAtDepth = new String[64];
+        for (final String line : lines) {
+            final Matcher matcher = KEY.matcher(line);
+            if (matcher.matches()) {
+                final int depth = matcher.group(1).length() / INDENT;
+                final String path = depth == 0 || depth >= pathAtDepth.length ? matcher.group(2) : pathAtDepth[depth - 1] + "." + matcher.group(2);
+                if (depth < pathAtDepth.length) {
+                    pathAtDepth[depth] = path;
+                }
+                final String comment = comments.get(path);
+                if (comment != null) {
+                    for (final String commentLine : comment.split("\n")) {
+                        result.add(matcher.group(1) + "# " + commentLine);
+                    }
+                }
+            }
+            result.add(line);
+        }
+        Files.writeString(file, String.join("\n", result) + "\n", StandardCharsets.UTF_8);
+    }
+}
diff --git a/src/main/java/dev/kodama/feature/FeatureGuard.java b/src/main/java/dev/kodama/feature/FeatureGuard.java
new file mode 100644
index 0000000000000000000000000000000000000000..65a23686db889038fd620ff28f9c1e9828a0b05b
--- /dev/null
+++ b/src/main/java/dev/kodama/feature/FeatureGuard.java
@@ -0,0 +1,146 @@
+package dev.kodama.feature;
+
+import com.mojang.logging.LogUtils;
+import dev.kodama.config.KodamaConfigurations;
+import dev.kodama.config.KodamaGlobalConfiguration;
+import java.util.ArrayDeque;
+import java.util.Map;
+import java.util.Set;
+import java.util.TreeSet;
+import java.util.concurrent.ConcurrentHashMap;
+import java.util.function.Supplier;
+import org.slf4j.Logger;
+
+/**
+ * Safety net for Kodama features: when a feature keeps throwing, only that feature is switched off (until the next
+ * {@code /kodama reload}) and callers fall back to the vanilla code path. The server keeps running.
+ * <p>
+ * Exceptions are counted in a sliding window configured by {@code feature-safety} in {@code kodama-global.yml}.
+ */
+public final class FeatureGuard {
+
+    private static final Logger LOGGER = LogUtils.getLogger();
+    private static final int LOGGED_STACK_TRACES = 3;
+    private static final int DEFAULT_MAX_EXCEPTIONS = 20;
+    private static final int DEFAULT_WINDOW_SECONDS = 60;
+
+    private static final Map<String, State> STATES = new ConcurrentHashMap<>();
+
+    private static final class State {
+        private final ArrayDeque<Long> failureNanos = new ArrayDeque<>(); // guarded by this
+        private int loggedTraces; // guarded by this
+        private volatile boolean tripped;
+    }
+
+    private FeatureGuard() {
+    }
+
+    public static boolean isTripped(final String featureId) {
+        final State state = STATES.get(featureId);
+        return state != null && state.tripped;
+    }
+
+    /**
+     * Ids of all features that are currently disabled by the guard, sorted.
+     */
+    public static Set<String> trippedFeatures() {
+        final Set<String> tripped = new TreeSet<>();
+        STATES.forEach((id, state) -> {
+            if (state.tripped) {
+                tripped.add(id);
+            }
+        });
+        return tripped;
+    }
+
+    /**
+     * Records an exception thrown by the given feature. Safe to call from any thread.
+     */
+    public static void reportFailure(final String featureId, final Throwable throwable) {
+        final State state = STATES.computeIfAbsent(featureId, id -> new State());
+        final int maxExceptions = maxExceptions();
+        final long windowNanos = windowSeconds() * 1_000_000_000L;
+        final long now = System.nanoTime();
+
+        final boolean logTrace;
+        final boolean trip;
+        final int count;
+        synchronized (state) {
+            logTrace = state.loggedTraces < LOGGED_STACK_TRACES;
+            if (logTrace) {
+                state.loggedTraces++;
+            }
+            state.failureNanos.addLast(now);
+            while (!state.failureNanos.isEmpty() && now - state.failureNanos.peekFirst() > windowNanos) {
+                state.failureNanos.removeFirst();
+            }
+            count = state.failureNanos.size();
+            trip = !state.tripped && count > maxExceptions;
+            if (trip) {
+                state.tripped = true;
+            }
+        }
+
+        if (logTrace) {
+            LOGGER.error("Kodama feature '{}' threw an exception", featureId, throwable);
+        } else {
+            LOGGER.debug("Kodama feature '{}' threw {}: {}", featureId, throwable.getClass().getName(), throwable.getMessage());
+        }
+        if (trip) {
+            LOGGER.warn("Kodama feature '{}' disabled after {} exceptions in {}s; server keeps running", featureId, count, windowSeconds());
+            try {
+                KodamaConfigurations.fireReloadListeners();
+            } catch (final Throwable listenerFailure) { // must never turn a handled feature failure into a new one
+                LOGGER.error("Could not notify the Kodama reload listeners about feature '{}'", featureId, listenerFailure);
+            }
+        }
+    }
+
+    /**
+     * Runs {@code fast}; if it throws, the failure is recorded and {@code vanillaFallback} is used instead. A feature
+     * that was disabled by the guard goes straight to the fallback.
+     */
+    public static <T> T call(final String featureId, final Supplier<T> fast, final Supplier<T> vanillaFallback) {
+        if (isTripped(featureId)) {
+            return vanillaFallback.get();
+        }
+        try {
+            return fast.get();
+        } catch (final VirtualMachineError error) {
+            throw error;
+        } catch (final Throwable throwable) {
+            reportFailure(featureId, throwable);
+            return vanillaFallback.get();
+        }
+    }
+
+    /**
+     * Same as {@link #call(String, Supplier, Supplier)} for code without a result.
+     */
+    public static void run(final String featureId, final Runnable fast, final Runnable vanillaFallback) {
+        call(featureId, () -> {
+            fast.run();
+            return null;
+        }, () -> {
+            vanillaFallback.run();
+            return null;
+        });
+    }
+
+    /**
+     * Clears the failure history and re-enables every feature; called by {@code /kodama reload}.
+     */
+    public static void resetAll() {
+        STATES.clear();
+    }
+
+    private static int maxExceptions() {
+        final KodamaGlobalConfiguration config = KodamaGlobalConfiguration.get();
+        return config == null || config.featureSafety == null ? DEFAULT_MAX_EXCEPTIONS : config.featureSafety.maxExceptions;
+    }
+
+    private static int windowSeconds() {
+        final KodamaGlobalConfiguration config = KodamaGlobalConfiguration.get();
+        return config == null || config.featureSafety == null ? DEFAULT_WINDOW_SECONDS : config.featureSafety.windowSeconds;
+    }
+}
