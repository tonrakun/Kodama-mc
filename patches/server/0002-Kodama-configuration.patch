+package dev.kodama.config;
+
+import java.util.Locale;
+
+/**
+ * Global preset that decides the value of every {@link PresetValue} the user has not set explicitly.
+ */
+public enum Preset {
+    /** Only optimizations that never change vanilla behavior. */
+    SAFE,
+    /** The default: the behavior described in the design document. */
+    BALANCED,
+    /** Prefers speed over statistical equality with vanilla. */
+    AGGRESSIVE;
+
+    public String key() {
+        return this.name().toLowerCase(Locale.ROOT);
+    }
+
+    public static Preset current() {
+        return KodamaGlobalConfiguration.currentPreset();
+    }
+}
