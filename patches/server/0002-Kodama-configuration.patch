new file mode 100644
index 0000000000000000000000000000000000000000..34aee1ec01ceb9a27cf997ff54fac2ebd2380c20
--- /dev/null
+++ b/src/main/java/dev/kodama/config/ConfigReloadException.java
@@ -0,0 +1,15 @@
+package dev.kodama.config;
+
+/**
+ * Thrown when a config file could not be loaded or failed validation. The previous configuration stays active.
+ */
+public final class ConfigReloadException extends Exception {
+
+    public ConfigReloadException(final String message, final Throwable cause) {
+        super(message, cause);
+    }
+
+    public ConfigReloadException(final String message) {
+        super(message);
+    }
+}
diff --git a/src/main/java/dev/kodama/config/ConfigSchema.java b/src/main/java/dev/kodama/config/ConfigSchema.java
new file mode 100644
index 0000000000000000000000000000000000000000..b07696ca1d3903839c13448e3b97b40003748a80
--- /dev/null
+++ b/src/main/java/dev/kodama/config/ConfigSchema.java
@@ -0,0 +1,152 @@
+package dev.kodama.config;
+
+import io.papermc.paper.configuration.ConfigurationPart;
+import java.lang.reflect.Field;
+import java.lang.reflect.Modifier;
+import java.util.ArrayList;
+import java.util.Collections;
+import java.util.LinkedHashMap;
+import java.util.List;
+import java.util.Locale;
+import java.util.Map;
+import org.checkerframework.checker.nullness.qual.Nullable;
+import org.spongepowered.configurate.objectmapping.meta.Comment;
+import org.spongepowered.configurate.objectmapping.meta.Setting;
+
+/**
+ * Describes the option tree of a config class (dotted paths, types, comments, reload class) by reflection, so the
+ * command can complete and validate paths without knowing the individual options.
+ */
+public final class ConfigSchema {
+
+    public static final ConfigSchema GLOBAL = ConfigSchema.of(KodamaGlobalConfiguration.class);
+    public static final ConfigSchema WORLD = ConfigSchema.of(KodamaWorldConfiguration.class);
+
+    public record Option(String path, List<Field> chain, Field field, @Nullable String comment, ReloadClass reloadClass) {
+
+        public Class<?> valueType() {
+            return this.field.getType();
+        }
+
+        /**
+         * Reads the current value of this option from an instance of the schema's root class.
+         */
+        public @Nullable Object read(final Object root) {
+            Object current = root;
+            try {
+                for (final Field step : this.chain) {
+                    if (current == null) {
+                        return null;
+                    }
+                    current = step.get(current);
+                }
+            } catch (final IllegalAccessException e) {
+                throw new IllegalStateException("Cannot read " + this.path, e);
+            }
+            return current;
+        }
+    }
+
+    private final List<Option> options;
+    private final Map<String, String> comments;
+
+    private ConfigSchema(final List<Option> options, final Map<String, String> comments) {
+        this.options = Collections.unmodifiableList(options);
+        this.comments = Collections.unmodifiableMap(comments);
+    }
+
+    /**
+     * The {@code @Comment} text of every option and section, by dotted path.
+     */
+    public Map<String, String> comments() {
+        return this.comments;
+    }
+
+    public List<Option> options() {
+        return this.options;
+    }
+
+    public @Nullable Option find(final String path) {
+        for (final Option option : this.options) {
+            if (option.path().equals(path)) {
+                return option;
+            }
+        }
+        return null;
+    }
+
+    /**
+     * All options at or below the given path (an option itself, or a section).
+     */
+    public List<Option> under(final String path) {
+        final List<Option> result = new ArrayList<>();
+        for (final Option option : this.options) {
+            if (option.path().equals(path) || option.path().startsWith(path + ".")) {
+                result.add(option);
+            }
+        }
+        return result;
+    }
+
+    public static ConfigSchema of(final Class<? extends ConfigurationPart> root) {
+        final List<Option> options = new ArrayList<>();
+        final Map<String, String> comments = new LinkedHashMap<>();
+        walk(root, "", new ArrayList<>(), options, comments);
+        return new ConfigSchema(options, comments);
+    }
+
+    private static void walk(final Class<?> type, final String prefix, final List<Field> chain, final List<Option> out, final Map<String, String> comments) {
+        for (final Field field : type.getDeclaredFields()) {
+            final int modifiers = field.getModifiers();
+            if (field.isSynthetic() || Modifier.isStatic(modifiers) || Modifier.isTransient(modifiers)) {
+                continue;
+            }
+            final String name = keyOf(field);
+            if (name.startsWith("_")) { // the version field
+                continue;
+            }
+            field.setAccessible(true);
+            final List<Field> path = new ArrayList<>(chain);
+            path.add(field);
+            final String dotted = prefix.isEmpty() ? name : prefix + "." + name;
+            final Comment comment = field.getAnnotation(Comment.class);
+            if (comment != null) {
+                comments.put(dotted, comment.value());
+            }
+            if (ConfigurationPart.class.isAssignableFrom(field.getType())) {
+                walk(field.getType(), dotted, path, out, comments);
+            } else {
+                final ReloadClass reloadClass = field.isAnnotationPresent(RestartRequired.class) ? ReloadClass.RESTART_REQUIRED
+                    : field.isAnnotationPresent(Staged.class) ? ReloadClass.STAGED : ReloadClass.IMMEDIATE;
+                out.add(new Option(dotted, List.copyOf(path), field, comment == null ? null : comment.value(), reloadClass));
+            }
+        }
+    }
+
+    private static String keyOf(final Field field) {
+        final Setting setting = field.getAnnotation(Setting.class);
+        if (setting != null && !setting.value().isEmpty()) {
+            return setting.value();
+        }
+        return kebabCase(field.getName());
+    }
+
+    /**
+     * Matches Configurate's lower-case dashed naming scheme, which the config mapper uses for field names.
+     */
+    static String kebabCase(final String name) {
+        final StringBuilder builder = new StringBuilder(name.length() + 4);
+        for (int i = 0; i < name.length(); i++) {
+            final char c = name.charAt(i);
+            if (Character.isUpperCase(c)) {
+                if (i > 0) {
+                    builder.append('-');
+                }
+                builder.append(Character.toLowerCase(c));
+            } else {
+                builder.append(c);
+            }
+        }
+        return builder.toString().toLowerCase(Locale.ROOT);
+    }
+}
diff --git a/src/main/java/dev/kodama/config/ConfigTarget.java b/src/main/java/dev/kodama/config/ConfigTarget.java
new file mode 100644
index 0000000000000000000000000000000000000000..348e51b00edec6325ef770ade4cdde216536ef4e
--- /dev/null
+++ b/src/main/java/dev/kodama/config/ConfigTarget.java
@@ -0,0 +1,37 @@
+package dev.kodama.config;
+
+import org.checkerframework.checker.nullness.qual.Nullable;
+
+/**
+ * One Kodama config file: the global file, the world defaults, or the override file of a single world.
+ */
+public record ConfigTarget(Scope scope, @Nullable String worldName) {
+
+    public enum Scope {
+        GLOBAL,
+        WORLD_DEFAULTS,
+        WORLD
+    }
+
+    public static final ConfigTarget GLOBAL = new ConfigTarget(Scope.GLOBAL, null);
+    public static final ConfigTarget WORLD_DEFAULTS = new ConfigTarget(Scope.WORLD_DEFAULTS, null);
+
+    public static ConfigTarget world(final String worldName) {
+        return new ConfigTarget(Scope.WORLD, worldName);
+    }
+
+    public ConfigSchema schema() {
+        return this.scope == Scope.GLOBAL ? ConfigSchema.GLOBAL : ConfigSchema.WORLD;
+    }
+
+    /**
+     * File name as shown to users and written to the change log.
+     */
+    public String fileName() {
+        return switch (this.scope) {
+            case GLOBAL -> KodamaConfigurations.CONFIG_DIR + "/" + KodamaConfigurations.GLOBAL_CONFIG_FILE_NAME;
+            case WORLD_DEFAULTS -> KodamaConfigurations.CONFIG_DIR + "/" + KodamaConfigurations.WORLD_DEFAULTS_CONFIG_FILE_NAME;
+            case WORLD -> this.worldName + "/" + KodamaConfigurations.WORLD_CONFIG_FILE_NAME;
+        };
+    }
+}
diff --git a/src/main/java/dev/kodama/config/KodamaConfigurations.java b/src/main/java/dev/kodama/config/KodamaConfigurations.java
new file mode 100644
index 0000000000000000000000000000000000000000..496e489935184ce1026bd6a104f14620ca65d7fd
--- /dev/null
+++ b/src/main/java/dev/kodama/config/KodamaConfigurations.java
@@ -0,0 +1,609 @@
+package dev.kodama.config;
+
+import com.mojang.logging.LogUtils;
+import dev.kodama.feature.FeatureGuard;
+import io.papermc.paper.configuration.Configuration;
+import io.papermc.paper.configuration.ConfigurationPart;
+import io.papermc.paper.configuration.Configurations;
+import io.papermc.paper.configuration.PaperConfigurations;
+import io.papermc.paper.configuration.mapping.InnerClassFieldDiscoverer;
+import java.io.IOException;
+import java.lang.reflect.Field;
+import java.lang.reflect.Modifier;
+import java.lang.reflect.Type;
+import java.nio.file.Files;
+import java.nio.file.Path;
+import java.util.ArrayList;
+import java.util.Arrays;
+import java.util.HashSet;
+import java.util.LinkedHashMap;
+import java.util.LinkedHashSet;
+import java.util.List;
+import java.util.Map;
+import java.util.Set;
+import java.util.concurrent.CopyOnWriteArrayList;
+import java.util.function.Function;
+import net.minecraft.core.RegistryAccess;
+import net.minecraft.server.MinecraftServer;
+import net.minecraft.server.level.ServerLevel;
+import org.checkerframework.checker.nullness.qual.Nullable;
+import org.slf4j.Logger;
+import org.spongepowered.configurate.ConfigurateException;
+import org.spongepowered.configurate.ConfigurationNode;
+import org.spongepowered.configurate.ConfigurationOptions;
+import org.spongepowered.configurate.NodePath;
+import org.spongepowered.configurate.objectmapping.ObjectMapper;
+import org.spongepowered.configurate.transformation.ConfigurationTransformation;
+import org.spongepowered.configurate.transformation.TransformAction;
+import org.spongepowered.configurate.serialize.SerializationException;
+import org.spongepowered.configurate.util.CheckedConsumer;
+import org.spongepowered.configurate.yaml.YamlConfigurationLoader;
+
+import static io.leangen.geantyref.GenericTypeReflector.erase;
+
+/**
+ * Loads, validates and hot-reloads {@code kodama-global.yml}, {@code kodama-world-defaults.yml} and the per-world
+ * {@code kodama-world.yml}. A reload loads every file into fresh objects first and only swaps them in when all of them
+ * are valid, so a broken file never replaces a working configuration.
+ */
+public class KodamaConfigurations extends Configurations<KodamaGlobalConfiguration, KodamaWorldConfiguration> {
+
+    private static final Logger LOGGER = LogUtils.getLogger();
+    public static final String GLOBAL_CONFIG_FILE_NAME = "kodama-global.yml";
+    public static final String WORLD_DEFAULTS_CONFIG_FILE_NAME = "kodama-world-defaults.yml";
+    public static final String WORLD_CONFIG_FILE_NAME = "kodama-world.yml";
+    public static final String CONFIG_DIR = "config";
+
+    private static final List<Runnable> RELOAD_LISTENERS = new CopyOnWriteArrayList<>();
+
+    private static final String GLOBAL_HEADER = String.format("""
+            This is the global configuration file for Kodama.
+            Every feature has an 'enabled' option. Options set to 'default' follow the
+            active preset (safe, balanced or aggressive); write an explicit value to override it.
+
+            The world configuration options are inside the world defaults file (%s)
+            and can be overridden per world in the file named %s inside each world folder.
+
+            Changes can be applied without a restart with /kodama reload,
+            or edited in game with /kodama config set <path> <value>.""", WORLD_DEFAULTS_CONFIG_FILE_NAME, WORLD_CONFIG_FILE_NAME);
+
+    private static final String WORLD_DEFAULTS_HEADER = """
+            This is the world defaults configuration file for Kodama.
+            Every feature has an 'enabled' option. Options set to 'default' follow the
+            preset chosen in kodama-global.yml; write an explicit value to override it.
+
+            Configuration options here apply to all worlds, unless you specify overrides inside
+            the world-specific config file inside each world folder.""";
+
+    private static final Function<ContextMap, String> WORLD_HEADER = map -> String.format("""
+        This is a world configuration file for Kodama.
+        This file may start empty but can be filled with settings to override ones in the %s/%s
+
+        World: %s (%s)""",
+        CONFIG_DIR,
+        WORLD_DEFAULTS_CONFIG_FILE_NAME,
+        map.require(WORLD_NAME),
+        map.require(WORLD_KEY)
+    );
+
+    /**
+     * Result of a successful reload.
+     *
+     * @param pendingRestart options (with the world name for world options) whose value changed but only take effect
+     *                       after a restart
+     */
+    public record ReloadReport(List<String> pendingRestart) {
+    }
+
+    /**
+     * Result of editing one option.
+     *
+     * @param oldRaw   the raw value that was in the file before ({@code null} when the key was not in the file)
+     * @param newRaw   the raw value written ({@code null} when the key was removed)
+     * @param oldValue the resolved value before the edit
+     * @param newValue the resolved value after the edit
+     */
+    public record EditOutcome(@Nullable Object oldRaw, @Nullable Object newRaw, @Nullable Object oldValue, @Nullable Object newValue) {
+    }
+
+    public KodamaConfigurations(final Path globalFolder) {
+        super(globalFolder, KodamaGlobalConfiguration.class, KodamaWorldConfiguration.class, GLOBAL_CONFIG_FILE_NAME, WORLD_DEFAULTS_CONFIG_FILE_NAME, WORLD_CONFIG_FILE_NAME);
+    }
+
+    public static KodamaConfigurations setup(final Path configDir) throws Exception {
+        try {
+            PaperConfigurations.createDirectoriesSymlinkAware(configDir);
+            return new KodamaConfigurations(configDir);
+        } catch (final IOException ex) {
+            throw new RuntimeException("Could not setup KodamaConfigurations", ex);
+        }
+    }
+
+    // reload listeners
+
+    /**
+     * Registers a hook that runs on the main thread after every successful reload, config edit and automatic feature
+     * shutdown, so staged features can move to their new state.
+     */
+    public static void addReloadListener(final Runnable listener) {
+        RELOAD_LISTENERS.add(listener);
+    }
+
+    public static void removeReloadListener(final Runnable listener) {
+        RELOAD_LISTENERS.remove(listener);
+    }
+
+    /**
+     * Runs the reload listeners on the main thread (immediately when already on it).
+     */
+    public static void fireReloadListeners() {
+        final Runnable fire = () -> {
+            for (final Runnable listener : RELOAD_LISTENERS) {
+                try {
+                    listener.run();
+                } catch (final Throwable throwable) {
+                    LOGGER.error("A Kodama reload listener failed", throwable);
+                }
+            }
+        };
+        final MinecraftServer server = MinecraftServer.getServer();
+        if (server == null || server.isSameThread()) {
+            fire.run();
+        } else {
+            server.execute(fire);
+        }
+    }
+
+    // loader setup
+
+    @Override
+    protected YamlConfigurationLoader.Builder createLoaderBuilder() {
+        return super.createLoaderBuilder()
+            .defaultOptions(KodamaConfigurations::defaultOptions);
+    }
+
+    private static ConfigurationOptions defaultOptions(final ConfigurationOptions options) {
+        return options.serializers(builder -> builder
+            .register(new KodamaEnumSerializer())
+            .register(PresetBoolean.SERIALIZER)
+            .register(PresetInt.SERIALIZER)
+            .register(PresetDouble.SERIALIZER)
+        );
+    }
+
+    @Override
+    protected ObjectMapper.Factory.Builder createGlobalObjectMapperFactoryBuilder() {
+        return super.createGlobalObjectMapperFactoryBuilder().addDiscoverer(InnerClassFieldDiscoverer.globalConfig());
+    }
+
+    @Override
+    protected YamlConfigurationLoader.Builder createGlobalLoaderBuilder() {
+        return super.createGlobalLoaderBuilder()
+            .defaultOptions(options -> options.header(GLOBAL_HEADER));
+    }
+
+    @Override
+    protected ObjectMapper.Factory.Builder createWorldObjectMapperFactoryBuilder(final ContextMap contextMap) {
+        return super.createWorldObjectMapperFactoryBuilder(contextMap)
+            .addDiscoverer(InnerClassFieldDiscoverer.kodamaWorldConfig(contextMap));
+    }
+
+    @Override
+    protected YamlConfigurationLoader.Builder createWorldConfigLoaderBuilder(final ContextMap contextMap) {
+        return super.createWorldConfigLoaderBuilder(contextMap)
+            .defaultOptions(options -> options
+                .header(contextMap.require(WORLD_NAME).equals(WORLD_DEFAULTS) ? WORLD_DEFAULTS_HEADER : WORLD_HEADER.apply(contextMap)));
+    }
+
+    @Override
+    protected boolean isConfigType(final Type type) {
+        return ConfigurationPart.class.isAssignableFrom(erase(type));
+    }
+
+    @Override
+    protected int globalConfigVersion() {
+        return KodamaGlobalConfiguration.CURRENT_VERSION;
+    }
+
+    @Override
+    protected int worldConfigVersion() {
+        return KodamaWorldConfiguration.CURRENT_VERSION;
+    }
+
+    @Override
+    protected void applyWorldConfigTransformations(final ContextMap contextMap, final ConfigurationNode node, final @Nullable ConfigurationNode defaultsNode) throws ConfigurateException {
+        removePaths(node, KodamaRemovedConfigurations.REMOVED_WORLD_PATHS);
+    }
+
+    @Override
+    protected void applyGlobalConfigTransformations(final ConfigurationNode node) throws ConfigurateException {
+        removePaths(node, KodamaRemovedConfigurations.REMOVED_GLOBAL_PATHS);
+    }
+
+    private static void removePaths(final ConfigurationNode node, final NodePath[] paths) throws ConfigurateException {
+        if (paths.length == 0) {
+            return;
+        }
+        final ConfigurationTransformation.Builder builder = ConfigurationTransformation.builder();
+        for (final NodePath path : paths) {
+            builder.addAction(path, TransformAction.remove());
+        }
+        builder.build().apply(node);
+    }
+
+    /**
+     * Configurate's YAML loader cannot write {@code @Comment} texts, so they are added to the saved file afterwards.
+     */
+    @Override
+    protected void trySaveFileNode(final YamlConfigurationLoader loader, final ConfigurationNode node, final String filename) throws ConfigurateException {
+        super.trySaveFileNode(loader, node, filename);
+        try {
+            final ConfigSchema schema = filename.endsWith(GLOBAL_CONFIG_FILE_NAME) ? ConfigSchema.GLOBAL : ConfigSchema.WORLD;
+            YamlComments.inject(Path.of(filename), schema.comments());
+        } catch (final IOException exception) {
+            LOGGER.warn("Could not add the comments to {}", filename, exception);
+        }
+    }
+
+    // startup loading
+
+    @Override
+    public KodamaGlobalConfiguration initializeGlobalConfiguration(final RegistryAccess registryAccess) throws ConfigurateException {
+        final KodamaGlobalConfiguration configuration = this.loadGlobal(null);
+        KodamaGlobalConfiguration.set(configuration);
+        return configuration;
+    }
+
+    @Override
+    public void initializeWorldDefaultsConfiguration(final RegistryAccess registryAccess) throws ConfigurateException {
+        this.loadWorldDefaults(registryAccess, null, true);
+    }
+
+    @Override
+    public KodamaWorldConfiguration createWorldConfig(final ContextMap contextMap) {
+        final String levelName = contextMap.require(WORLD_NAME);
+        try {
+            return this.loadWorldOverride(contextMap, null, true);
+        } catch (final IOException exception) {
+            throw new RuntimeException("Could not create Kodama world config for " + levelName, exception);
+        }
+    }
+
+    // fresh loading: every call builds new loaders and therefore new config objects
+
+    private KodamaGlobalConfiguration loadGlobal(final @Nullable CheckedConsumer<ConfigurationNode, SerializationException> mutator) throws ConfigurateException {
+        return this.initializeGlobalConfiguration(node -> {
+            if (mutator != null) {
+                mutator.accept(node);
+            }
+            final KodamaGlobalConfiguration instance = node.require(KodamaGlobalConfiguration.class);
+            node.set(KodamaGlobalConfiguration.class, instance);
+            return instance;
+        });
+    }
+
+    private KodamaWorldConfiguration loadWorldDefaults(final RegistryAccess registryAccess, final @Nullable CheckedConsumer<ConfigurationNode, SerializationException> mutator, final boolean save) throws ConfigurateException {
+        final ContextMap contextMap = this.createDefaultContextMap(registryAccess).put(FIRST_DEFAULT).build();
+        final Path configFile = this.globalFolder.resolve(this.defaultWorldConfigFileName);
+        final boolean newFile = Files.notExists(configFile);
+        final YamlConfigurationLoader loader = this.createWorldConfigLoaderBuilder(contextMap)
+            .defaultOptions(this.applyObjectMapperFactory(this.createWorldObjectMapperFactoryBuilder(contextMap).build()))
+            .path(configFile)
+            .build();
+        final ConfigurationNode node = loader.load();
+        if (newFile) {
+            node.node(Configuration.VERSION_FIELD).raw(this.worldConfigVersion());
+        } else {
+            this.verifyWorldConfigVersion(contextMap, node);
+        }
+        this.applyWorldConfigTransformations(contextMap, node, null);
+        if (mutator != null) {
+            mutator.accept(node);
+        }
+        final KodamaWorldConfiguration instance = node.require(this.worldConfigClass);
+        if (save) {
+            node.set(this.worldConfigClass, instance);
+            this.trySaveFileNode(loader, node, configFile.toString());
+        }
+        return instance;
+    }
+
+    private KodamaWorldConfiguration loadWorldOverride(final ContextMap contextMap, final @Nullable CheckedConsumer<ConfigurationNode, SerializationException> mutator, final boolean save) throws IOException {
+        final ContextMap defaultsContext = this.createDefaultContextMap(contextMap.require(REGISTRY_ACCESS)).build();
+        final Path defaultsFile = this.globalFolder.resolve(this.defaultWorldConfigFileName);
+        final ConfigurationNode defaultsNode = this.createWorldConfigLoaderBuilder(defaultsContext)
+            .defaultOptions(this.applyObjectMapperFactory(this.createWorldObjectMapperFactoryBuilder(defaultsContext).build()))
+            .path(defaultsFile)
+            .build()
+            .load();
+
+        final Path worldDirectory = contextMap.require(WORLD_DIRECTORY);
+        final Path worldConfigFile = worldDirectory.resolve(this.worldConfigFileName);
+        boolean newFile = false;
+        if (Files.notExists(worldConfigFile)) {
+            if (save) {
+                PaperConfigurations.createDirectoriesSymlinkAware(worldDirectory);
+                Files.createFile(worldConfigFile);
+            }
+            newFile = true;
+        }
+        final YamlConfigurationLoader worldLoader = this.createWorldConfigLoaderBuilder(contextMap)
+            .defaultOptions(this.applyObjectMapperFactory(this.createWorldObjectMapperFactoryBuilder(contextMap).build()))
+            .path(worldConfigFile)
+            .build();
+        final ConfigurationNode worldNode = worldLoader.load();
+        if (newFile) {
+            worldNode.node(Configuration.VERSION_FIELD).set(this.worldConfigVersion());
+        } else {
+            this.verifyWorldConfigVersion(contextMap, worldNode);
+        }
+        this.applyWorldConfigTransformations(contextMap, worldNode, defaultsNode);
+        this.applyDefaultsAwareWorldConfigTransformations(contextMap, worldNode, defaultsNode);
+        if (mutator != null) {
+            mutator.accept(worldNode);
+        }
+        final ConfigurationNode merged = worldNode.copy(); // the node that is saved must stay free of the defaults
+        merged.mergeFrom(defaultsNode);
+        final KodamaWorldConfiguration instance = merged.require(this.worldConfigClass);
+        if (save) {
+            this.trySaveFileNode(worldLoader, worldNode, worldConfigFile.toString());
+        }
+        return instance;
+    }
+
+    // reload
+
+    /**
+     * Reloads all Kodama configs (global, world defaults, every world). Must be called on the main thread, which is
+     * between two ticks.
+     *
+     * @throws ConfigReloadException when any file fails to load or validate; nothing has been changed in that case
+     */
+    public ReloadReport reloadAll(final MinecraftServer server, final boolean resetFeatureGuard) throws ConfigReloadException {
+        requireMainThread(server);
+        final KodamaGlobalConfiguration global;
+        try {
+            global = this.initializeGlobalConfiguration(node -> node.require(KodamaGlobalConfiguration.class));
+        } catch (final Exception exception) {
+            throw failure(ConfigTarget.GLOBAL.fileName(), exception);
+        }
+        final Map<ServerLevel, KodamaWorldConfiguration> worlds = this.prepareWorlds(server);
+
+        final Set<String> before = restartSnapshot(server);
+        KodamaGlobalConfiguration.set(global);
+        applyWorlds(worlds);
+        final Set<String> after = restartSnapshot(server);
+
+        if (resetFeatureGuard) {
+            FeatureGuard.resetAll();
+        }
+        this.saveAllQuietly(server);
+        fireReloadListeners();
+
+        final Set<String> changed = new LinkedHashSet<>(after);
+        changed.removeAll(before);
+        final List<String> pending = new ArrayList<>();
+        for (final String entry : changed) {
+            pending.add(entry.substring(0, entry.lastIndexOf('=')));
+        }
+        return new ReloadReport(pending);
+    }
+
+    /**
+     * Used by the Bukkit {@code /reload}; a failing reload keeps the old configuration and is only logged.
+     */
+    public void reloadQuietly(final MinecraftServer server) {
+        try {
+            this.reloadAll(server, false);
+        } catch (final ConfigReloadException exception) {
+            LOGGER.error("Could not reload the Kodama configuration, keeping the previous one: {}", exception.getMessage(), exception.getCause());
+        }
+    }
+
+    private Map<ServerLevel, KodamaWorldConfiguration> prepareWorlds(final MinecraftServer server) throws ConfigReloadException {
+        try {
+            this.loadWorldDefaults(server.registryAccess(), null, false);
+        } catch (final Exception exception) {
+            throw failure(ConfigTarget.WORLD_DEFAULTS.fileName(), exception);
+        }
+        final Map<ServerLevel, KodamaWorldConfiguration> worlds = new LinkedHashMap<>();
+        for (final ServerLevel level : server.getAllLevels()) {
+            try {
+                worlds.put(level, this.loadWorldOverride(PaperConfigurations.createWorldContextMap(level), null, false));
+            } catch (final Exception exception) {
+                throw failure(level.getWorld().getName() + "/" + WORLD_CONFIG_FILE_NAME, exception);
+            }
+        }
+        return worlds;
+    }
+
+    private static void applyWorlds(final Map<ServerLevel, KodamaWorldConfiguration> worlds) {
+        for (final Map.Entry<ServerLevel, KodamaWorldConfiguration> entry : worlds.entrySet()) {
+            copyFields(entry.getValue(), entry.getKey().kodamaConfig());
+        }
+    }
+
+    /**
+     * Rewrites the files so options added since the last start show up with their comments, like Paper does.
+     */
+    private void saveAllQuietly(final MinecraftServer server) {
+        try {
+            this.loadGlobal(null);
+            this.loadWorldDefaults(server.registryAccess(), null, true);
+            for (final ServerLevel level : server.getAllLevels()) {
+                this.loadWorldOverride(PaperConfigurations.createWorldContextMap(level), null, true);
+            }
+        } catch (final Exception exception) {
+            LOGGER.warn("Could not rewrite the Kodama config files after reload", exception);
+        }
+    }
+
+    // editing
+
+    /**
+     * Writes one option into a config file and reloads that config in place. The file is only written when the
+     * resulting config is valid.
+     *
+     * @param newRaw the raw value to write, or {@code null} to remove the key from the file
+     */
+    public EditOutcome edit(final MinecraftServer server, final ConfigTarget target, final ConfigSchema.Option option, final @Nullable Object newRaw) throws ConfigReloadException {
+        requireMainThread(server);
+        final String[] segments = option.path().split("\\.");
+        final Object[] oldRaw = new Object[1];
+        final CheckedConsumer<ConfigurationNode, SerializationException> mutator = node -> {
+            final ConfigurationNode leaf = node.node((Object[]) segments);
+            oldRaw[0] = leaf.virtual() ? null : leaf.raw();
+            leaf.raw(newRaw);
+            for (int depth = segments.length - 1; newRaw == null && depth > 0; depth--) { // do not leave empty sections behind
+                final ConfigurationNode parent = node.node((Object[]) Arrays.copyOf(segments, depth));
+                if (!parent.childrenMap().isEmpty()) {
+                    break;
+                }
+                parent.raw(null);
+            }
+        };
+        final Object oldValue;
+        final Object newValue;
+        switch (target.scope()) {
+            case GLOBAL -> {
+                oldValue = option.read(KodamaGlobalConfiguration.get());
+                final KodamaGlobalConfiguration fresh;
+                try {
+                    fresh = this.loadGlobal(mutator);
+                } catch (final Exception exception) {
+                    throw failure(target.fileName(), exception);
+                }
+                KodamaGlobalConfiguration.set(fresh);
+                newValue = option.read(fresh);
+            }
+            case WORLD_DEFAULTS -> {
+                final KodamaWorldConfiguration fresh;
+                try {
+                    oldValue = option.read(this.loadWorldDefaults(server.registryAccess(), null, false));
+                    fresh = this.loadWorldDefaults(server.registryAccess(), mutator, true);
+                } catch (final Exception exception) {
+                    throw failure(target.fileName(), exception);
+                }
+                newValue = option.read(fresh);
+                applyWorlds(this.prepareWorlds(server)); // every world inherits from the defaults
+            }
+            case WORLD -> {
+                final ServerLevel level = levelByName(server, target.worldName());
+                if (level == null) {
+                    throw new ConfigReloadException("World '" + target.worldName() + "' is not loaded");
+                }
+                oldValue = option.read(level.kodamaConfig());
+                final KodamaWorldConfiguration fresh;
+                try {
+                    fresh = this.loadWorldOverride(PaperConfigurations.createWorldContextMap(level), mutator, true);
+                } catch (final Exception exception) {
+                    throw failure(target.fileName(), exception);
+                }
+                copyFields(fresh, level.kodamaConfig());
+                newValue = option.read(level.kodamaConfig());
+            }
+            default -> throw new IllegalStateException();
+        }
+        fireReloadListeners();
+        return new EditOutcome(oldRaw[0], newRaw, oldValue, newValue);
+    }
+
+    /**
+     * The current resolved value of an option as the running server sees it; for the world defaults this reads the
+     * file, because no live object exists for them.
+     */
+    public @Nullable Object currentValue(final MinecraftServer server, final ConfigTarget target, final ConfigSchema.Option option) throws ConfigReloadException {
+        switch (target.scope()) {
+            case GLOBAL -> {
+                return option.read(KodamaGlobalConfiguration.get());
+            }
+            case WORLD_DEFAULTS -> {
+                try {
+                    return option.read(this.loadWorldDefaults(server.registryAccess(), null, false));
+                } catch (final Exception exception) {
+                    throw failure(target.fileName(), exception);
+                }
+            }
+            default -> {
+                final ServerLevel level = levelByName(server, target.worldName());
+                if (level == null) {
+                    throw new ConfigReloadException("World '" + target.worldName() + "' is not loaded");
+                }
+                return option.read(level.kodamaConfig());
+            }
+        }
+    }
+
+    public static @Nullable ServerLevel levelByName(final MinecraftServer server, final @Nullable String name) {
+        for (final ServerLevel level : server.getAllLevels()) {
+            if (level.getWorld().getName().equals(name)) {
+                return level;
+            }
+        }
+        return null;
+    }
+
+    // helpers
+
+    /**
+     * Snapshot of all restart-required options, as {@code "<path>[ (world X)]=<value>"} entries.
+     */
+    private static Set<String> restartSnapshot(final MinecraftServer server) {
+        final Set<String> snapshot = new HashSet<>();
+        for (final ConfigSchema.Option option : ConfigSchema.GLOBAL.options()) {
+            if (option.reloadClass() == ReloadClass.RESTART_REQUIRED) {
+                snapshot.add(option.path() + "=" + option.read(KodamaGlobalConfiguration.get()));
+            }
+        }
+        for (final ServerLevel level : server.getAllLevels()) {
+            for (final ConfigSchema.Option option : ConfigSchema.WORLD.options()) {
+                if (option.reloadClass() == ReloadClass.RESTART_REQUIRED) {
+                    snapshot.add(option.path() + " (world " + level.getWorld().getName() + ")=" + option.read(level.kodamaConfig()));
+                }
+            }
+        }
+        return snapshot;
+    }
+
+    private static void copyFields(final Object from, final Object to) {
+        for (Class<?> type = from.getClass(); type != null && type != Object.class; type = type.getSuperclass()) {
+            for (final Field field : type.getDeclaredFields()) {
+                final int modifiers = field.getModifiers();
+                if (field.isSynthetic() || Modifier.isStatic(modifiers) || Modifier.isFinal(modifiers) || Modifier.isTransient(modifiers)) {
+                    continue;
+                }
+                try {
+                    field.setAccessible(true);
+                    field.set(to, field.get(from));
+                } catch (final IllegalAccessException e) {
+                    throw new IllegalStateException("Cannot copy " + field, e);
+                }
+            }
+        }
+    }
+
+    private static void requireMainThread(final MinecraftServer server) {
+        if (!server.isSameThread()) {
+            throw new IllegalStateException("Kodama configs may only be reloaded or edited on the main thread");
+        }
+    }
+
+    private static ConfigReloadException failure(final String file, final Throwable throwable) {
+        return new ConfigReloadException(file + ": " + describe(throwable), throwable);
+    }
+
+    /**
+     * Joins the distinct messages of a cause chain; Configurate wraps the useful part (for example a violated
+     * constraint) several levels deep.
+     */
+    public static String describe(final Throwable throwable) {
+        final Set<String> messages = new LinkedHashSet<>();
+        for (Throwable current = throwable; current != null; current = current.getCause()) {
+            final String message = current.getMessage();
+            if (message != null && !message.isBlank()) {
+                messages.add(message.strip().replace('\n', ' '));
+            }
+        }
+        return messages.isEmpty() ? throwable.getClass().getSimpleName() : String.join(" / ", messages);
+    }
+}
