@@ -0,0 +1,77 @@
+package dev.kodama.command.subcommands;
+
+import dev.kodama.chunk.precache.PrecacheManager;
+import dev.kodama.command.Completions;
+import dev.kodama.command.KodamaCommands;
+import dev.kodama.command.PermissionedKodamaSubcommand;
+import java.util.Collections;
+import java.util.List;
+import java.util.Locale;
+import net.minecraft.server.MinecraftServer;
+import org.bukkit.command.CommandSender;
+import org.bukkit.permissions.PermissionDefault;
+import org.checkerframework.checker.nullness.qual.NonNull;
+import org.checkerframework.framework.qual.DefaultQualifier;
+
+import static net.kyori.adventure.text.Component.text;
+import static net.kyori.adventure.text.format.NamedTextColor.GRAY;
+import static net.kyori.adventure.text.format.NamedTextColor.GREEN;
+import static net.kyori.adventure.text.format.NamedTextColor.RED;
+import static net.kyori.adventure.text.format.NamedTextColor.WHITE;
+import static net.kyori.adventure.text.format.NamedTextColor.YELLOW;
+
+/**
+ * {@code /kodama precache pause|resume|status}: controls the background chunk pre-generation.
+ */
+@DefaultQualifier(NonNull.class)
+public final class PrecacheCommand extends PermissionedKodamaSubcommand {
+
+    public static final String LITERAL_ARGUMENT = "precache";
+    public static final String PERM = KodamaCommands.COMMAND_BASE_PERM + "." + LITERAL_ARGUMENT;
+
+    private static final List<String> ACTIONS = List.of("pause", "resume", "status");
+
+    public PrecacheCommand() {
+        super(PERM, PermissionDefault.OP);
+    }
+
+    @Override
+    public boolean execute(final CommandSender sender, final String subCommand, final String[] args) {
+        final String action = args.length == 0 ? "status" : args[0].toLowerCase(Locale.ROOT);
+        switch (action) {
+            case "pause" -> {
+                PrecacheManager.setPaused(true);
+                sender.sendMessage(text("Precache paused. It stays paused until /kodama precache resume or a restart.", YELLOW));
+            }
+            case "resume" -> {
+                PrecacheManager.setPaused(false);
+                sender.sendMessage(text("Precache resumed.", GREEN));
+            }
+            case "status" -> this.sendStatus(sender);
+            default -> {
+                sender.sendMessage(text("Usage: /kodama precache [pause | resume | status]", RED));
+                return false;
+            }
+        }
+        return true;
+    }
+
+    private void sendStatus(final CommandSender sender) {
+        final MinecraftServer server = MinecraftServer.getServer();
+        sender.sendMessage(text("Kodama precache", GREEN));
+        sender.sendMessage(text(String.format(Locale.ROOT, "Average tick time (last second): %.1f ms, at most %d chunks generated at the same time%s",
+            PrecacheManager.lastMspt(), PrecacheManager.concurrentLimit(), PrecacheManager.isPaused() ? ", paused by command" : ""), GRAY));
+        final List<String> lines = PrecacheManager.describeWorlds(server);
+        if (lines.isEmpty()) {
+            sender.sendMessage(text("No world is selected (precache.worlds).", GRAY));
+        }
+        for (final String line : lines) {
+            sender.sendMessage(text("  " + line, WHITE));
+        }
+    }
+
+    @Override
+    public List<String> tabComplete(final CommandSender sender, final String subCommand, final String[] args) {
+        return args.length <= 1 ? Completions.matchingLast(args, ACTIONS) : Collections.emptyList();
+    }
+}
