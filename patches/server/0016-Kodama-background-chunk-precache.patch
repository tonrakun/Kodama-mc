From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Tonrakun <tonrakun@gmail.com>
Date: Sun, 18 Oct 2026 16:58:48 +0900
Subject: [PATCH] Kodama: background chunk precache

License: GPL-3.0

Generates chunks that do not exist on disk yet in the background at the
lowest chunk system priority and lets them unload (and be saved) right
away. Work comes from rings around the world spawn, hot cells of a decaying
player heat map and a cone ahead of each moving player, explorers first,
distributed round robin. It stops on high MSPT, while players wait for
chunks, at the configured radius, world border or region folder size, and
persists the finished rings and the heat map in kodama-precache.dat.
Controlled by precache.* and /kodama precache pause|resume|status; failures
disable only this feature through FeatureGuard.

diff --git a/src/main/java/dev/kodama/chunk/precache/Heatmap.java b/src/main/java/dev/kodama/chunk/precache/Heatmap.java
new file mode 100644
index 0000000000000000000000000000000000000000..b1d91c497c15b2cf55986d6bce18cc0bbfc42199
--- /dev/null
+++ b/src/main/java/dev/kodama/chunk/precache/Heatmap.java
@@ -0,0 +1,82 @@
+package dev.kodama.chunk.precache;
+
+import io.papermc.paper.util.CoordinateUtils;
+import it.unimi.dsi.fastutil.longs.Long2ObjectOpenHashMap;
+import java.util.function.Predicate;
+import org.checkerframework.checker.nullness.qual.Nullable;
+
+/**
+ * Where players go: a coarse grid of region sized cells (32x32 chunks) with a decaying heat value. Each cell also keeps
+ * the progress of the pre-generation around its center. Main thread only.
+ */
+final class Heatmap {
+
+    static final int CELL_SHIFT = 5;
+    static final int CELL_CHUNKS = 1 << CELL_SHIFT;
+    /**
+     * Ring around the cell center that covers the whole cell; a cell at this ring is finished.
+     */
+    static final int DONE_RING = CELL_CHUNKS / 2;
+    private static final float MAX_HEAT = 1000.0F;
+    private static final float FORGET_BELOW = 0.1F;
+
+    static final class Cell {
+        final int cellX;
+        final int cellZ;
+        float heat;
+        int ring = -1;
+
+        Cell(final int cellX, final int cellZ) {
+            this.cellX = cellX;
+            this.cellZ = cellZ;
+        }
+
+        int centerChunkX() {
+            return (this.cellX << CELL_SHIFT) + CELL_CHUNKS / 2;
+        }
+
+        int centerChunkZ() {
+            return (this.cellZ << CELL_SHIFT) + CELL_CHUNKS / 2;
+        }
+    }
+
+    private final Long2ObjectOpenHashMap<Cell> cells = new Long2ObjectOpenHashMap<>();
+
+    int size() {
+        return this.cells.size();
+    }
+
+    @Nullable Cell cell(final int cellX, final int cellZ) {
+        return this.cells.get(CoordinateUtils.getChunkKey(cellX, cellZ));
+    }
+
+    Cell cellOrCreate(final int cellX, final int cellZ) {
+        return this.cells.computeIfAbsent(CoordinateUtils.getChunkKey(cellX, cellZ), key -> new Cell(cellX, cellZ));
+    }
+
+    void addHeat(final int chunkX, final int chunkZ, final float amount) {
+        final Cell cell = this.cellOrCreate(chunkX >> CELL_SHIFT, chunkZ >> CELL_SHIFT);
+        cell.heat = Math.min(MAX_HEAT, cell.heat + amount);
+    }
+
+    void decay(final float factor) {
+        this.cells.values().removeIf(cell -> {
+            cell.heat *= factor;
+            return cell.heat < FORGET_BELOW;
+        });
+    }
+
+    @Nullable Cell hottest(final Predicate<Cell> accept) {
+        Cell best = null;
+        for (final Cell cell : this.cells.values()) {
+            if (accept.test(cell) && (best == null || cell.heat > best.heat)) {
+                best = cell;
+            }
+        }
+        return best;
+    }
+
+    Iterable<Cell> cells() {
+        return this.cells.values();
+    }
+}
diff --git a/src/main/java/dev/kodama/chunk/precache/PrecacheManager.java b/src/main/java/dev/kodama/chunk/precache/PrecacheManager.java
new file mode 100644
index 0000000000000000000000000000000000000000..3f238e437539b15b15bec1b222d8adcbabe380d5
--- /dev/null
+++ b/src/main/java/dev/kodama/chunk/precache/PrecacheManager.java
@@ -0,0 +1,219 @@
+package dev.kodama.chunk.precache;
+
+import com.mojang.logging.LogUtils;
+import dev.kodama.feature.FeatureGuard;
+import io.papermc.paper.util.CoordinateUtils;
+import java.util.ArrayList;
+import java.util.List;
+import java.util.Map;
+import java.util.concurrent.ConcurrentHashMap;
+import java.util.concurrent.ExecutorService;
+import java.util.concurrent.Executors;
+import java.util.concurrent.TimeUnit;
+import net.minecraft.server.MinecraftServer;
+import net.minecraft.server.level.ServerLevel;
+import net.minecraft.server.level.ServerPlayer;
+import org.checkerframework.checker.nullness.qual.Nullable;
+import org.slf4j.Logger;
+
+/**
+ * Entry point of the background chunk pre-generation (section {@code precache} of the global config). Called from the
+ * main thread once per tick; the real work is split between {@link WorldPrecache} instances, one per selected world.
+ */
+public final class PrecacheManager {
+
+    private static final Logger LOGGER = LogUtils.getLogger();
+    // the player's own chunk work wins: pre-generation waits while any player has more than this many chunks queued
+    private static final int PLAYER_BUSY_THRESHOLD = 8;
+    private static final int MSPT_WINDOW_TICKS = 20;
+
+    private static final Map<ServerLevel, WorldPrecache> WORLDS = new ConcurrentHashMap<>();
+    private static volatile boolean paused;
+    private static volatile boolean stopped;
+    private static volatile double mspt;
+    private static volatile int concurrentLimit;
+    private static @Nullable ExecutorService io;
+
+    private PrecacheManager() {
+    }
+
+    private static synchronized ExecutorService io() {
+        if (io == null) {
+            io = Executors.newSingleThreadExecutor(runnable -> {
+                final Thread thread = new Thread(runnable, "Kodama Precache IO");
+                thread.setDaemon(true);
+                thread.setPriority(Thread.MIN_PRIORITY);
+                return thread;
+            });
+        }
+        return io;
+    }
+
+    /**
+     * Called at the end of every server tick, on the main thread.
+     */
+    public static void tick(final MinecraftServer server) {
+        if (stopped) {
+            return;
+        }
+        try {
+            doTick(server);
+        } catch (final VirtualMachineError error) {
+            throw error;
+        } catch (final Throwable throwable) {
+            FeatureGuard.reportFailure(PrecacheSettings.FEATURE_ID, throwable);
+        }
+    }
+
+    private static void doTick(final MinecraftServer server) {
+        if (!PrecacheSettings.enabled()) {
+            for (final WorldPrecache world : WORLDS.values()) {
+                world.markDisabled();
+            }
+            return;
+        }
+
+        final List<ServerLevel> levels = new ArrayList<>();
+        for (final ServerLevel level : server.getAllLevels()) {
+            levels.add(level);
+            if (PrecacheSettings.worldSelected(server, level)) {
+                WORLDS.computeIfAbsent(level, key -> new WorldPrecache(server, key, io()));
+            }
+        }
+        WORLDS.entrySet().removeIf(entry -> {
+            final boolean keep = levels.contains(entry.getKey()) && PrecacheSettings.worldSelected(server, entry.getKey());
+            if (!keep) {
+                entry.getValue().saveNow();
+            }
+            return !keep;
+        });
+
+        final int tickCount = server.getTickCount();
+        mspt = averageMspt(server, tickCount);
+
+        final List<ServerPlayer> players = server.getPlayerList().getPlayers();
+        final int limit = players.isEmpty() ? PrecacheSettings.maxConcurrentIdle() : PrecacheSettings.maxConcurrent();
+        concurrentLimit = limit;
+
+        WorldPrecache.State pause = null;
+        if (paused) {
+            pause = WorldPrecache.State.PAUSED_MANUAL;
+        } else if (mspt > PrecacheSettings.maxMspt()) {
+            pause = WorldPrecache.State.PAUSED_MSPT;
+        } else if (playersBusy(players)) {
+            pause = WorldPrecache.State.PAUSED_PLAYERS;
+        }
+
+        int generating = 0;
+        for (final WorldPrecache world : WORLDS.values()) {
+            generating += world.generatingCount();
+        }
+        for (final WorldPrecache world : WORLDS.values()) {
+            // the limit is shared by all worlds
+            world.tick(tickCount, pause, Math.max(0, limit - (generating - world.generatingCount())));
+        }
+    }
+
+    private static boolean playersBusy(final List<ServerPlayer> players) {
+        for (final ServerPlayer player : players) {
+            if (player.chunkLoader != null && player.chunkLoader.kodamaPendingWork() > PLAYER_BUSY_THRESHOLD) {
+                return true;
+            }
+        }
+        return false;
+    }
+
+    /**
+     * Average tick time of the last second in milliseconds. The tick that is running is already recorded when this runs.
+     */
+    private static double averageMspt(final MinecraftServer server, final int tickCount) {
+        final long[] times = server.getTickTimesNanos();
+        final int samples = Math.max(1, Math.min(MSPT_WINDOW_TICKS, tickCount));
+        long total = 0L;
+        for (int i = 0; i < samples; i++) {
+            total += times[Math.floorMod(tickCount - i, times.length)];
+        }
+        return total / (double)samples / 1.0E6;
+    }
+
+    /**
+     * Saves the progress and stops scheduling; called once while the server shuts down.
+     */
+    public static void shutdown() {
+        if (stopped) {
+            return;
+        }
+        stopped = true;
+        final ExecutorService executor;
+        synchronized (PrecacheManager.class) {
+            executor = io;
+            io = null;
+        }
+        if (executor != null) {
+            executor.shutdown();
+            try {
+                if (!executor.awaitTermination(5L, TimeUnit.SECONDS)) {
+                    LOGGER.warn("The precache IO thread did not finish in time");
+                }
+            } catch (final InterruptedException e) {
+                Thread.currentThread().interrupt();
+            }
+        }
+        for (final WorldPrecache world : WORLDS.values()) {
+            world.saveNow();
+        }
+    }
+
+    /**
+     * Whether the ChunkLoadEvent of this chunk is skipped: only for chunks that the pre-generation is loading right now,
+     * and only when {@code precache.fire-chunk-load-event} is false.
+     */
+    public static boolean suppressChunkLoadEvent(final ServerLevel level, final int chunkX, final int chunkZ) {
+        if (WORLDS.isEmpty() || PrecacheSettings.fireChunkLoadEvent()) {
+            return false;
+        }
+        final WorldPrecache world = WORLDS.get(level);
+        return world != null && world.isPrecacheChunk(CoordinateUtils.getChunkKey(chunkX, chunkZ));
+    }
+
+    // commands and status
+
+    public static boolean isPaused() {
+        return paused;
+    }
+
+    public static void setPaused(final boolean value) {
+        paused = value;
+    }
+
+    public static double lastMspt() {
+        return mspt;
+    }
+
+    public static int concurrentLimit() {
+        return concurrentLimit;
+    }
+
+    /**
+     * One line per world that is selected for pre-generation.
+     */
+    public static List<String> describeWorlds(final MinecraftServer server) {
+        final List<String> lines = new ArrayList<>();
+        for (final ServerLevel level : server.getAllLevels()) {
+            if (!PrecacheSettings.worldSelected(server, level)) {
+                continue;
+            }
+            final WorldPrecache world = WORLDS.get(level);
+            final String name = level.getWorld().getName();
+            if (!PrecacheSettings.configuredEnabled() || PrecacheSettings.tripped() || world == null) {
+                lines.add(name + ": disabled" + (PrecacheSettings.tripped() ? " (too many errors)" : ""));
+                continue;
+            }
+            final long disk = world.diskBytes();
+            lines.add(String.format(java.util.Locale.ROOT, "%s: %s, generated %d this session (%d total), %s, %.1f chunks/s, %d in flight%s",
+                name, world.state().text, world.generatedThisSession(), world.generatedTotal(), world.progressText(), world.chunksPerSecond(),
+                world.generatingCount(), disk < 0 ? "" : String.format(java.util.Locale.ROOT, ", region folder %d MB", disk >> 20)));
+        }
+        return lines;
+    }
+}
diff --git a/src/main/java/dev/kodama/chunk/precache/PrecacheProgress.java b/src/main/java/dev/kodama/chunk/precache/PrecacheProgress.java
new file mode 100644
index 0000000000000000000000000000000000000000..7e48689999d09134becbd70de19ff5e8f6bd78ef
--- /dev/null
+++ b/src/main/java/dev/kodama/chunk/precache/PrecacheProgress.java
@@ -0,0 +1,95 @@
+package dev.kodama.chunk.precache;
+
+import java.io.ByteArrayOutputStream;
+import java.io.DataInputStream;
+import java.io.DataOutputStream;
+import java.io.IOException;
+import java.nio.file.AtomicMoveNotSupportedException;
+import java.nio.file.Files;
+import java.nio.file.Path;
+import java.nio.file.StandardCopyOption;
+import org.checkerframework.checker.nullness.qual.Nullable;
+
+/**
+ * The persisted state of one world, {@code kodama-precache.dat} in the world folder: the finished spawn rings, the
+ * total number of generated chunks and the heat map with the finished rings of its cells.
+ */
+final class PrecacheProgress {
+
+    static final String FILE_NAME = "kodama-precache.dat";
+
+    private static final int MAGIC = 0x4B505243; // "KPRC"
+    private static final int VERSION = 1;
+
+    final int spawnChunkX;
+    final int spawnChunkZ;
+    final int spawnCompletedRing;
+    final long totalGenerated;
+    final Heatmap heatmap;
+
+    PrecacheProgress(final int spawnChunkX, final int spawnChunkZ, final int spawnCompletedRing, final long totalGenerated, final Heatmap heatmap) {
+        this.spawnChunkX = spawnChunkX;
+        this.spawnChunkZ = spawnChunkZ;
+        this.spawnCompletedRing = spawnCompletedRing;
+        this.totalGenerated = totalGenerated;
+        this.heatmap = heatmap;
+    }
+
+    byte[] serialize() throws IOException {
+        final ByteArrayOutputStream bytes = new ByteArrayOutputStream(64 + this.heatmap.size() * 13);
+        try (DataOutputStream out = new DataOutputStream(bytes)) {
+            out.writeInt(MAGIC);
+            out.writeInt(VERSION);
+            out.writeInt(this.spawnChunkX);
+            out.writeInt(this.spawnChunkZ);
+            out.writeInt(this.spawnCompletedRing);
+            out.writeLong(this.totalGenerated);
+            out.writeInt(this.heatmap.size());
+            for (final Heatmap.Cell cell : this.heatmap.cells()) {
+                out.writeInt(cell.cellX);
+                out.writeInt(cell.cellZ);
+                out.writeFloat(cell.heat);
+                out.writeByte(cell.ring);
+            }
+        }
+        return bytes.toByteArray();
+    }
+
+    /**
+     * @return the stored progress, or null when there is none or it cannot be read
+     */
+    static @Nullable PrecacheProgress read(final Path file) throws IOException {
+        if (!Files.isRegularFile(file)) {
+            return null;
+        }
+        try (DataInputStream in = new DataInputStream(Files.newInputStream(file))) {
+            if (in.readInt() != MAGIC || in.readInt() != VERSION) {
+                return null;
+            }
+            final int spawnChunkX = in.readInt();
+            final int spawnChunkZ = in.readInt();
+            final int spawnCompletedRing = in.readInt();
+            final long totalGenerated = in.readLong();
+            final int count = in.readInt();
+            final Heatmap heatmap = new Heatmap();
+            for (int i = 0; i < count; i++) {
+                final Heatmap.Cell cell = heatmap.cellOrCreate(in.readInt(), in.readInt());
+                cell.heat = in.readFloat();
+                cell.ring = in.readByte();
+            }
+            return new PrecacheProgress(spawnChunkX, spawnChunkZ, spawnCompletedRing, totalGenerated, heatmap);
+        } catch (final java.io.EOFException truncated) {
+            return null;
+        }
+    }
+
+    static void write(final Path file, final byte[] data) throws IOException {
+        final Path temporary = file.resolveSibling(FILE_NAME + ".tmp");
+        Files.write(temporary, data);
+        try {
+            Files.move(temporary, file, StandardCopyOption.REPLACE_EXISTING, StandardCopyOption.ATOMIC_MOVE);
+        } catch (final AtomicMoveNotSupportedException e) {
+            Files.move(temporary, file, StandardCopyOption.REPLACE_EXISTING);
+        }
+    }
+}
diff --git a/src/main/java/dev/kodama/chunk/precache/PrecacheSettings.java b/src/main/java/dev/kodama/chunk/precache/PrecacheSettings.java
new file mode 100644
index 0000000000000000000000000000000000000000..67431a9df112b02d5249b3b40ad6b11e921173e6
--- /dev/null
+++ b/src/main/java/dev/kodama/chunk/precache/PrecacheSettings.java
@@ -0,0 +1,94 @@
+package dev.kodama.chunk.precache;
+
+import dev.kodama.config.KodamaGlobalConfiguration;
+import dev.kodama.feature.FeatureGuard;
+import java.util.List;
+import net.minecraft.server.MinecraftServer;
+import net.minecraft.server.level.ServerLevel;
+import org.checkerframework.checker.nullness.qual.Nullable;
+
+/**
+ * Read-only view of the {@code precache} section with the {@link FeatureGuard} state already applied. Every call reads
+ * the live configuration.
+ */
+final class PrecacheSettings {
+
+    static final String FEATURE_ID = "precache";
+
+    private static final String MAIN_WORLD_ALIAS = "world";
+
+    private PrecacheSettings() {
+    }
+
+    private static KodamaGlobalConfiguration.@Nullable Precache section() {
+        final KodamaGlobalConfiguration config = KodamaGlobalConfiguration.get();
+        return config == null ? null : config.precache;
+    }
+
+    static boolean configuredEnabled() {
+        final KodamaGlobalConfiguration.Precache section = section();
+        return section != null && section.enabled.isTrue();
+    }
+
+    static boolean tripped() {
+        return FeatureGuard.isTripped(FEATURE_ID);
+    }
+
+    static boolean enabled() {
+        return configuredEnabled() && !tripped();
+    }
+
+    static boolean worldSelected(final MinecraftServer server, final ServerLevel level) {
+        final KodamaGlobalConfiguration.Precache section = section();
+        if (section == null) {
+            return false;
+        }
+        final List<String> worlds = section.worlds;
+        if (worlds == null || worlds.isEmpty()) {
+            return true;
+        }
+        final String name = level.getWorld().getName();
+        final boolean mainOverworld = level == server.overworld();
+        for (final String entry : worlds) {
+            if (entry.equalsIgnoreCase(name) || (mainOverworld && entry.equalsIgnoreCase(MAIN_WORLD_ALIAS))) {
+                return true;
+            }
+        }
+        return false;
+    }
+
+    static double maxMspt() {
+        final KodamaGlobalConfiguration.Precache section = section();
+        return section == null ? 35.0 : section.maxMspt;
+    }
+
+    static int maxConcurrent() {
+        final KodamaGlobalConfiguration.Precache section = section();
+        return section == null ? 8 : Math.max(1, section.maxConcurrent);
+    }
+
+    static int maxConcurrentIdle() {
+        final KodamaGlobalConfiguration.Precache section = section();
+        return section == null ? 32 : Math.max(1, section.maxConcurrentIdle);
+    }
+
+    static int maxRadiusBlocks() {
+        final KodamaGlobalConfiguration.Precache section = section();
+        return section == null ? 5000 : Math.max(16, section.maxRadius);
+    }
+
+    static long maxDiskBytes() {
+        final KodamaGlobalConfiguration.Precache section = section();
+        return (section == null ? 4096L : Math.max(1L, section.maxDiskMb)) * 1024L * 1024L;
+    }
+
+    static double explorerNewChunksPerMinute() {
+        final KodamaGlobalConfiguration.Precache section = section();
+        return section == null ? 30.0 : section.explorerNewChunksPerMinute;
+    }
+
+    static boolean fireChunkLoadEvent() {
+        final KodamaGlobalConfiguration.Precache section = section();
+        return section == null || section.fireChunkLoadEvent;
+    }
+}
diff --git a/src/main/java/dev/kodama/chunk/precache/PrecacheStatus.java b/src/main/java/dev/kodama/chunk/precache/PrecacheStatus.java
new file mode 100644
index 0000000000000000000000000000000000000000..09717088ecb0f99bab34665bfe79f408a16c2900
--- /dev/null
+++ b/src/main/java/dev/kodama/chunk/precache/PrecacheStatus.java
@@ -0,0 +1,42 @@
+package dev.kodama.chunk.precache;
+
+import dev.kodama.command.StatusContributor;
+import dev.kodama.command.subcommands.StatusCommand;
+import java.util.List;
+import net.kyori.adventure.text.Component;
+import net.kyori.adventure.text.TextComponent;
+import net.minecraft.server.MinecraftServer;
+
+import static net.kyori.adventure.text.Component.text;
+import static net.kyori.adventure.text.format.NamedTextColor.GRAY;
+
+/**
+ * The {@code /kodama status} line of the pre-generation.
+ */
+public final class PrecacheStatus {
+
+    private PrecacheStatus() {
+    }
+
+    public static void register() {
+        StatusCommand.register(new StatusContributor() {
+            @Override
+            public String label() {
+                return "Precache progress";
+            }
+
+            @Override
+            public Component describe() {
+                final List<String> lines = PrecacheManager.describeWorlds(MinecraftServer.getServer());
+                if (lines.isEmpty()) {
+                    return text("no world selected", GRAY);
+                }
+                TextComponent result = text("");
+                for (final String line : lines) {
+                    result = result.append(text("\n  " + line, GRAY));
+                }
+                return result;
+            }
+        });
+    }
+}
diff --git a/src/main/java/dev/kodama/chunk/precache/RingSource.java b/src/main/java/dev/kodama/chunk/precache/RingSource.java
new file mode 100644
index 0000000000000000000000000000000000000000..da955af1ad39bd8b495ac474ebfc75c717c47825
--- /dev/null
+++ b/src/main/java/dev/kodama/chunk/precache/RingSource.java
@@ -0,0 +1,144 @@
+package dev.kodama.chunk.precache;
+
+import io.papermc.paper.util.CoordinateUtils;
+import java.util.concurrent.atomic.AtomicInteger;
+import java.util.function.IntSupplier;
+
+/**
+ * Hands out the chunks of square rings (Chebyshev distance) around a center, nearest ring first. A ring only counts as
+ * completed when every chunk handed out from it was checked and, if it was missing, generated; the next ring starts
+ * after that, so {@link #completedRing()} is always safe to persist. Main thread only, except for {@link #outstanding}.
+ */
+class RingSource {
+
+    interface Filter {
+        boolean accepts(int chunkX, int chunkZ, int dx, int dz);
+    }
+
+    /**
+     * Chunks of this source that were handed out and are not checked or generated yet; written by several threads.
+     */
+    final AtomicInteger outstanding = new AtomicInteger();
+
+    private final int centerX;
+    private final int centerZ;
+    private final IntSupplier limitRing;
+    private final Filter filter;
+    private int ring;
+    private int index;
+    private int completedRing;
+
+    RingSource(final int centerX, final int centerZ, final int completedRing, final IntSupplier limitRing, final Filter filter) {
+        this.centerX = centerX;
+        this.centerZ = centerZ;
+        this.completedRing = completedRing;
+        this.ring = completedRing + 1;
+        this.limitRing = limitRing;
+        this.filter = filter;
+    }
+
+    final int centerX() {
+        return this.centerX;
+    }
+
+    final int centerZ() {
+        return this.centerZ;
+    }
+
+    /**
+     * The ring that is being worked on.
+     */
+    final int ring() {
+        return this.ring;
+    }
+
+    final int completedRing() {
+        return this.completedRing;
+    }
+
+    final int limit() {
+        return this.limitRing.getAsInt();
+    }
+
+    boolean exhausted() {
+        return this.ring > this.limitRing.getAsInt();
+    }
+
+    /**
+     * Writes up to {@code max} chunk keys that still have to be checked into {@code out} and counts them as outstanding.
+     */
+    int pull(final long[] out, final int max) {
+        final int limit = this.limitRing.getAsInt();
+        int count = 0;
+        while (count < max && this.ring <= limit) {
+            final int size = ringSize(this.ring);
+            if (this.index >= size) {
+                break; // wait until the whole ring is done
+            }
+            final int position = this.index++;
+            final int dx = offsetX(this.ring, position);
+            final int dz = offsetZ(this.ring, position);
+            final int chunkX = this.centerX + dx;
+            final int chunkZ = this.centerZ + dz;
+            if (!this.filter.accepts(chunkX, chunkZ, dx, dz)) {
+                continue;
+            }
+            out[count++] = CoordinateUtils.getChunkKey(chunkX, chunkZ);
+            this.outstanding.incrementAndGet();
+        }
+        return count;
+    }
+
+    /**
+     * Moves on to the next ring when the current one is fully handed out and finished.
+     *
+     * @return whether a ring was completed
+     */
+    boolean advance() {
+        if (this.ring > this.limitRing.getAsInt() || this.index < ringSize(this.ring) || this.outstanding.get() != 0) {
+            return false;
+        }
+        this.completedRing = this.ring;
+        this.onRingCompleted(this.ring);
+        this.ring++;
+        this.index = 0;
+        return true;
+    }
+
+    void onRingCompleted(final int completed) {
+    }
+
+    static int ringSize(final int ring) {
+        return ring == 0 ? 1 : ring * 8;
+    }
+
+    private static int offsetX(final int ring, final int position) {
+        if (ring == 0) {
+            return 0;
+        }
+        final int side = ring * 2;
+        final int segment = position / side;
+        final int offset = position % side;
+        return switch (segment) {
+            case 0 -> -ring + offset;
+            case 1 -> ring;
+            case 2 -> ring - offset;
+            default -> -ring;
+        };
+    }
+
+    private static int offsetZ(final int ring, final int position) {
+        if (ring == 0) {
+            return 0;
+        }
+        final int side = ring * 2;
+        final int segment = position / side;
+        final int offset = position % side;
+        return switch (segment) {
+            case 0 -> -ring;
+            case 1 -> -ring + offset;
+            case 2 -> ring;
+            default -> ring - offset;
+        };
+    }
+}
