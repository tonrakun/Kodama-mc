+
+/**
+ * The pre-generation of one world. {@link #tick} runs on the main thread and only does bookkeeping: it picks chunks from
+ * the sources (spawn rings, hot cells of the heat map, a cone ahead of each moving player), lets the IO thread find out
+ * which of them are missing on disk, and starts the generation of the missing ones at the lowest priority through the
+ * chunk system. The chunk gets a short-lived ticket and unloads, saved by the normal path, once it is generated.
+ */
+final class WorldPrecache {
+
+    enum State {
+        LOADING("loading"),
+        RUNNING("running"),
+        PAUSED_MSPT("paused: mspt"),
+        PAUSED_PLAYERS("paused: players busy"),
+        PAUSED_MANUAL("paused: manual"),
+        DONE("done"),
+        DONE_DISK("done (disk limit)"),
+        DISABLED("disabled");
+
+        final String text;
+
+        State(final String text) {
+            this.text = text;
+        }
+    }
+
+    private record Job(long chunk, RingSource source) {
+    }
+
+    private enum DiskState {
+        MISSING, PARTIAL, FULL, UNKNOWN
+    }
+
+    private static final Logger LOGGER = LogUtils.getLogger();
+
+    private static final long NEVER = -1_000_000_000L; // far enough in the past, and subtracting it cannot overflow
+    private static final int SAMPLE_INTERVAL_TICKS = 100;
+    private static final int MINUTE_TICKS = 1200;
+    private static final int LIMIT_INTERVAL_TICKS = 20;
+    private static final int MAX_STARTS_PER_TICK = 4;
+    private static final int PULL_BATCH = 8;
+    private static final int RATE_SAMPLES = 11;
+    private static final int CONE_DEPTH_CHUNKS = 48;
+    private static final double CONE_HALF_ANGLE_COS = Math.cos(Math.toRadians(35.0));
+    private static final double CONE_RESET_ANGLE_COS = Math.cos(Math.toRadians(30.0));
+    private static final int CONE_RESET_DISTANCE_CHUNKS = 6;
+    private static final int TELEPORT_DISTANCE_CHUNKS = 40;
+    private static final double CONSISTENT_HEADING = 0.5;
+    private static final float HOT_MIN_HEAT = 3.0F;
+    private static final float HEAT_DECAY_PER_MINUTE = 0.95F;
+    private static final int AHEAD_CHUNKS = 64; // two cells
+
+    private final ServerLevel level;
+    private final Executor io;
+    private final Path datFile;
+    private final Path regionFolder;
+    private final int spawnChunkX;
+    private final int spawnChunkZ;
+
+    private volatile boolean loaded;
+    private Heatmap heatmap = new Heatmap();
+    private long totalBase;
+    private volatile @Nullable RingSource spawn;
+    private volatile @Nullable RingSource hot;
+    private volatile Heatmap.@Nullable Cell hotCell;
+    private final Map<UUID, PlayerTrack> tracks = new HashMap<>();
+    private final List<RingSource> rotation = new ArrayList<>();
+    private int rotationPosition;
+
+    private final ConcurrentLinkedQueue<Job> toGenerate = new ConcurrentLinkedQueue<>();
+    private final AtomicInteger checking = new AtomicInteger();
+    private final AtomicInteger generating = new AtomicInteger();
+    private final AtomicLong generated = new AtomicLong();
+    // chunks started by this feature that are not finished yet; read by the ChunkLoadEvent guard
+    private final LongSet precacheChunks = LongSets.synchronize(new LongOpenHashSet());
+
+    private volatile long diskBytes = -1L;
+    private volatile State state = State.LOADING;
+    private volatile int maxChunks = 1;
+    private volatile int ringLimit = 1;
+    private long lastLimitTick = NEVER;
+    private long lastSampleTick = NEVER;
+    private long lastRotationTick = NEVER;
+    private long lastMinuteTick = Long.MIN_VALUE;
+    private long lastRateTick = NEVER;
+    private final long[] rateSamples = new long[RATE_SAMPLES];
+    private int rateCount;
+    private volatile double chunksPerSecond;
+
+    WorldPrecache(final MinecraftServer server, final ServerLevel level, final Executor io) {
+        this.level = level;
+        this.io = io;
+        this.datFile = level.getWorld().getWorldFolder().toPath().resolve(PrecacheProgress.FILE_NAME);
+        this.regionFolder = level.convertable.getDimensionPath(level.dimension()).resolve("region");
+        final BlockPos spawnPos = level.getSharedSpawnPos();
+        this.spawnChunkX = spawnPos.getX() >> 4;
+        this.spawnChunkZ = spawnPos.getZ() >> 4;
+        io.execute(this::loadProgress);
+    }
+
+    // state for the status output
+
+    String worldName() {
+        return this.level.getWorld().getName();
+    }
+
+    State state() {
+        return this.state;
+    }
+
+    void markDisabled() {
+        this.state = State.DISABLED;
+    }
+
+    long generatedThisSession() {
+        return this.generated.get();
+    }
+
+    long generatedTotal() {
+        return this.totalBase + this.generated.get();
+    }
+
+    int generatingCount() {
+        return this.generating.get();
+    }
+
+    double chunksPerSecond() {
+        return this.chunksPerSecond;
+    }
+
+    long diskBytes() {
+        return this.diskBytes;
+    }
+
+    boolean isPrecacheChunk(final long chunk) {
+        return this.precacheChunks.contains(chunk);
+    }
+
+    String progressText() {
+        final RingSource spawn = this.spawn;
+        if (!this.loaded || spawn == null) {
+            return "loading";
+        }
+        final StringBuilder text = new StringBuilder();
+        text.append("spawn ring ").append(Math.min(spawn.ring(), spawn.limit())).append('/').append(spawn.limit());
+        final RingSource hot = this.hot;
+        final Heatmap.Cell hotCell = this.hotCell;
+        if (hot != null && hotCell != null) {
+            text.append(", hot cell ").append(hotCell.cellX).append(',').append(hotCell.cellZ).append(" ring ")
+                .append(Math.min(hot.ring(), Heatmap.DONE_RING)).append('/').append(Heatmap.DONE_RING);
+        }
+        return text.toString();
+    }
+
+    // main thread tick
+
+    /**
+     * @param pause         the reason why nothing may be scheduled right now, or null
+     * @param inFlightLimit the number of chunks this world may have in generation at the same time
+     */
+    void tick(final long tick, final @Nullable State pause, final int inFlightLimit) {
+        if (!this.loaded) {
+            this.state = State.LOADING;
+            return;
+        }
+        if (tick - this.lastLimitTick >= LIMIT_INTERVAL_TICKS) {
+            this.lastLimitTick = tick;
+            this.recomputeLimits();
+        }
+        this.housekeeping(tick);
+        if (pause != null) {
+            this.state = pause;
+            return;
+        }
+        if (this.diskBytes > PrecacheSettings.maxDiskBytes()) {
+            this.state = State.DONE_DISK;
+            return;
+        }
+
+        this.startGenerations(inFlightLimit);
+        final int pulled = this.refill(tick, inFlightLimit);
+        this.advanceSources();
+
+        final boolean busy = pulled > 0 || this.checking.get() > 0 || !this.toGenerate.isEmpty() || this.generating.get() > 0;
+        this.state = busy || this.hasActiveSource() ? State.RUNNING : State.DONE;
+    }
+
+    private void housekeeping(final long tick) {
+        if (this.lastMinuteTick == Long.MIN_VALUE) {
+            this.lastMinuteTick = tick;
+            this.submitDiskCheck();
+        }
+        if (tick - this.lastSampleTick >= SAMPLE_INTERVAL_TICKS) {
+            this.lastSampleTick = tick;
+            this.samplePlayers();
+            this.selectHotCell();
+        }
+        if (tick - this.lastRateTick >= 20) {
+            this.lastRateTick = tick;
+            this.sampleRate();
+        }
+        if (tick - this.lastMinuteTick >= MINUTE_TICKS) {
+            this.lastMinuteTick = tick;
+            this.heatmap.decay(HEAT_DECAY_PER_MINUTE);
+            this.saveAsync();
+            this.submitDiskCheck();
+        }
+    }
+
+    private void sampleRate() {
+        if (this.rateCount == RATE_SAMPLES) {
+            System.arraycopy(this.rateSamples, 1, this.rateSamples, 0, RATE_SAMPLES - 1);
+            this.rateCount--;
+        }
+        this.rateSamples[this.rateCount++] = this.generated.get();
+        this.chunksPerSecond = this.rateCount < 2 ? 0.0 : (double)(this.rateSamples[this.rateCount - 1] - this.rateSamples[0]) / (this.rateCount - 1);
+    }
+
+    // limits
+
+    private void recomputeLimits() {
+        this.maxChunks = Math.max(1, (PrecacheSettings.maxRadiusBlocks() + 15) >> 4);
+        final WorldBorder border = this.level.getWorldBorder();
+        final int minX = clampChunk(Math.floor(border.getMinX())) - this.spawnChunkX;
+        final int maxX = clampChunk(Math.ceil(border.getMaxX())) - this.spawnChunkX;
+        final int minZ = clampChunk(Math.floor(border.getMinZ())) - this.spawnChunkZ;
+        final int maxZ = clampChunk(Math.ceil(border.getMaxZ())) - this.spawnChunkZ;
+        final int borderLimit = Math.max(Math.max(Math.abs(minX), Math.abs(maxX)), Math.max(Math.abs(minZ), Math.abs(maxZ)));
+        this.ringLimit = Math.min(this.maxChunks, borderLimit);
+    }
+
+    private static int clampChunk(final double block) {
+        return ((int)Math.max(-3.0E7, Math.min(3.0E7, block))) >> 4;
+    }
+
+    private boolean inBounds(final int chunkX, final int chunkZ) {
+        if (Math.abs(chunkX - this.spawnChunkX) > this.maxChunks || Math.abs(chunkZ - this.spawnChunkZ) > this.maxChunks) {
+            return false;
+        }
+        return this.level.getWorldBorder().isChunkInBounds(chunkX, chunkZ);
+    }
+
+    // sources
+
+    private boolean hasActiveSource() {
+        final RingSource spawn = this.spawn;
+        if (spawn != null && !spawn.exhausted()) {
+            return true;
+        }
+        final RingSource hot = this.hot;
+        if (hot != null && !hot.exhausted()) {
+            return true;
+        }
+        for (final PlayerTrack track : this.tracks.values()) {
+            if (track.cone != null && !track.cone.exhausted()) {
+                return true;
+            }
+        }
+        return false;
+    }
+
+    private void advanceSources() {
+        final RingSource spawn = this.spawn;
+        if (spawn != null) {
+            spawn.advance();
+        }
+        final RingSource hot = this.hot;
+        if (hot != null) {
+            hot.advance();
+        }
+        for (final PlayerTrack track : this.tracks.values()) {
+            if (track.cone != null) {
+                track.cone.advance();
+            }
+        }
+    }
+
+    private void rebuildRotation() {
+        this.rotation.clear();
+        for (final PlayerTrack track : this.tracks.values()) {
+            if (track.cone != null && !track.cone.exhausted()) {
+                this.rotation.add(track.cone);
+                if (track.explorer) {
+                    this.rotation.add(track.cone); // explorers get twice the share
+                }
+            }
+        }
+        final RingSource spawn = this.spawn;
+        if (spawn != null && !spawn.exhausted()) {
+            this.rotation.add(spawn);
+        }
+        final RingSource hot = this.hot;
+        if (hot != null && !hot.exhausted()) {
+            this.rotation.add(hot);
+        }
+    }
+
+    private void selectHotCell() {
+        final Heatmap.Cell best = this.heatmap.hottest(this::isHotCandidate);
+        final Heatmap.Cell current = this.hotCell;
+        final RingSource currentSource = this.hot;
+        if (currentSource != null && !currentSource.exhausted() && current != null && (best == null || current.heat * 4.0F >= best.heat)) {
+            return;
+        }
+        if (best == null) {
+            this.hot = null;
+            this.hotCell = null;
+            return;
+        }
+        this.hotCell = best;
+        this.hot = new RingSource(best.centerChunkX(), best.centerChunkZ(), best.ring, () -> Heatmap.DONE_RING, (x, z, dx, dz) -> this.inBounds(x, z)) {
+            @Override
+            void onRingCompleted(final int completed) {
+                best.ring = completed;
+            }
+        };
+    }
+
+    private boolean isHotCandidate(final Heatmap.Cell cell) {
+        return cell.heat >= HOT_MIN_HEAT && cell.ring < Heatmap.DONE_RING
+            && Math.abs(cell.centerChunkX() - this.spawnChunkX) <= this.maxChunks + Heatmap.DONE_RING
+            && Math.abs(cell.centerChunkZ() - this.spawnChunkZ) <= this.maxChunks + Heatmap.DONE_RING;
+    }
+
+    // players
+
+    private final class PlayerTrack {
+        boolean hasLast;
+        int lastChunkX;
+        int lastChunkZ;
+        double headingX;
+        double headingZ;
+        double chunksPerMinute;
+        boolean explorer;
+        @Nullable RingSource cone;
+        int coneX;
+        int coneZ;
+        double coneHeadingX;
+        double coneHeadingZ;
+
+        void update(final ServerPlayer player) {
+            final ChunkPos position = player.chunkPosition();
+            if (this.hasLast) {
+                final int dx = position.x - this.lastChunkX;
+                final int dz = position.z - this.lastChunkZ;
+                final double distance = Math.sqrt((double)dx * dx + (double)dz * dz);
+                if (distance <= TELEPORT_DISTANCE_CHUNKS) {
+                    final double stepX = distance == 0.0 ? 0.0 : dx / distance;
+                    final double stepZ = distance == 0.0 ? 0.0 : dz / distance;
+                    this.headingX = this.headingX * 0.7 + stepX * 0.3;
+                    this.headingZ = this.headingZ * 0.7 + stepZ * 0.3;
+                    this.chunksPerMinute = this.chunksPerMinute * 0.7 + distance * (MINUTE_TICKS / (double)SAMPLE_INTERVAL_TICKS) * 0.3;
+                }
+            }
+            this.hasLast = true;
+            this.lastChunkX = position.x;
+            this.lastChunkZ = position.z;
+
+            double newChunksPerMinute = this.chunksPerMinute;
+            if (player.chunkLoader != null && ChunkLoadingSettings.masterEnabled()) {
+                final PlayerMotion motion = player.chunkLoader.kodamaMotion();
+                newChunksPerMinute = motion.newChunksPerMinute();
+            }
+            this.explorer = newChunksPerMinute >= PrecacheSettings.explorerNewChunksPerMinute();
+
+            final double magnitude = Math.sqrt(this.headingX * this.headingX + this.headingZ * this.headingZ);
+            final boolean consistent = magnitude >= CONSISTENT_HEADING;
+            final double unitX = consistent ? this.headingX / magnitude : 0.0;
+            final double unitZ = consistent ? this.headingZ / magnitude : 0.0;
+
+            WorldPrecache.this.heatmap.addHeat(position.x, position.z, 1.0F);
+            if (consistent && this.explorer) {
+                WorldPrecache.this.heatmap.addHeat(position.x + (int)Math.round(unitX * AHEAD_CHUNKS), position.z + (int)Math.round(unitZ * AHEAD_CHUNKS), 0.5F);
+            }
+
+            if (consistent && this.chunksPerMinute >= 1.0) {
+                final int fromOrigin = Math.max(Math.abs(position.x - this.coneX), Math.abs(position.z - this.coneZ));
+                if (this.cone == null || fromOrigin > CONE_RESET_DISTANCE_CHUNKS
+                    || unitX * this.coneHeadingX + unitZ * this.coneHeadingZ < CONE_RESET_ANGLE_COS) {
+                    this.startCone(position.x, position.z, unitX, unitZ);
+                }
+            }
+        }
+
+        private void startCone(final int chunkX, final int chunkZ, final double unitX, final double unitZ) {
+            this.coneX = chunkX;
+            this.coneZ = chunkZ;
+            this.coneHeadingX = unitX;
+            this.coneHeadingZ = unitZ;
+            final int start = Math.max(2, WorldPrecache.this.level.getWorld().getViewDistance() + 1);
+            final int end = start + CONE_DEPTH_CHUNKS;
+            this.cone = new RingSource(chunkX, chunkZ, start - 1, () -> end, (x, z, dx, dz) ->
+                dx * unitX + dz * unitZ >= CONE_HALF_ANGLE_COS * Math.sqrt((double)dx * dx + (double)dz * dz) && WorldPrecache.this.inBounds(x, z));
+        }
+    }
+
+    private void samplePlayers() {
+        final Set<UUID> present = new HashSet<>();
+        for (final ServerPlayer player : this.level.players()) {
+            present.add(player.getUUID());
+            this.tracks.computeIfAbsent(player.getUUID(), id -> new PlayerTrack()).update(player);
+        }
+        this.tracks.keySet().retainAll(present);
+    }
+
+    // pipeline
+
+    private int refill(final long tick, final int inFlightLimit) {
+        if (tick - this.lastRotationTick >= LIMIT_INTERVAL_TICKS) {
+            this.lastRotationTick = tick;
+            this.rebuildRotation();
+        }
+        final int want = Math.min(PULL_BATCH * 4, inFlightLimit * 2 - this.checking.get() - this.toGenerate.size());
+        if (want <= 0 || this.rotation.isEmpty()) {
+            return 0;
+        }
+        final long[] buffer = new long[PULL_BATCH];
+        int total = 0;
+        int idle = 0;
+        while (total < want && idle < this.rotation.size()) {
+            final RingSource source = this.rotation.get(Math.floorMod(this.rotationPosition++, this.rotation.size()));
+            final int count = source.pull(buffer, Math.min(PULL_BATCH, want - total));
+            if (count == 0) {
+                idle++;
+                continue;
+            }
+            idle = 0;
+            total += count;
+            this.submitCheck(source, Arrays.copyOf(buffer, count));
+        }
+        return total;
+    }
+
+    private void submitCheck(final RingSource source, final long[] chunks) {
+        this.checking.addAndGet(chunks.length);
+        try {
+            this.io.execute(() -> this.checkOnIoThread(source, chunks));
+        } catch (final RejectedExecutionException e) {
+            this.checking.addAndGet(-chunks.length);
+            source.outstanding.addAndGet(-chunks.length);
+        }
+    }
+
+    private void checkOnIoThread(final RingSource source, final long[] chunks) {
+        for (final long chunk : chunks) {
+            try {
+                if (this.isGenerated(CoordinateUtils.getChunkX(chunk), CoordinateUtils.getChunkZ(chunk))) {
+                    source.outstanding.decrementAndGet();
+                } else {
+                    this.toGenerate.add(new Job(chunk, source));
+                }
+            } catch (final Throwable throwable) {
+                source.outstanding.decrementAndGet(); // when in doubt, leave the chunk alone
+                FeatureGuard.reportFailure(PrecacheSettings.FEATURE_ID, throwable);
+            } finally {
+                this.checking.decrementAndGet();
+            }
+        }
+    }
+
+    /**
+     * Whether the chunk is already fully generated, in memory, about to be written or in its region file. Chunks that
+     * only exist as an unfinished neighbor of another chunk do not count: they still have to be completed. The status
+     * is cached per region file by the chunk system, otherwise the chunk is read once. May touch the disk, so it must
+     * not run on the main thread.
+     */
+    private boolean isGenerated(final int chunkX, final int chunkZ) throws IOException {
+        final NewChunkHolder holder = this.level.chunkTaskScheduler.chunkHolderManager.getChunkHolder(chunkX, chunkZ);
+        if (holder != null && holder.getCurrentGenStatus() == ChunkStatus.FULL) {
+            return true;
+        }
+        final CompoundTag pending = RegionFileIOThread.getPendingWrite(this.level, chunkX, chunkZ, RegionFileIOThread.RegionFileType.CHUNK_DATA);
+        if (pending != null) {
+            return ChunkSerializer.getStatus(pending) == ChunkStatus.FULL;
+        }
+        final ChunkPos position = new ChunkPos(chunkX, chunkZ);
+        final DiskState disk = this.level.chunkDataControllerNew.computeForRegionFile(chunkX, chunkZ, true, regionFile -> {
+            if (regionFile == null || !regionFile.hasChunk(position)) {
+                return DiskState.MISSING;
+            }
+            final ChunkStatus cached = regionFile.getStatusIfCached(chunkX, chunkZ);
+            return cached == null ? DiskState.UNKNOWN : cached == ChunkStatus.FULL ? DiskState.FULL : DiskState.PARTIAL;
+        });
+        if (disk == DiskState.UNKNOWN) {
+            // not read in this session yet; the region file lock must not be held while the IO thread works for us
+            final CompoundTag tag = RegionFileIOThread.loadData(this.level, chunkX, chunkZ, RegionFileIOThread.RegionFileType.CHUNK_DATA, PrioritisedExecutor.Priority.LOW);
+            return tag != null && ChunkSerializer.getStatus(tag) == ChunkStatus.FULL;
+        }
+        return disk == DiskState.FULL;
+    }
+
+    private void startGenerations(final int inFlightLimit) {
+        int started = 0;
+        while (started < MAX_STARTS_PER_TICK && this.generating.get() < inFlightLimit) {
+            final Job job = this.toGenerate.poll();
+            if (job == null) {
+                return;
+            }
+            started++;
+            this.startGeneration(job);
+        }
+    }
+
+    private void startGeneration(final Job job) {
+        final long chunk = job.chunk();
+        final int chunkX = CoordinateUtils.getChunkX(chunk);
+        final int chunkZ = CoordinateUtils.getChunkZ(chunk);
+        if (this.level.chunkSource.getChunkAtIfLoadedMainThreadNoCache(chunkX, chunkZ) != null) {
+            job.source().outstanding.decrementAndGet(); // a player got there first
+            return;
+        }
+        this.generating.incrementAndGet();
+        this.precacheChunks.add(chunk);
+        try {
+            this.level.chunkTaskScheduler.scheduleChunkLoad(chunkX, chunkZ, ChunkStatus.FULL, true, PrioritisedExecutor.Priority.IDLE, loaded -> {
+                this.precacheChunks.remove(chunk);
+                if (loaded != null) {
+                    this.generated.incrementAndGet();
+                }
+                this.generating.decrementAndGet();
+                job.source().outstanding.decrementAndGet();
+            });
+        } catch (final Throwable throwable) {
+            this.precacheChunks.remove(chunk);
+            this.generating.decrementAndGet();
+            job.source().outstanding.decrementAndGet();
+            throw throwable;
+        }
+    }
+
+    // persistence
+
+    private void loadProgress() {
+        int completedRing = -1;
+        try {
+            final PrecacheProgress progress = PrecacheProgress.read(this.datFile);
+            if (progress != null) {
+                this.heatmap = progress.heatmap;
+                this.totalBase = progress.totalGenerated;
+                if (progress.spawnChunkX == this.spawnChunkX && progress.spawnChunkZ == this.spawnChunkZ) {
+                    completedRing = progress.spawnCompletedRing;
+                }
+            }
+        } catch (final IOException | RuntimeException e) {
+            LOGGER.warn("Could not read the precache progress of world '{}', starting over: {}", this.worldName(), e.toString());
+        }
+        this.spawn = new RingSource(this.spawnChunkX, this.spawnChunkZ, completedRing, () -> this.ringLimit, (x, z, dx, dz) -> this.inBounds(x, z));
+        this.loaded = true;
+        LOGGER.info("Precache of world '{}' resumes after spawn ring {} ({} chunks generated so far)", this.worldName(), completedRing, this.totalBase);
+    }
+
+    private byte[] snapshot() throws IOException {
+        final RingSource spawn = this.spawn;
+        return new PrecacheProgress(this.spawnChunkX, this.spawnChunkZ, spawn == null ? -1 : spawn.completedRing(), this.generatedTotal(), this.heatmap).serialize();
+    }
+
+    private void saveAsync() {
+        try {
+            final byte[] data = this.snapshot();
+            this.io.execute(() -> this.write(data));
+        } catch (final IOException | RejectedExecutionException e) {
+            LOGGER.warn("Could not save the precache progress of world '{}': {}", this.worldName(), e.toString());
+        }
+    }
+
+    /**
+     * Writes the progress on the calling thread; used at shutdown, after the IO executor has finished its tasks.
+     */
+    void saveNow() {
+        if (!this.loaded) {
+            return;
+        }
+        try {
+            this.write(this.snapshot());
+        } catch (final IOException e) {
+            LOGGER.warn("Could not save the precache progress of world '{}': {}", this.worldName(), e.toString());
+        }
+    }
+
+    private void write(final byte[] data) {
+        try {
+            PrecacheProgress.write(this.datFile, data);
+        } catch (final IOException e) {
+            LOGGER.warn("Could not write {}: {}", this.datFile, e.toString());
+        }
+    }
+
+    private void submitDiskCheck() {
+        try {
+            this.io.execute(() -> this.diskBytes = folderSize(this.regionFolder));
+        } catch (final RejectedExecutionException ignored) {
+            // shutting down
+        }
+    }
+
+    private static long folderSize(final Path folder) {
+        long total = 0L;
+        if (!Files.isDirectory(folder)) {
+            return 0L;
+        }
+        try (DirectoryStream<Path> files = Files.newDirectoryStream(folder)) {
+            for (final Path file : files) {
+                try {
+                    total += Files.size(file);
+                } catch (final IOException ignored) {
+                    // the file was removed meanwhile
+                }
+            }
+        } catch (final IOException e) {
+            return 0L;
+        }
+        return total;
+    }
+}
